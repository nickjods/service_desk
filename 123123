-- DROP FUNCTION actuary.get_af_pds_fl(text, date, date);

CREATE OR REPLACE FUNCTION actuary.get_af_pds_fl(p_name_in_pfr text, p_start_date date, p_end_date date)
 RETURNS TABLE(code integer, code_sharer integer, code_contract integer, selfnumber_sharer text, selfnumber_contract text, sign_date date, effective_date date, inpaymentfirst_date date, name_investor text, investor_sharer integer, status_sharer text, type_group text, sex text, birth_date date, age smallint, fund text, scheme_contract text, scheme_name text, portfolioinvest text, account_type text, registr_date date, class_sharer integer, contract_type integer, oud numeric, segment bigint, value_income numeric, period_income text, assignee_type text, valueinpaymentcontract numeric, get_actuary_rate integer, balance_end numeric, balance_by_pension numeric, balance_end_ips numeric, balance_transfer numeric, incomevaluetotal numeric, inpayment_value numeric, othertransfer_value numeric, value_pay numeric, "CONDITION" text, respons text, start_date_pension date, period_pension text, pension_value numeric, indexation bigint, pension_next_pay_date date, suspend_pay_date date, period_pay_pension text, pension_count integer, end_date_pay_pension date, end_date_pension_period date, "TYPE" integer, fixed_value bigint, actuary_rate numeric, valuereturn numeric, transactioninpaymentvalue1 numeric, transactioninpaymentvalue2 numeric, transactioninpaymentvalue3 numeric, sharer_type text, valueinpaymentfirst numeric, balancebypensionstart numeric, obligationtypes text, inpayment_ev_value numeric, inpayment_add_value numeric, inpayment_sb_value numeric, date_investment_horizont date, period_investment_horizont integer, value_investment_horizont numeric, datecalcredemption date, check_appl_ev integer, balance_end_ops numeric, countpaypension integer, income_last_value numeric)
 LANGUAGE plpgsql
AS $function$
	declare
		v_datetime_end timestamp;
	begin
		
		if p_start_date is null or p_end_date is null then 
			raise exception 'Inputs dates is NULL';
		end if;
	
	v_datetime_end = p_end_date::timestamp + interval '23 hours 59 minutes';
		
	drop table if exists t_sharer_base_pds_af;
	create temp table t_sharer_base_pds_af on commit drop as
			select
				s.id as sharer_id,
				c.effective_date as contract_effective_date,
				coalesce(
		        	coalesce(i.counterparty_code_1c, i1.counterparty_code_1c), 
		        	coalesce(i.code_1c, i1.code_1c)
		        ) as code,
				c.code_1c as contract_code_1c,
				s.code_1c as sharer_code_1c,
				s.number as sharer_number,
				c.number as contract_number,
				csh_sign.status_date as sign_date,
				ssh_eff.status_date as effective_date,
				case
		            when c.entity_id is null then 'фл'
		            else e.name
		        end as name_investor,
		        case
		            when c.client_type = 0 then 'ФЛ'
		            else 'ЮЛ'
		        end as type_investor,
		        case
		            when c.individual_id is null then 1
		            else null
		        end as investor_sharer,
		        case
		            when coalesce(i.sex, i1.sex) = 'M' then 'м'
		            when coalesce(i.sex, i1.sex) = 'F' then 'ж'
		        end as sex,
		        case
		            when sp.sharer_type = 'SDS' then 'СДС'
		        end as account_type,
		        coalesce(i.birth_date, i1.birth_date) as birth_date,
		        coalesce(i.sex, i1.sex) as sex_raw,
		        extract(
		            year from age(p_end_date, coalesce(i.birth_date, i1.birth_date))
		        )::smallint as age,
				f.name_in_pfr,
				ps.investment_portfolio_name,
				date(s.created) as REGISTR_DATE,
				ve.value_income as value_income,
				coalesce(sp.min_actuarial_yield, 0,01::numeric) * 100 as actuary_rate,
				case
					when ps.inheritance_on_pay = 'true' and ps.inheritance_on_accum = 'true' then 'полное'
					when ps.inheritance_on_pay = 'false' and ps.inheritance_on_accum = 'true' then 'накопительное'
					when ps.inheritance_on_pay = 'false' and ps.inheritance_on_accum = 'false' then 'нет'
					else 'нет'
				end as assignee_type,
				'ФЛ'::text as sharer_type,
				case
		            when edp.times_in_year = 1  then 'год'
		            when edp.times_in_year = 2  then 'полугодие'
		            when edp.times_in_year = 4  then 'квартал'
		            when edp.times_in_year = 12 then 'месяц'
		            else null
		        end as period_pay_pension,
		        edp.times_in_year as pension_count,
		        edp.value_pension as pension_value,
		        case
		            when ssh_tg.code = 'LA0' then 'НП'
		            when ssh_tg.code = 'MA0' then 'ПВ'
		            else 'ПР'
		        end as type_group,
		        sdp.period_start_date as start_date_pension,
		        case
		            when edp.short_name = 'Срочная'
		                then edp.period_end_date
		            else null
		        end as end_date_pension_period,
		        edp.period_end_date as end_date_pay_pension,
		        psh.status_date::date as suspend_pay_date,
		        clas.class_id as contract_type,
		        f1.name_in_pfr as fund,
		        lower(edp.short_name) as period_pension,
		        case
		            when clsh.name = 'Инвестиционный'
		                then 1::integer
		            else 2::integer
		        end as class_sharer,
				coalesce(i.id,i1.id) as individual_id,
				case
					when zev.chek is not null then 1::int
					else 0::int
				end as check_appl_ev,
				case
                	when obligation.close_status_oblig_end != p_end_date then 'ПО'
                 	else
                    	case
                        	when coalesce(i.birth_date, '1901-01-01') <= '1901-01-01' then 'прочие'
                            when coalesce(edp.pension_payment_type_code, '01') != '01' 
                            	and individual_sharer_status.status_text = 'Выбывший' then 'ИД'
                           	when obligation.obligation_types = 'ППДС' 
                           		and transaction_transfer_out_all.redemption_sharer_id is not null then 'ВС'
                         	when obligation.obligation_types = 'ППДС' 
                         		and di.death_date < p_end_date then 'СМ'
                        	when obligation.obligation_types in ('ОНППВ', 'ОНСПВ') then 'ПВ'
                            when obligation.obligation_types = 'ППДС' 
                            	and coalesce(edp.pension_payment_type_code, '') = '01' then 'ПВ'
                            when 
                            	case
                            		when i.sex = 'F' then i.birth_date + interval '55 year'
                                    when i.sex = 'M' then i.birth_date + interval '60 year' 
                                end <= obligation.close_status_oblig_end
                                  	and obligation.obligation_types = 'ОДНВ' then 'ВПН'
                                  	when obligation.obligation_types = 'ОДНВ' then 'НП'
                                  	else 'Прочие'
                         end
                 end as STATUS_SHARER,
                 obligation.obligation_types,
                 obligation.close_status_oblig_end,
                 case 
	                when obligation.obligation_types = 'ППДС' then 0::integer
                 	else 1::integer
                 end as "TYPE",
                 coalesce(
		            ve.min_actuarial_yield,
		            0
		        ) as get_actuary_rate,
		        fix.fixing_date,
		        case
			        when edp.period_end_date < p_end_date then null::integer
			        when edp.period_end_date is null then null::integer
			        else (
			        	(
			        		extract(year from age(edp.period_end_date, p_end_date)) * 12
			        		+ extract(month from age(edp.period_end_date, p_end_date))
			        	)::int / edp.times_in_year
			        ) + 1
			    end as countPayPension
			from ourpension.sharer s
			join ourpension.contract c on c.id = s.contract_id
			join ourpension.sharer_params sp on sp.sharer_id = s.id
			left join ourpension.pension_scheme ps on ps.id = s.scheme_id
			left join ourpension.entity e on c.entity_id = e.id
			left join ourpension.individual i on i.id = s.individual_id
			left join ourpension.individual i1 on i1.id = c.individual_id
			left join ourpension.fund f on f.id = c.fund_id
			left join ourpension.fund f1 on f1.id = c.sign_fund_id
			left join lateral (
            	select distinct on (nfds.sharer_id)
                    nf.fixing_date
                 from back_office.npo_fixing_details nfds
                 join back_office.npo_fixing nf on nf.id = nfds.npo_fixing_id
                 where nf.approved is not null
                 	and nfds.sharer_id = s.id
                    and nf.service_type = 'PDS'
                    and nf.fixing_type = 'FIXING_BY_PERIOD_IH'
                    and nf.fixing_date <= p_end_date
                 order by nfds.sharer_id, nf.fixing_date desc
            ) fix on true
			left join lateral (
		        select
		            cc.name
		        from ourpension.sharer_class_history sch
		        join ourpension.contract_classes cc on cc.id = sch.class_id
		        where sch.sharer_id = s.id
		          and sch.begin_date < v_datetime_end
		        order by sch.begin_date desc
		        limit 1
		    ) clsh on true
			left join lateral (
		        select
		            cch.class_id
		        from ourpension.contract_class_history cch
		        where cch.contract_id = c.id
		          and cch.begin_date >= p_start_date
		        order by cch.begin_date desc
		        limit 1
		    ) clas on true
			left join lateral (
		        select
		            psh.status_date
		        from ourpension.payment_statuses_history psh
		        where psh.sharer_id = s.id
		          and psh.status_id = 2
		          and psh.status_date < v_datetime_end
		        order by psh.status_date desc
		        limit 1
		    ) psh on true
			left join lateral(
				select
					case
						when cp.min_annual_income_period > 0 then cp.min_annual_income_period
						when cp.min_annual_savings_income > 0 then cp.min_annual_savings_income
						else 0::numeric
					end	as value_income,
					cp.min_actuarial_yield,
					cp.contract_id
				from ourpension.contract_params cp
				where cp.contract_id = c.id
			) ve on true
			left join lateral (
		        select
		            case
		                when pc.period_start_date > DATE '1992-09-16'
		                 and pc.period_start_date is not null
		                    then pc.period_start_date
		                else pc.calculation_date
		            end as period_start_date,
		            coalesce(
		                pcs1.value_pension,
		                pcs3.value_pension
		            ) as value_pension
		        from back_office.pension_calculation pc
		        left join back_office.pension_calculation_scheme1 pcs1 on pcs1.pension_calculation_id = pc.id
		        left join back_office.pension_calculation_scheme3 pcs3 on pcs3.pension_calculation_id = pc.id
		        join ourpension.npo_decision_payment_type ndpt on ndpt.code = pc.npo_decision_payment_type_code
		        join back_office.npo_decision_type ndt on ndt.id = pc.npo_decision_type_id
		        where pc.sharer_id = s.id
		          and pc.calculation_date <= p_end_date
		          and ndpt.short_name in (
		              'До исчерпания',
		              'Срочная',
		              'Пожизненная'
		          )
		          and ndt.code = 'УСТН'
		        order by pc.calculation_date asc
		        limit 1
		    ) sdp on true
		    left join lateral (
		        select
		            pc.period_end_date,
		            ndpt.short_name,
		            pc.npo_decision_payment_type_code as pension_payment_type_code,
		            coalesce(
		                pcs1.value_pension,
		                pcs3.value_pension
		            ) as value_pension,
		            coalesce(
		                pcs1.times_in_year,
		                pcs3.times_in_year
		            ) as times_in_year
		        from back_office.pension_calculation pc
		        join ourpension.npo_decision_payment_type ndpt on ndpt.code = pc.npo_decision_payment_type_code
		        join back_office.npo_decision_type ndt on ndt.id = pc.npo_decision_type_id
		        left join back_office.pension_calculation_scheme1 pcs1 on pcs1.pension_calculation_id = pc.id
		        left join back_office.pension_calculation_scheme3 pcs3 on pcs3.pension_calculation_id = pc.id
		        where pc.sharer_id = s.id
		          and pc.calculation_date <= p_end_date
		          and ndpt.short_name in (
		              'До исчерпания',
		              'Срочная',
		              'Пожизненная'
		          )
		          and ndt.code in ('УСТН', 'КОРР')
		        order by pc.calculation_date desc
		        limit 1
		    ) edp on true
			left join lateral (
            	select distinct on (ad.owner_sharer_id)
            		ad.owner_sharer_id as redemption_sharer_id
                from back_office.transaction t
                join back_office.operation o on t.operation_id = o.id
                join back_office.account ad on t.debit_account_id = ad.id
                where o.operation_type_id in (115, 76, 121, 132, 127, 176)
                	and t.effective_date <= p_start_date
                    and ad.owner_sharer_id = s.id
            ) transaction_transfer_out_all on true
			left join lateral (
				select distinct on (poth.sharer_id)
					vpot.label as obligation_types,
                    case
                    	when f.date_reorganization is null then greatest(poth.start_date, p_start_date)
                        else greatest(poth.start_date, p_start_date, f.date_reorganization)
                    end as status_oblig_start,
                    case 
	                    when poth.end_date = '9999-01-01' 
	                    	then null 
	                    else poth.end_date 
	            	end as close_status_oblig_end
                from ourpension.pension_obligation_types_history poth
                join ourpension.voc_pension_obligation_types vpot on poth.type_id = vpot.id
                where s.id = poth.sharer_id
                	and poth.end_date > (case
	                 						when f.date_reorganization is not null 
	                 							then greatest(f.date_reorganization, p_start_date) 
	                 						else p_start_date
	                 					end)
	            order by poth.sharer_id, poth.start_date desc
            ) obligation on true
            left join lateral (
            	select distinct on (adi.individual_id)
            		adi.individual_id,
            		adi.death_date, 
            		adi.death_info_date, 
            		adi.date as death_registration_date
                from ourpension.application_death_info adi
                where adi.accepted is not null
                	and adi.canceled is null
                	and adi.rejected is null
                	and adi.individual_id = i.id
                order by adi.individual_id, adi.version desc
                limit 1
            ) di on true
            left join lateral (
            	select 
            		case
                    	when ish.enum_status_id = 681 then 'Действующий'
                        when ish.enum_status_id = 682 then 'Выбывший'
                        else 'Неопределено' 
                     end as status_text,
                     ish.enum_status_id as status_id
                 from ourpension.individual_status_history ish
                 where ish.individual_id = i.id
                 	and ish.service_type = 'PDS'
                    and p_start_date between ish.status_date_start and coalesce(ish.status_date_end, '9999-01-01')
                 order by ish.status_date_start desc
                 limit 1
            ) individual_sharer_status on true
			left join lateral (
				select distinct on (afotc.sharer_id)
					afotc.accepted as chek
				from ourpension.application_for_one_time_contribution afotc
				where afotc.sharer_id = s.id
					and afotc.accepted is not null
					and afotc.canceled is null
					and afotc.date <= p_end_date
				order by afotc.sharer_id, afotc.date
			) zev on true
			left join lateral(
				select distinct on (ssh.sharer_id)
					ssh.sharer_id,
					ssh.code
				from ourpension.sharer_statuses_history ssh
				where ssh.code in ('LA0','MA0')
					and ssh.status_date < v_datetime_end
			) ssh_tg on ssh_tg.sharer_id = s.id
			left join (
				select
					ssh.sharer_id,
					ssh.status_date
				from ourpension.sharer_statuses_history ssh
				where ssh.id = 1
			) ssh_eff on ssh_eff.sharer_id = s.id
			left join (
				select
					csh.contract_id,
					csh.status_date
				from ourpension.contract_statuses_history csh
				where csh.id = 1
			) csh_sign on csh_sign.contract_id = c.id
			left join lateral(
				select distinct on (ssh.sharer_id)
					ssh.sharer_id,
					ssh.code,
					ssh.status_date                                        
				from ourpension.sharer_statuses_history ssh
				where ssh.sharer_id = s.id
					and ssh.status_date::date <= p_start_date
				order by ssh.sharer_id, ssh.status_date desc, ssh.id desc
			) last_before_ssh on true
			where c."service_type" = 'PDS'
				and (p_name_in_pfr is null or f.name_in_pfr = p_name_in_pfr)
					and exists (
							select 1
							from back_office.balance b
							join back_office.account a on a.id = b.account_id
							where a.owner_sharer_id = s.id
								and b.start_date >= p_start_date
								and b.start_date <= p_end_date
								and (coalesce(b.credit, 0) > 0
									or coalesce(b.debit, 0) > 0)
					)
					or (
						last_before_ssh.code in ('KA0','LA0','MA0')
						or exists (
							select 1
							from ourpension.sharer_statuses_history ssh2
							where ssh2.sharer_id = s.id
								and ssh2.code in ('LA0','MA0')
								and ssh2.status_date >= p_start_date
								and ssh2.status_date < v_datetime_end
						)
					)
					
					;
		create index on t_sharer_base_pds_af(sharer_id);
		create index on t_sharer_base_pds_af(individual_id);
		analyze t_sharer_base_pds_af;
	
		drop table if exists t_pension_scheme_pds_af;
		create temp table t_pension_scheme_pds_af on commit drop as
			with sharer_ids as materialized (
			    select
			        array_agg(
			            sb.sharer_id
			            order by sb.sharer_id
			        )::integer[] as sharer_ids
			    from t_sharer_base_pds_af sb
			),
			pension_scheme_raw as materialized (
			    select
			        gps.*
			    from sharer_ids a
			    cross join lateral actuary.get_pension_scheme_for_report(
			        a.sharer_ids,
			        '{}'::integer[],
			        p_start_date,
			        p_end_date,
			        'PDS'
			    ) gps
			)
			    select
			        gps.sharer_id,
			        gps.name as pension_scheme_name,
			        gps."number" as scheme_contract,
			        gps.investment_portfolio_name,
			        gps.scheme_rule_name,
			        case
			            when sb.type_group = 'НП'
			                then gps.mgd_accum
			            else 0::numeric
			        end as mgd_accum,
			        case
			            when sb.type_group = 'ПВ'
			                then gps.mgd_pay
			            else 0::numeric
			        end as mgd_pay,
			        case
			            when 'true' = any(gps.inheritance_on_pay)
			             and 'true' = any(gps.inheritance_on_accum)
			                then 'полное'
			            when 'false' = any(gps.inheritance_on_pay)
			             and 'true' = any(gps.inheritance_on_accum)
			                then 'накопительное'
			            when 'false' = any(gps.inheritance_on_pay)
			             and 'false' = any(gps.inheritance_on_accum)
			                then 'нет'
			            else 'нет'
			        end as assignee_type,
			        gps.min_deposit_value as valueInpaymentContract,
			        gps.oud,
			        gps.period_investment_horizont
			    from pension_scheme_raw gps
			    join t_sharer_base_pds_af sb on sb.sharer_id = gps.sharer_id;
		create index on t_pension_scheme_pds_af(sharer_id);
		analyze t_pension_scheme_pds_af;
		
		drop table if exists t_tx_pds_af;
		create temp table t_tx_pds_af on commit drop as 
			select
				sb.sharer_id,
				sb.effective_date as sharer_effective_date,
				t.effective_date,
				t.value,
				ot.code as operation_code,
				at2.mnemonics,
				case
					when t.credit_account_id = a.id then 'credit'
					when t.debit_account_id = a.id then 'debit'
				end as direction,
				o.approved,
                o.deleted,
                o.revoked
			from t_sharer_base_pds_af sb
			join back_office.account a on a.owner_sharer_id = sb.sharer_id
			join back_office.transaction t on a.id in (t.credit_account_id,t.debit_account_id)
			join back_office.operation o on o.id = t.operation_id
			join back_office.operation_type ot on ot.id = o.operation_type_id
			join back_office.account_type at2 on at2.id = a.account_type_id
			where t.effective_date <= p_end_date
				and ot.code in (
					--credit part
		            'PDS_DEPOSIT_ENROLLMENT',
					'PDS_OPS_ENROLLMENT_PDS',
					'PDS_GOS_ENROLLMENT',
					'PDS_PENSION_INVESTMENT_REVENUE_ENROLLMENT',
					'PDS_RETURN_NDFL_LUMP_SUM',
					'PDS_RETURN_REDEMPTION_SUM',
					'PDS_RETURN_PERIODIC_PAYMENT',
					'PDS_RETURN_SUCCESSOR_PAYMENT',
					'PDS_RETURN_NDFL_REDEMPTION',
					'PDS_RETURN_NDFL_PERIODIC',
					'PDS_RETURN_NDFL_SUCCESSOR',
					'PDS_RETURN_LUMP_SUM_PAYMENT',
					'PDS_DEPOSIT_ENROLLMENT_FOR_EMPLOYER',
					--debit part
					'PDS_PENSION_PAYMENT',
					'PDS_NDFL_PENSION_PAYMENT',
					'PDS_REDEMPTION_PAYMENT',
					'PDS_REDEMPTION_ENROLLMENT_TO_NPF',
					'PDS_ADDITIONAL_PAYMENT_REDEMPTION',
					'PDS_REP_PAYMENT_TERMINATED',
					'PDS_NDFL_REDEMPTION_PAYMENT',
					--sber return
					'PDS_SAVINGS_CONTRIB_RETURN',
					--other trans
					'PDS_TRNSF_TO_INSURED_FUND_REDEMPTION',
					'PDS_TRNSF_TO_INSURED_FUND_DECEASED',
					'GUARANTEE_ENROLLMENT'
		      )
		      or at2.mnemonics in (
		      	--onetime stim
		      	'ПДС ЕВ', 'ПДС ЕВ ИД', 'ПДС СОФ', 'ПДС СОФ ИД',
		      	--sber sum
		      	'ПДС СВ', 'ПДС СВ ИД'
		      );
		create index on t_tx_pds_af(sharer_id);
		create index on t_tx_pds_af(sharer_effective_date);
		create index on t_tx_pds_af(effective_date);
		create index on t_tx_pds_af(operation_code);
		create index on t_tx_pds_af(mnemonics);
		analyze t_tx_pds_af;
	
	return query
		with credit_tx as materialized (
		    select
		        *
		    from t_tx_pds_af
		    where direction = 'credit'
		    	and operation_code in (
		            'PDS_DEPOSIT_ENROLLMENT',
					'PDS_OPS_ENROLLMENT_PDS',
					'PDS_GOS_ENROLLMENT',
					'PDS_PENSION_INVESTMENT_REVENUE_ENROLLMENT',
					'PDS_RETURN_NDFL_LUMP_SUM',
					'PDS_RETURN_REDEMPTION_SUM',
					'PDS_RETURN_PERIODIC_PAYMENT',
					'PDS_RETURN_SUCCESSOR_PAYMENT',
					'PDS_RETURN_NDFL_REDEMPTION',
					'PDS_RETURN_NDFL_PERIODIC',
					'PDS_RETURN_NDFL_SUCCESSOR',
					'PDS_RETURN_LUMP_SUM_PAYMENT',
					'PDS_DEPOSIT_ENROLLMENT_FOR_EMPLOYER',
					--
					'GUARANTEE_ENROLLMENT'
					
		      )
		),
		debit_tx as materialized (
			select
		    	*
		    from t_tx_pds_af
		    where direction = 'credit'
		    	and operation_code in (
					'PDS_PENSION_PAYMENT',
					'PDS_NDFL_PENSION_PAYMENT',
					'PDS_REDEMPTION_PAYMENT',
					'PDS_REDEMPTION_ENROLLMENT_TO_NPF',
					'PDS_ADDITIONAL_PAYMENT_REDEMPTION',
					'PDS_REP_PAYMENT_TERMINATED',
					'PDS_NDFL_REDEMPTION_PAYMENT',
					--
					'PDS_TRNSF_TO_INSURED_FUND_REDEMPTION',
					'PDS_TRNSF_TO_INSURED_FUND_DECEASED'
				)
		),
		first_inpay_day as materialized (
		    select
		        sb.sharer_id,
		        ct.effective_date::date as effective_date,
		        sum(ct.value) as value_inpayment_first
		    from t_sharer_base_pds_af sb
		    join credit_tx ct on ct.sharer_id = sb.sharer_id
		    	and ct.operation_code in (
		    		'PDS_DEPOSIT_ENROLLMENT',
					'PDS_OPS_ENROLLMENT_PDS',
					'PDS_GOS_ENROLLMENT'
				)
		    group by
		        sb.sharer_id,
		        ct.effective_date::date
		),
		first_inpay as materialized (
		    select distinct on (f.sharer_id)
		        f.sharer_id,
		        f.effective_date as inpaymentFirst_DATE,
		        f.value_inpayment_first as valueInpaymentFirst
		    from first_inpay_day f
		    order by
		        f.sharer_id,
		        f.effective_date asc
		),
		payments_credit as materialized (
		    select
		        ct.sharer_id,
		        sum(ct.value) filter (
		            where ct.operation_code =
		                  'PDS_PENSION_INVESTMENT_REVENUE_ENROLLMENT'
		        ) as incomeValueTotal,
		        sum(ct.value)
					filter(where ct.operation_code = 'PDS_PENSION_INVESTMENT_REVENUE_ENROLLMENT'
							and ct.effective_date 
								between make_date(
									extract(
										year from p_start_date
									)::integer - 1, 1, 1
								)
								and make_date(
									extract(
										year from p_start_date
									)::integer - 1, 12, 31
								)
				) as income_last_value,
				sum(ct.value) filter (
		            where ct.operation_code = 'PDS_RETURN_PERIODIC_PAYMENT'
		            	and ct.effective_date <= p_end_date
		        ) as value_return,
				sum(ct.value) filter (
		            where ct.operation_code in (
		            		'PDS_DEPOSIT_ENROLLMENT',
							'PDS_DEPOSIT_ENROLLMENT_FOR_EMPLOYER'
		            	)
		            	and ct.effective_date between p_start_date and p_end_date
		        ) as sber_vznos,
				sum(ct.value) filter (
		            where ct.operation_code = 'PDS_GOS_ENROLLMENT'
		              and ct.effective_date between p_start_date and p_end_date
		        ) as stimul_vznos,
		        sum(ct.value) filter (
		            where ct.operation_code in (
		            	'PDS_DEPOSIT_ENROLLMENT',
						'PDS_OPS_ENROLLMENT_PDS',
						'PDS_GOS_ENROLLMENT'
			          )
		              and ct.effective_date between p_start_date and p_end_date
		        ) as inpayment_value,
		        sum(ct.value) filter (
		            where ct.operation_code in (
		            	'PDS_DEPOSIT_ENROLLMENT',
						'PDS_OPS_ENROLLMENT_PDS',
						'PDS_GOS_ENROLLMENT'
			          )
		              and ct.effective_date >= p_start_date::date - interval '1 year'
		              and ct.effective_date <  p_start_date::date
		        ) as transactionInpaymentValue1,
		        sum(ct.value) filter (
		            where ct.operation_code in (
		            	'PDS_DEPOSIT_ENROLLMENT',
						'PDS_OPS_ENROLLMENT_PDS',
						'PDS_GOS_ENROLLMENT'
			          )
		              and ct.effective_date >= p_start_date::date - interval '2 year'
		              and ct.effective_date <  p_start_date::date - interval '1 year'
		        ) as transactionInpaymentValue2,
		        sum(ct.value) filter (
		            where ct.operation_code in (
		            	'PDS_DEPOSIT_ENROLLMENT',
						'PDS_OPS_ENROLLMENT_PDS',
						'PDS_GOS_ENROLLMENT'
			          )
		              and ct.effective_date >= p_start_date::date - interval '3 year'
		              and ct.effective_date <  p_start_date::date - interval '2 year'
		        ) as transactionInpaymentValue3,
		        sum(-ct.value) filter (
		            where ct.operation_code in (
			                'PDS_RETURN_NDFL_LUMP_SUM',
							'PDS_RETURN_REDEMPTION_SUM',
							'PDS_RETURN_PERIODIC_PAYMENT',
							'PDS_RETURN_SUCCESSOR_PAYMENT',
							'PDS_RETURN_NDFL_REDEMPTION',
							'PDS_RETURN_NDFL_PERIODIC',
							'PDS_RETURN_NDFL_SUCCESSOR',
							'PDS_RETURN_LUMP_SUM_PAYMENT'
		            	)
		            	and ct.effective_date between p_start_date and p_end_date
		        ) as value_pay,
		        sum(-ct.value) filter (
		        	where ct.operation_code = 'GUARANTEE_ENROLLMENT'
		        		and ct.effective_date between p_start_date and p_end_date
		        ) as other_trans
		    from credit_tx ct
		    group by ct.sharer_id
		),
		payments_debit as materialized (
		    select
		        dt.sharer_id,
		        sum(dt.value) filter (
		        	where dt.operation_code in (
		        			'PDS_PENSION_PAYMENT',
							'PDS_NDFL_PENSION_PAYMENT',
							'PDS_REDEMPTION_PAYMENT',
							'PDS_REDEMPTION_ENROLLMENT_TO_NPF',
							'PDS_ADDITIONAL_PAYMENT_REDEMPTION',
							'PDS_REP_PAYMENT_TERMINATED',
							'PDS_NDFL_REDEMPTION_PAYMENT'
						)
		        		and dt.effective_date between p_start_date and p_end_date
		        ) as value_pay,
		        sum(dt.value) filter (
		        	where dt.operation_code in (
		        			'PDS_TRNSF_TO_INSURED_FUND_REDEMPTION',
							'PDS_TRNSF_TO_INSURED_FUND_DECEASED'
						)
		        		and dt.effective_date between p_start_date and p_end_date
		        ) as other_trans
		    from debit_tx dt
		    group by dt.sharer_id
		),
		last_pension_payment as materialized (
		    select
		        dt.sharer_id,
		        max(dt.effective_date) as effective_date
		    from debit_tx dt
		    where dt.operation_code = 'PDS_PENSION_PAYMENT'
		    group by dt.sharer_id
		),
		next_pay_pension_date as materialized (
		    select
		        sb.sharer_id,
		        case
		            when sb.period_pay_pension = 'год'
		                then lpp.effective_date + interval '1 year'
		            when sb.period_pay_pension = 'полугодие'
		                then lpp.effective_date + interval '6 months'
		            when sb.period_pay_pension = 'квартал'
		                then lpp.effective_date + interval '3 months'
		            when sb.period_pay_pension = 'месяц'
		                then lpp.effective_date + interval '1 month'
		            else null
		        end as pension_next_pay_date
		    from t_sharer_base_pds_af sb
		    join last_pension_payment lpp on lpp.sharer_id = sb.sharer_id
		),
		balances as materialized (
		    select
		        sb.sharer_id,
		        greatest(
		            coalesce(
		                sum(
		                    b.total_credit - b.total_debit
		                ) filter (
		                    where b.start_date <= p_end_date
		                      and b.end_date   >= p_end_date
		                ),
		                0
		            ),
		            0
		        ) as balance_end,
		        greatest(
		            coalesce(
		                sum(
		                    b.total_credit - b.total_debit
		                ) filter (
		                    where sb.start_date_pension is not null
		                      and b.start_date <= sb.start_date_pension
		                      and b.end_date   >= sb.start_date_pension
		                ),
		                0
		            ),
		            0
		        ) as balance_by_pension_start
		    from t_sharer_base_pds_af sb
		    join back_office.account a on a.owner_sharer_id = sb.sharer_id
		    join back_office.balance b on b.account_id = a.id
		     and (
		            (
		                b.start_date <= p_end_date
		                and b.end_date >= p_end_date
		            )
		            OR
		            (
		                sb.start_date_pension is not null
		                and b.start_date <= sb.start_date_pension
		                and b.end_date >= sb.start_date_pension
		            )
		         )
		    group by sb.sharer_id
		),
		get_balance_transfer as (
            	with balances as (
                	select
                		tx.sharer_id,
                		sum(tx.value) filter (
				            where tx.mnemonics = 'ПДС ЕВ'
				              and tx.effective_date <= p_end_date
				              and tx.direction = 'credit'
				        ) as inpayment_ev_value,
				        sum(tx.value) filter (
				            where tx.mnemonics = 'ПДС СОФ'
				              and tx.effective_date <= p_end_date
				              and tx.direction = 'credit'
				        ) as inpayment_add_value,
                		coalesce(
                			sum(tx.value) filter (
                				where tx.direction = 'credit'
                					and tx.effective_date <= p_end_date
                					and tx.mnemonics in (
                						'ПДС СВ', 'ПДС СВ ИД'	
                					)
                				),
                				0
                		) as sum_credit,
                		coalesce(
                			sum(tx.value) filter (
                				where tx.direction = 'debit'
                					and tx.operation_code = 'PDS_SAVINGS_CONTRIB_RETURN'
                					and tx.effective_date <= p_end_date
                					and tx.approved is not null
                        			and tx.deleted is null
                       				and tx.revoked is null
                			),
                			0
                		) as sum_return,
                		coalesce(
                			bool_or(
                				tx.mnemonics in ('ПДС ЕВ', 'ПДС ЕВ ИД', 'ПДС СОФ', 'ПДС СОФ ИД')
                				and tx.effective_date <= p_end_date
                			),
                			false
                		) as has_onetime_stim
                	from t_tx_pds_af tx
                	group by tx.sharer_id
				)
                select --distinct on (sb.sharer_id)
	           		case
	            		when sb.obligation_types = 'ОДНВ' and sb.close_status_oblig_end is null 
	                    	then
	                        	case
	                            	when b.has_onetime_stim
	                            		then b.sum_credit - b.sum_return
	                            	else 
		                            	(
		                            		select f.s_vykup
		                            		from actuary.get_surrender_value(
		                            			'PAYMENT', 
												sb.sharer_id, 
												p_end_date, 
												null
		                            		) f
		                            	)
	                	        end
						else null 
					end as value,
					(b.sum_credit - b.sum_return) as sb_value,
					b.inpayment_ev_value,
					b.inpayment_add_value,
					sb.sharer_id
				from balances b
				join t_sharer_base_pds_af sb on sb.sharer_id = b.sharer_id
		),
		get_balance_end_ops as (
			select
				sum(b.total_credit - b.total_debit) as balance_end_OPS,
				sb.individual_id
			from back_office.balance b
			join back_office.account a on b.account_id = a.id
			join ourpension.sharer s on s.id = a.owner_sharer_id
			join ourpension.contract c on c.id = s.contract_id
			join t_sharer_base_pds_af sb on c.individual_id = sb.individual_id
			join ourpension.fund f on f.id = c.fund_id
			where b.start_date <= p_end_date
				and b.end_date >= p_end_date
				and c.service_type = 'OPS'
				and (p_name_in_pfr is null or f.name_in_pfr = p_name_in_pfr)
			group by  sb.individual_id
		)
		select	
			sb.CODE										as CODE,
			sb.sharer_code_1c::integer	 				as CODE_SHARER,
			sb.contract_code_1c::integer	 			as CODE_CONTRACT,	
			sb.sharer_number::text 						as SELFNUMBER_SHARER,
			sb.contract_number::text	 				as SELFNUMBER_CONTRACT,
			date(sb.sign_date)::date					as SIGN_DATE,
			date(sb.effective_date)::date		 		as EFFECTIVE_DATE,
			fi.inpaymentFirst_DATE::date 				as inpaymentFirst_DATE,
			sb.name_investor::text		 				as NAME_INVESTOR,
			sb.investor_sharer::integer					as INVESTOR_SHARER,
			sb.STATUS_SHARER::text						as STATUS_SHARER,
			sb.TYPE_GROUP::text							as TYPE_GROUP,
			sb.sex::text	 							as SEX,
			sb.birth_date::date		 					as BIRTH_DATE,
			sb.age::smallint							as AGE,
			sb.fund::text								as FUND,
			ps.scheme_contract::text					as SCHEME_CONTRACT,
			ps.scheme_rule_name::text		 			as SCHEME_NAME,
			ps.investment_portfolio_name::text		 	as portfolioInvest,
			sb.ACCOUNT_TYPE::text		 				as ACCOUNT_TYPE,
			sb.REGISTR_DATE::date 						as REGISTR_DATE,
			1::integer									as CLASS_SHARER,
			1::integer 									as contract_type,
			coalesce(ps.oud, 0)::numeric 				as OUD,
			null::bigint								as segment,
			coalesce(sb.value_income, 0) 				as VALUE_INCOME,
			null::text									as PERIOD_INCOME,
			ps.assignee_type::text						as ASSIGNEE_TYPE,
			ps.valueInpaymentContract::numeric			as valueInpaymentContract, --различается
			sb.GET_ACTUARY_RATE::integer				as GET_ACTUARY_RATE,--нет данных
			gbe.balance_end::numeric					as BALANCE_END, --не сходится
			null::numeric 								as BALANCE_BY_PENSION,
			gbe.balance_end::numeric					as BALANCE_END_IPS,
			gbt.value::numeric							as BALANCE_TRANSFER,
			pc.incomeValueTotal::numeric 				as incomeValueTotal, --не сходится
			pc.INPAYMENT_VALUE::numeric 				as INPAYMENT_VALUE,
			coalesce(pd.other_trans + pc.other_trans, 0)::numeric		as OTHERTRANSFER_VALUE,
			coalesce(pd.VALUE_PAY + pc.VALUE_PAY, 0)::numeric			as VALUE_PAY,
			null::text									as "CONDITION",
			null::text									as RESPONS,
			sb.START_DATE_PENSION::date					as START_DATE_PENSION,
			sb.PERIOD_PENSION::text 					as PERIOD_PENSION,
			sb.PENSION_VALUE::numeric 					as PENSION_VALUE,
			1::bigint									as INDEXATION,
			nppd.PENSION_NEXT_PAY_DATE::date			as PENSION_NEXT_PAY_DATE,
			sb.suspend_pay_date::date 					as SUSPEND_PAY_DATE,
			sb.PERIOD_PAY_PENSION::text					as PERIOD_PAY_PENSION,
			sb.pension_count::integer					as PENSION_COUNT,
			sb.END_DATE_PAY_PENSION::date				as END_DATE_PAY_PENSION,
			sb.END_DATE_PENSION_PERIOD::date			as END_DATE_PENSION_PERIOD,
			sb."TYPE"::integer		 					as "TYPE",
			null::bigint		 						as FIXED_VALUE,
			coalesce(sb.ACTUARY_RATE, 0)::numeric		as ACTUARY_RATE, --нет данных
			pc.value_return::numeric					as valueReturn,
			pc.transactionInpaymentValue1::numeric	 	as transactionInpaymentValue1,
			pc.transactionInpaymentValue2::numeric	 	as transactionInpaymentValue2,
			pc.transactionInpaymentValue3::numeric	 	as transactionInpaymentValue3,
			'ФЛ'::text 									as SHARER_TYPE,	
			fi.valueInpaymentFirst::numeric 			as valueInpaymentFirst, --не совпало, проверить
			coalesce(gbe.balance_by_pension_start, 0)::numeric		as balanceByPensionStart, --не совпало
			sb.obligation_types::text					as obligationTypes,
			gbt.inpayment_ev_value::numeric				as inpayment_ev_value,
			gbt.inpayment_add_value::numeric			as inpayment_add_value,
			gbt.sb_value::numeric						as inpayment_sb_value,
			sb.fixing_date::date 						as date_investment_horizont,
			coalesce(ps.period_investment_horizont, 1)::integer 		as period_investment_horizont,
			0::numeric 									as value_investment_horizont,
			case
            	when sb.obligation_types = 'ОДНВ' 
            		and sb.close_status_oblig_end is null 
            		and coalesce(pc.stimul_vznos, pc.sber_vznos, 0) <> 0 
            	then null::date
                when gbe.balance_end >= gbt.value
                then p_end_date
            end 										as dateCalcRedemption,
			sb.check_appl_ev::integer					as check_appl_ev,
			gbeo.balance_end_OPS::numeric				as balance_end_OPS,
			sb.countPayPension::integer 				as countPayPension,
			pc.income_last_value::numeric 				as income_last_value
		from t_sharer_base_pds_af sb
		left join payments_credit pc on pc.sharer_id = sb.sharer_id
		left join payments_debit pd on pd.sharer_id = sb.sharer_id
		left join first_inpay fi on fi.sharer_id = sb.sharer_id
		left join balances gbe on gbe.sharer_id = sb.sharer_id
		left join next_pay_pension_date nppd on nppd.sharer_id = sb.sharer_id
		left join get_balance_end_ops gbeo on gbeo.individual_id = sb.individual_id
		left join t_pension_scheme_pds_af ps on ps.sharer_id = sb.sharer_id
		left join get_balance_transfer gbt on gbt.sharer_id = sb.sharer_id;
	
		exception when others then
			raise exception 'ERROR: %', sqlerrm;
	
	END;
$function$
;
