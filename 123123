ALTER PROCEDURE  [REPORT].[actuaryPDS_msfo17PR] (@startDate date, @endDate date)
AS
BEGIN TRY
------------------------------------------------------------------------------------------------------------------
-- АФ ПДС ФЛ расширенная для МСФО 17
-- Все фонды, кроме Будущего
------------------------------------------------------------------------------------------------------------------    
set nocount on;           

with [recBalanceStartPension] as (
select [sharer].[ID_SHARER] 
           ,[balanceByPensionStart].[VALUE] as [balanceByPensionDay]
          ,[balanceByPensionStart0].[VALUE] as [balanceByPensionDayPlus1]
from [project_xbrl].[pds].[registrSharer]()  as [sharer]
                    join [project_xbrl].[pds].[registrPensionDate] (@endDate)  as [pension] on  [sharer].[ID_SHARER] = [pension].[ID_SHARER] 
                                                
 
                   outer apply ( 
                                                select 
                                                [transaction].[pds_pension_account_id] as [ID_SHARER]
                                                ,sum(
                                                case 
                                                when [transaction].[record_kind] = 0 
                                                then 1 *  [transaction].[amount] --'CR'
                                                else  -1* [transaction].[amount] --'DB'
                                                end) as [VALUE]
                                                from [DWH].[npf].[pds_pension_account_operation] as [transaction] with(nolock)
                                                where [transaction].[is_active] = 1
                                                           and  [transaction].[pds_pension_account_id] = [sharer].[ID_SHARER]
                                                          and [transaction].[period] < dateAdd(day,1,[pension].[START_DATE_FIRST]) 
                                                group by  [transaction].[pds_pension_account_id] 
                  ) as [balanceByPensionStart]	


                  outer apply ( 
                                            select 
                                            [transaction].[pds_pension_account_id] as [ID_SHARER]
                                            ,sum(
                                            case 
                                            when [transaction].[record_kind] = 0 
                                            then 1 *  [transaction].[amount] --'CR'
                                            else  -1* [transaction].[amount] --'DB'
                                            end) as [VALUE]
                                            from [DWH].[npf].[pds_pension_account_operation] as [transaction] with(nolock)
                                            where [transaction].[is_active] = 1
                                                       and  [transaction].[pds_pension_account_id] = [sharer].[ID_SHARER]
                                                     and [transaction].[period] < dateAdd(day,2,[pension].[START_DATE_FIRST]) 
                                            group by  [transaction].[pds_pension_account_id] 
                  ) as [balanceByPensionStart0]	
 

)
select  distinct 
 [natural].[code] as [CODE] --Уникальный идентификатор физического лица
,[sharer].[CODE_SHARER] as [CODE_SHARER] --Уникальный идентификатор пенсионного счета
,[contract].[CODE] as [CODE_CONTRACT] --Уникальный идентификатор договора с вкладчиком
,[sharer].[SELFNUMBER] as [SELFNUMBER_SHARER] --Номер пенсионного счета
,[contract].[SELFNUMBER] as [SELFNUMBER_CONTRACT] --Номер договора с вкладчиком
,[contract].[SIGN_DATE] as [SIGN_DATE] --Дата заключения договора с вкладчиком
,[sharerEffective].[VALUE_DATE] as [EFFECTIVE_DATE] --Дата вступления в силу договора
,[transactionInpaymentFirst].[VALUE_DATE] as [inpaymentFirst_DATE] --Дата первого взноса по договору
,'фл' as [NAME_INVESTOR] --Наименование вкладчика - Юр.лица или ФЛ для физ.лица
,nullif(0,0) as [INVESTOR_SHARER] --Соотнесение вкладчика и участника код 
, case
                           when coalesce([natural].[BIRTH_DATE],'1901-01-01') <= '1901-01-01' /*если дата рождения = пусто или 01.01.1901, то статус = прочие*/
                           then N'прочие'   
                           when [obligationTypes].[VALUE] = N'ППДС' and [transactionTransferOutAll].[ID_SHARER] is not null
                           then N'ВС' --/выкупная'
                           when [obligationTypes].[VALUE] = N'ППДС' and (coalesce([natural].[DEATH_DATE],'2255-01-01') < @endDate and coalesce([documentAlive].[VALUE_DATE],'2255-01-01') < @endDate)
                           then N'СМ'
                           when [obligationTypes].[VALUE] in ( N'ОНППВ',N'ОНСПВ')
                           then N'ПВ' 
                           when [obligationTypes].[VALUE] = N'ППДС'  and coalesce([pension].[PENSION_TYPE],'') = N'единовременная выплата'
                           then N'ПВ' 
                           when
                                    case 
                                    when [natural].[SEX] = N'ж' 
                                    then dateAdd(year,55,[natural].[BIRTH_DATE]) 
                                    when [natural].[SEX] = N'м' 
                                    then dateAdd(year,60,[natural].[BIRTH_DATE])
