   create index [data] on #data ([ID_SHARER]);                                    
                                       
     if object_id('tempdb..#tempAFNPO_17') is not null drop table #tempAFNPO_17;
     select --distinct
          [data].[CODE_SHARER] as [NN],
          [data].[CODE] as [CODE] -- [Уникальный идентификатор физического лица]
                ,[data].[CODE_CONTRACT] --[Уникальный идентификатор договора с вкладчиком]
                ,[data].[CODE_SHARER] --[Уникальный идентификатор пенсионного счета]
                ,[data].[SELFNUMBER_SHARER] as [SELFNUMBER_SHARER] --[Номер пенсионного счета]
                ,[data].[SELFNUMBER_CONTRACT] as [SELFNUMBER_CONTRACT] --[Номер договора с вкладчиком]
                ,[data].[SIGN_DATE] as [SIGN_DATE] --[Дата заключения договора с вкладчиком]	
                ,[data].[EFFECTIVE_DATE] --[Дата вступления в силу договора]
                ,[inpaymentFirst].[VALUE_DATE] as [inpaymentFirst_DATE] --[Дата первого взноса по договору]
                ,[data].[NAME_INVESTOR] --[Наименование вкладчика - Юр.лица или "ФЛ" для физ.лица]
                ,cast(case when [data].[ACCOUNT_PART_TYPE] in (N'СЧ') then 1 when [data].[ACCOUNT_PART_TYPE] in (N'БЧ') then 2  end as integer) as [INVESTOR_SHARER] --[Соотнесение вкладчика и участника (код)] -- ИЧ = пусто, СЧ = 1 или БЧ = 2 (ФЛ в пользу третьих лиц)
                ,[data].[STATUS_SHARER] as [STATUS_SHARER] --[Статус участника (код)]
                
                ,[data].[SEX] as [SEX] --[Пол участника]
                ,[data].[BIRTH_DATE] as [BIRTH_DATE] -- [Дата рождения участника]
                ,[data].[FUND] --[Фонд, заключивший договор]
                ,[data].[SCHEMA_CONTRACT] as [SCHEME_CONTRACT] -- [Код условий НПО (из формы АФ101)]
                ,[data].[SCHEME_NAME]  --[Номер/название пенсионной схемы]
                ,[data].[portfolioInvest] --[Стратегия инвестирования] 
                
                ,[data].[ACCOUNT_TYPE] as [ACCOUNT_TYPE] --[Вид пенсионного счета (код)]
                ,[data].[REGISTR_DATE] -- [Дата открытия пенсионного счета (только для ИПС)]
                --,[data].[CLASS_SHARER_BEFORE] as [Классификация (код) на начало периода (31.12 предыдущего года)] --инвестиционный = 1 , страховой = 2, если на 31 12 инвестиционный, а на конец СТРАХОВОЙ = 3 ОДНА КОЛОНКА
                ,
                cast(
                case 
                        when coalesce([data].[CLASS_SHARER_BEFORE],N'инвестиционный') != coalesce([data].[CLASS_SHARER],N'инвестиционный') then 3 
                        when coalesce([data].[CLASS_SHARER],N'') = N'инвестиционный' then 1 
                        when [data].[CLASS_SHARER] = N'страховой' then 2 
                end as integer ) as [CLASS_SHARER] -- [Классификация (код)]
                ,[data].[OUD] --[% целевого взноса или отчисления от взноса на CC]
                
                ,nullif(1,1) as [segment] --[Сегмент (номер)] --Пустой столбец	
                
                ,[data].[VALUE_INCOME] as [VALUE_INCOME] --[Гарантированная норма доходности]
                ,[data].[PERIOD_INCOME] as [PERIOD_INCOME] --[Период действия гарантированной нормы доходности]
                ,[data].[ASSIGNEE] as [ASSIGNEE_TYPE]--[Наличие правопреемства (полное, накопительное, выплатное, нет)]
                ,[data].[valueInpaymentContract] -- [Установленный договором размер взноса]
                ,case when [data].[ACTUARY_RATE] is not null then 1 else 0 end as [GET_ACTUARY_RATE]  -- [Тариф (таблицы смертности/АНД) установлен договором (0-нет, 1 -да)]
                
                ,[data].[BALANCE_END_VALUE] as [BALANCE_END] -- [Обязательства перед участником на конец отчетного периода. всего]--Пустой столбец	
                ,nullif(0,0) as [BALANCE_BY_PENSION] -- [Обязательства перед участником на конец отчетного периода.в т.ч. по назначенным пенсиям]--Пустой столбец	
                
                ,case when  [data].[ACCOUNT_TYPE] = N'СПС'  then 0 else [data].[BALANCE_END_VALUE] end as [BALANCE_END_IPS] --[Остаток по ИПС на конец отчетного периода]
                ,case when  [data].[ACCOUNT_TYPE] = N'СПС'  then 0 else [data].[BALANCE_TRANSFER] end as [BALANCE_TRANSFER] --[Сумма обязательств на конец отчетного периода по выкупной сумме]
                ,[transactionIncome].[VALUE] as [incomeValueTotal] --[Сумма зачисленного на счет дохода, с начала действия договора]
                
                ,case when  [data].[ACCOUNT_TYPE] = N'СПС'  then 0 else [data].[INPAYMENT_VALUE]end as [INPAYMENT_VALUE]  --[Сумма пенсионных взносов в отчетном периоде]
                ,case when  [data].[ACCOUNT_TYPE] = N'СПС'  then 0 else  coalesce([data].[MERGE_VALUE],0) + coalesce([data].[OTHERTRANSFER_VALUE],0) end as [OTHERTRANSFER_VALUE] --[Сальдо переводов на счет в отчетном периоде]
                ,coalesce([data].[PENSION_VALUE],0) + coalesce([data].[TRANSFER_VALUE],0) + coalesce([data].[ASSIGNEE_VALUE],0) as [VALUE_PAY] --[Сумма пенсионных выплат в отчетном периоде] --Выплата пенсии+ Выкупная сумма+ Выплаты правопреемникам	
                
                ,case when  [data].[PERIOD_PENSION]  is not null then N'фондированная' end as [CONDITION] --[Условия фондирования (фондированная, частично фондированная, не фондированная)]
                ,case 
                when  [data].[PERIOD_PENSION]  is not null then 
                            case 
                            when  [data].[ACCOUNT_TYPE] = N'СПС'  then N'Фонд, в пределах остатка счета'  
                            when  [data].[ACCOUNT_TYPE] = N'ИПС'  then N'Фонд, в объеме обязательств по выплате'
                            end 
                end as [RESPONS] --[Ответственность за дополнительное фондирование (вкладчик, участник, фонд, смешанная)]
                
                ,cast([data].[START_DATE_PENSION] as date) as  [START_DATE_PENSION] --[Дата назначения]
                ,case 
                        when [data].[PERIOD_PENSION]  = N'срочно' then  N'срочная' 
                        when [data].[PERIOD_PENSION]  = N'пожизненно' then N'пожизненная' 
                        else [data].[PERIOD_PENSION] 
                end as [PERIOD_PENSION] --[Период выплаты пенсии (пожизненная, срочная, до исчерпания, смешанно)] -- ТОЛЬКО для ПЕНСИОНЕРОВ
                ,[data].[PENSION] as [PENSION_VALUE] --[Размер по состоянию на отчетную дату]
                ,nullif(1,1) as [INDEXATION] --[Безусловная индексация: 0-нет, 1-по доходу, 2-по доходу сверх гарантии] --	Пустой столбец	
                ,
                case
                when [lastPay].[VALUE_DATE] is not null and [data].[DIVISOR] is not null
                then 
                     case 
                     when 
                              dateAdd(month,[data].[DIVISOR],[lastPay].[VALUE_DATE]) <= coalesce([data].[END_DATE_PAY_PENSION],'2050-01-01') 
                      and dateAdd(month,[data].[DIVISOR],[lastPay].[VALUE_DATE]) > @endDate
                      and dateAdd(month,[data].[DIVISOR],[lastPay].[VALUE_DATE]) < coalesce([suspendPay].[START_DATE],'2050-01-01')
                      and dateAdd(month,[data].[DIVISOR],[lastPay].[VALUE_DATE]) < coalesce([data].[ALIVE_DATE],'2050-01-01')
                     then dateAdd(month,[data].[DIVISOR],[lastPay].[VALUE_DATE]) end
                end as [PENSION_NEXT_PAY_DATE] --[Дата ближайшей выплаты] -- [lastPay].[VALUE_DATE] + период (не умершие, нет приостановок, не позже даты окончания выплаты пенсии)
                --  в Реестре приостановок выплат
                ,cast([suspendPay].[START_DATE] as date) as  [SUSPEND_PAY_DATE] --[Дата приостановления пенсионных выплат (заполняется, если выплата приостановлена)] 
                ,[data].[PERIOD_PAY_PENSION] --[Периодичность выплаты пенсии]
                ,case when [data].[PERIOD_PENSION]  = N'срочно' then cast([data].[END_DATE_PAY_PENSION] as date)  end as [END_DATE_PENSION_PERIOD] -- [Дата окончания пенсионных выплат (для срочной пенсии)]
                ,
                case 
                      when  [data].[CLASS_SHARER] = N'инвестиционный' and [data].[PERIOD_PAY_PENSION] is not null then 1 
                      else 0 
                end as [TYPE] -- [Тип: 0 -нет, 1-да в сумме остатка, 2 - в фиксированной сумме]	
                ,nullif(0,0) as [FIXED_VALUE] -- [Фиксированная сумма выплаты в случае смерти] --Пустой столбец		
                ,[data].[ACTUARY_RATE] -- [Актуарная ставка, которая применялась при назначении пенсии (АНД)]
                ,[transactionReturn].[VALUE] as [valueReturn] --[Задолженность по выплате пенсий на отчетную дату (возвраты на счетах)]
                
                ,[transactionInpayment1].[VALUE] as [transactionInpaymentValue1] --[Пенсионные взносы в N-1 году, где N - текущий год]
                ,[transactionInpayment2].[VALUE] as [transactionInpaymentValue2] --[Пенсионные взносы в N-2 году, где N - текущий год]
                ,[transactionInpayment3].[VALUE] as [transactionInpaymentValue3] --[Пенсионные взносы в N-3 году, где N - текущий год]
                -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------                
                  -- для расчёта потоков
                  ,case when dateDiff(year,[data].[BIRTH_DATE],@endDate) >  100  then 98 else cast((dateDiff(day,[data].[BIRTH_DATE],@endDate) / 365.25) as int)  end  as [AGE] -- [Возраст]
                  ,
                  case 
                       when [data].[SHARER_TYPE]= N'ЮЛ' then [data].[STATUS_SHARER]
                       when [data].[SHARER_TYPE]= N'ФЛ' then
                                                                                                         case 
                                                                                                          when dateDiff(year,[data].[BIRTH_DATE],@endDate) > 100 then N'ПР'  
                                                                                                          when [data].[STATUS_SHARER]= N'ПО' then N'ПР'
                                                                                                          when [data].[STATUS_SHARER]= N'Прочие' then N'ПР'
                                                                                                          when [data].[STATUS_SHARER]= N'СМ' then N'ПР'
                                                                                                          when [data].[STATUS_SHARER]= N'ВС' then N'ПР'
                                                                                                          when [data].[STATUS_SHARER]= N'ИД' then N'ПР'
                                                                                                          when [data].[PENSION_COUNT] is not null and [data].[PERIOD_PENSION] = N'срочно' and coalesce([data].[END_DATE_PAY_PENSION],'1950-01-01') <= @endDate then N'ПР'  

                                                                                                          when [data].[STATUS_SHARER]= N'ПВП' and [data].[SHARER_STATUS] in (N'Закрыт',N'ПодготовкаКЗакрытию')  then N'ПР'
                                                                                                          when [data].[STATUS_SHARER]= N'ПВП' and [data].[SHARER_STATUS] not in (N'Закрыт',N'ПодготовкаКЗакрытию') then N'ПВ'
                                                                                                          
                                                                                                          when [data].[STATUS_SHARER]= N'ВПН' then N'НП'
                                                                                                          when [data].[STATUS_SHARER]= N'НП' then N'НП'
                                                                                                          when [data].[STATUS_SHARER]= N'ПВ' then N'ПВ'
                                                                                                          else N'ПР'
                                                                                                          end
                  end as  [TYPE_GROUP] -- [Группа по виду обязательств]
                  ,   
                  cast(
                          case 
                          when coalesce([data].[CLASS_SHARER],N'') = N'инвестиционный' then 1 
                          when coalesce([data].[CLASS_SHARER],'') = N'страховой' then 2 
                          end as integer )  as [CONTRACT_TYPE] -- [Группа по типу договора]
                 ,[data].[PENSION_COUNT] -- [Количество выплат пенсии в год]
                 ,[data].[END_DATE_PAY_PENSION] -- [Дата окончания выплаты пенсии]
                 
                 , nullif('','') as [SCHEME_NUMBER] --[Группа по пенсионной схеме]
                 ,nullif(-1,-1) as [id_scriptTariffPension]
                 , nullif('','') as [SCRIPT_TARIFF] --[Тариф для расчёта пенсии]
                 
                ,@startDate as [startDate]
                ,@endDate as [endDate]
                ,getDate() as [getDate]
                
               ,[data].[SHARER_TYPE]  --N'ФЛ',N'ЮЛ'
           
                ,[inpaymentFirst].[VALUE] as [valueInpaymentFirst]             
                ,
                case when  [data].[ACCOUNT_TYPE] = N'ИПС' and [data].[START_DATE_PENSION] is not null then  
                          case 
                          when not ( [data].[balanceByPensionDayPlus1]= 0 and  [data].[balanceByPensionDay] = 0 )  then 
                                                case 
                                                when [data].[balanceByPensionDayPlus1] >= [data].[balanceByPensionDay]
                                                then  [data].[balanceByPensionDayPlus1]
                                                when [data].[balanceByPensionDayPlus1] < [data].[balanceByPensionDay]
                                                then  [data].[balanceByPensionDay]
                                                end
                          else 
                                                case 
                                                when [data].[balanceByPensionStartPayDay] >= [data].[balanceByPensionStartPayDayPlus1]
                                                then  [data].[balanceByPensionStartPayDay]
                                                when [data].[balanceByPensionStartPayDay] < [data].[balanceByPensionStartPayDayPlus1]
                                                then  [data].[balanceByPensionStartPayDayPlus1]
                                                end
                          end
                end as [balanceByPensionStart]

       ,[data].[FUND_SOURCE]
                
