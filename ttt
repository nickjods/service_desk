                  left join --[project_xbrl].[npo].[transactionInpayment] (@startDate,@endDate) 
                  #transactionInpayment as [transactionInpayment] on [transactionInpayment].[ID_SHARER] = [sharer].[ID_SHARER]
                  left join --[project_xbrl].[npo].[transactionIncome] (@startDate,@endDate) 
                  #transactionIncome as [transactionIncome] on [transactionIncome].[ID_SHARER] = [sharer].[ID_SHARER]
                  left join --[project_xbrl].[npo].[transactionPension] (@startDate,@endDate) 
                  #transactionPension as [transactionPension] on [transactionPension].[ID_SHARER] = [sharer].[ID_SHARER]
                  left join --[project_xbrl].[npo].[transactionTransfer] (@startDate,@endDate) 
                  #transactionTransfer as [transactionTransfer] on [transactionTransfer].[ID_SHARER] = [sharer].[ID_SHARER]
                  left join --[project_xbrl].[npo].[transactionAssignee] (@startDate,@endDate) 
                  #transactionAssignee as [transactionAssignee] on [transactionAssignee].[ID_SHARER] = [sharer].[ID_SHARER]
                  left join --[project_xbrl].[npo].[transactionMergeAccount] (@startDate,@endDate) 
                  #transactionMergeAccount as [transactionMergeAccount] on [transactionMergeAccount].[ID_SHARER] = [sharer].[ID_SHARER]
                  left join --[project_xbrl].[npo].[transactionOtherTransfer](@startDate,@endDate) 
                  #transactionOtherTransfer as [transactionOtherTransfer]	on [transactionOtherTransfer].[ID_SHARER] = [sharer].[ID_SHARER]
                  left join --[project_xbrl].[npo].[balanceDate](@endDate) 
