ALTER PROCEDURE  [REPORT].[actuaryNPO_msfo17PR] (@startDate date, @endDate date)
AS
BEGIN TRY
      ------------------------------------------------------------------------------------------------------------------
      -- АФ НПО ФЛ и ЮЛ расширенная для МСФО 17
      ------------------------------------------------------------------------------------------------------------------    
      set nocount on;           

       if object_id('tempdb..#sharer') is not null drop table #sharer;               
       select * into #sharer from [project_xbrl].[npo].[registrSharerDate] (@endDate) ;
       create index [IDX_sharer] on #sharer ([ID_SHARER],[ID_CONTRACT]);

       if object_id('tempdb..#contract') is not null drop table #contract;               
       select * into #contract from [project_xbrl].[npo].[registrContract] () ;
       create index [IDX_contract] on #contract ([ID_CONTRACT]);
       
       if object_id('tempdb..#natural') is not null drop table #natural;               
       select * into #natural from [project_xbrl].[npo].[natural] () ;
       create index [IDX_natural] on #natural ([ID_PERSON]);
    
       if object_id('tempdb..#statusSharerEffective') is not null drop table #statusSharerEffective;               
       select * into #statusSharerEffective from [project_xbrl].[npo].[statusSharerEffectiveDate] (@endDate) ;
       create index [IDX_statusSharerEffective] on #statusSharerEffective ([ID_SHARER]);

       if object_id('tempdb..#statusPaySharer') is not null drop table #statusPaySharer;               
       select * into #statusPaySharer from [project_xbrl].[npo].[statusPaySharer] (@endDate) ;
       create index [IDX_statusPaySharer] on #statusPaySharer ([ID_SHARER]);

       if object_id('tempdb..#sharerAnnuity') is not null drop table #sharerAnnuity;               
       select * into #sharerAnnuity from [project_xbrl].[npo].[sharerAnnuityDate] (@endDate) ;
       create index [IDX_sharerAnnuity] on #sharerAnnuity ([ID_SHARER]);

       if object_id('tempdb..#registrPension') is not null drop table #registrPension;               
       select * into #registrPension from [project_xbrl].[npo].[registrPensionDate] (@endDate) ;
       create index [IDX_registrPension] on #registrPension ([ID_SHARER]);

       if object_id('tempdb..#classSharer') is not null drop table #classSharer;               
       select * into #classSharer from [project_xbrl].[npo].[classSharerDate] (@endDate) ;
       create index [IDX_classSharer] on #classSharer ([ID_SHARER]);

       if object_id('tempdb..#classSharerBefore') is not null drop table #classSharerBefore;               
       select * into #classSharerBefore from [project_xbrl].[npo].[classSharerDate] (dateAdd(day,-1,@startDate)) ;
       create index [IDX_classSharerBefore] on #classSharerBefore ([ID_SHARER]);

       if object_id('tempdb..#statusContractDate') is not null drop table #statusContractDate;               
       select * into #statusContractDate from [project_xbrl].[npo].[statusContractDate] (@endDate) ;
       create index [statusContractDate] on #statusContractDate ([ID_CONTRACT]);

       if object_id('tempdb..#statusSharerDate') is not null drop table #statusSharerDate;               
       select * into #statusSharerDate from [project_xbrl].[npo].[statusSharerDate](@endDate)  ;
       create index [statusSharerDate] on #statusSharerDate ([ID_SHARER]);
             
       if object_id('tempdb..#balanceEnd') is not null drop table #balanceEnd;               
       select * into #balanceEnd from  [project_xbrl].[npo].[balanceDate](@endDate) ;
       create index [balanceEnd] on #balanceEnd ([ID_SHARER]);
             
       if object_id('tempdb..#balanceEndContract') is not null drop table #balanceEndContract;               
       select sum([balanceEnd].[VALUE]) as [VALUE], [sharer].[ID_CONTRACT]
       into #balanceEndContract
       from #sharer --[project_xbrl].[npo].[registrSharerDate] (@endDate) 
                       as [sharer]
                                join --[project_xbrl].[npo].[registrContract]() 
                                #contract as [contract] on [sharer].[ID_CONTRACT] = [contract].[ID_CONTRACT] and [contract].[TYPE_INVESTOR] = N'ЮЛ'
                                join --[project_xbrl].[npo].[statusContractDate] (@endDate)  
                                #statusContractDate as [statusContract] on [statusContract].[ID_CONTRACT] = [contract].[ID_CONTRACT]
                                and [statusContract].[NAME_STATUS] in ( N'Заключен',N'Действует') --договор «Прекращен», то вкладчик уже не может получить ВС и обязательства будут = 0
                                join --[project_xbrl].[npo].[balanceDate](@endDate) 
                                #balanceEnd as [balanceEnd] on [balanceEnd].[ID_SHARER] = [sharer].[ID_SHARER]
                                left join --[project_xbrl].[npo].[registrPensionDate] (@endDate) 
                                #registrPension as [pension] on [pension].[ID_SHARER] = [sharer].[ID_SHARER]
       where [sharer].[ACCOUNT_TYPE] = N'ИПС'
       and coalesce([sharer].[BALANCE_ACCUM_INVESTOR],0) = 1 --РасторжениеВПериодНакВкладчиком 
       and [pension].[ID_SHARER] is null --пенсия не назначена
                             and [contract].[TYPE_INVESTOR] = N'ЮЛ'
                             and [sharer].[SHARER_TYPE] = N'ФЛ'
                             and [statusContract].[NAME_STATUS] in ( N'Заключен',N'Действует')  --договор «Прекращен», то вкладчик уже не может получить ВС и обязательства будут = 0
       group by [sharer].[ID_CONTRACT];
       create index [balanceEndContract] on #balanceEndContract ([ID_CONTRACT]);
       
       if object_id('tempdb..#balanceStart') is not null drop table #balanceStart;               
       select * into #balanceStart from [project_xbrl].[npo].[balanceDate](dateAdd(day,-1,@startDate));
       create index [balanceStart] on #balanceStart ([ID_SHARER]);

       if object_id('tempdb..#transactionInpayment') is not null drop table #transactionInpayment;               
       select * into #transactionInpayment from [project_xbrl].[npo].[transactionInpayment] (@startDate,@endDate);
       create index [transactionInpayment] on #transactionInpayment ([ID_SHARER]);

       if object_id('tempdb..#transactionTransferDate') is not null drop table #transactionTransferDate;               
       select * into #transactionTransferDate from [project_xbrl].[npo].[transactionTransferDate](@endDate) ;
       create index [transactionTransferDate] on #transactionTransferDate ([ID_SHARER]);
       
       if object_id('tempdb..#transactionIncome') is not null drop table #transactionIncome;               
       select * into #transactionIncome from  [project_xbrl].[npo].[transactionIncome] (@startDate,@endDate);
       create index [transactionIncome] on #transactionIncome ([ID_SHARER]);

       if object_id('tempdb..#transactionPension') is not null drop table #transactionPension;               
       select * into #transactionPension from  [project_xbrl].[npo].[transactionPension] (@startDate,@endDate);
       create index [transactionPension] on #transactionPension ([ID_SHARER]);

       if object_id('tempdb..#transactionTransfer') is not null drop table #transactionTransfer;               
       select * into #transactionTransfer from [project_xbrl].[npo].[transactionTransfer] (@startDate,@endDate) ;
       create index [transactionTransfer] on #transactionTransfer ([ID_SHARER]);

       if object_id('tempdb..#transactionAssignee') is not null drop table #transactionAssignee;               
       select * into #transactionAssignee from  [project_xbrl].[npo].[transactionAssignee] (@startDate,@endDate) ;
       create index [transactionAssignee] on #transactionAssignee ([ID_SHARER]);

       if object_id('tempdb..#transactionMergeAccount') is not null drop table #transactionMergeAccount;               
       select * into #transactionMergeAccount from  [project_xbrl].[npo].[transactionMergeAccount] (@startDate,@endDate) ;
       create index [transactionMergeAccount] on #transactionMergeAccount ([ID_SHARER]);

       if object_id('tempdb..#transactionOtherTransfer') is not null drop table #transactionOtherTransfer;               
       select * into #transactionOtherTransfer from [project_xbrl].[npo].[transactionOtherTransfer](@startDate,@endDate);
       create index [transactionOtherTransfer] on #transactionOtherTransfer ([ID_SHARER]);

         ----------------------------------------------------------------------------------------------------------------------------------
         if object_id('tempdb..#data') is not null drop table #data;    

          select distinct  
           [sharer].[ID_SHARER] 
          ,[contract].[CODE] as [CODE_CONTRACT]
          ,[sharer].[CODE_SHARER]
          ,[sharer].[CODE] as [CODE]
          ,[contract].[SELFNUMBER] as	[SELFNUMBER_CONTRACT]
          ,[sharer].[SELFNUMBER] as [SELFNUMBER_SHARER]
          ,[contract].[SIGN_DATE]	as [SIGN_DATE]
          ,[statusSharerEffective].[VALUE_DATE] as [EFFECTIVE_DATE]
          ,coalesce([juridical].[FULLNAME], N'фл')	as [NAME_INVESTOR]
          
          ,case when [sharer].[SHARER_TYPE] = N'ФЛ' then coalesce([natural].[BIRTH_DATE],'1901-01-01') end as [BIRTH_DATE]
          
          ,[contract].[FUND]
          
          ,coalesce([natural].[SEX],N' ') as [SEX]
          ,[sharer].[ACCOUNT_TYPE] as [ACCOUNT_TYPE]  
          ,
          case 
                when [contract].[TYPE_INVESTOR] = N'ЮЛ' then N'СЧ' 
                when [contract].[TYPE_INVESTOR] = N'ФЛ'and [sharer].[ID_PERSON] != [contract].[ID_PERSON_INVESTOR] then N'БЧ' 
                else N'ИЧ' 
          end as [ACCOUNT_PART_TYPE] --КатегорияСчета (ИЧ, СЧ, БЧ)  ИЧ = пусто, СЧ = 1 или БЧ = 2 (ФЛ в пользу третьих лиц)
          ,[classSharer].[VALUE] as [CLASS_SHARER]
          ,[classSharerBefore].[VALUE] as [CLASS_SHARER_BEFORE]
          ,[sharer].[OUD]
          
          ,
           case 
              --------------------------------------------------------------------------------------------
              when [status].[NAME_STATUS] in (N'Закрыт',N'ПодготовкаКЗакрытию') and 
                   [transactionTransferAll].[ID_SHARER] is not null
              then nullif(getDate(),getDate()) --N'ВС' --выкупная
              --------------------------------------------------------------------------------------------
              when coalesce([countPaySharer].[LAST_DATE_PAY],'2050-01-01') between @startDate and @endDate
                   and coalesce([countPaySharer].[VALUE_END],-1) = 0
                   and [status].[NAME_STATUS] in (N'Закрыт')
              then nullif(getDate(),getDate()) --N'ИД' --пенсия выплачена
              --------------------------------------------------------------------------------------------
              when [status].[NAME_STATUS] in (N'Закрыт',N'ПодготовкаКЗакрытию') and 
                   [alive].[ID_PERSON] is not null and [natural].[DEATH_DATE] is not null
              then [natural].[DEATH_DATE] 
           end as [ALIVE_DATE]
              ,
--      case 
--      when [sharer].[SHARER_TYPE] = N'ЮЛ'
--      then [contract].[SCHEME_CONTRACT]	
--      when [sharer].[SHARER_TYPE] = N'ФЛ' 
--      then coalesce([sharer].[SCHEME_CONTRACT],[contract].[SCHEME_CONTRACT])	
--      end 
      [indexScheme].[npo_index_sheme] as [SCHEMA_CONTRACT]	
          
          ,--coalesce([sharer].[SCHEME_NAME],[contract].[SCHEME_NAME]) 
          case when [sharer].[SCHEME_CONTRACT] like '%_П%' then [sharer].[SCHEME_CONTRACT] else concat([sharer].[SCHEME_CONTRACT],'_', [contract].[scheme258]) end 
          as [SCHEME_NAME]
         ,[sharer].[portfolioInvest]

          ,
         case
             when [sharer].[SHARER_TYPE] = N'ЮЛ'
             then 
                         case 
                                 when [status].[NAME_STATUS] in (N'Открыт',N'Действует')
                                 then N'НП'
                                 when [status].[NAME_STATUS] = N'ПериодВыплат'
                                 then N'ПВ'
                                 else N'ПР'
                         end
              when [sharer].[SHARER_TYPE] = N'ФЛ'
              then
                    case
                              when [status].[NAME_STATUS] in (N'Закрыт',N'ПодготовкаКЗакрытию') and 
                                   [transactionTransferAll].[ID_SHARER] is not null
                              then N'ВС' --/выкупная'
                              when coalesce([countPaySharer].[LAST_DATE_PAY],'2050-01-01') between @startDate and @endDate
                                   and coalesce([countPaySharer].[VALUE_END],-1) = 0
                                   and [status].[NAME_STATUS] in (N'Закрыт')
                              then N'ИД' --/пенсия выплачена'
                              when [status].[NAME_STATUS] in (N'Закрыт',N'ПодготовкаКЗакрытию') and 
                                   [alive].[ID_PERSON] is not null and [natural].[DEATH_DATE] is not null
                              then N'СМ'
                              --если дата рождения = пусто или 01.01.1901, то статус = прочие
                              when coalesce([natural].[BIRTH_DATE],'1901-01-01') = '1901-01-01'
                              then N'прочие'   

                              when  [pension].[ID_SHARER] is not null and [suspendPay].[START_DATE] is not null
                              then N'ПВП'
                              
                              when [status].[NAME_STATUS] = N'ПодготовкаКЗакрытию'
                              and [applicationCloseInvestor].[ID_SHARER] is not null --в отчетном периоде поступило Заявление на расторжение
                              and [transactionTransfer].[ID_SHARER] is null --но выкупная не выплачена
                              and [pension].[ID_SHARER] is not null
                              then N'ПВ' --/есть деньги на резерве выплат'
                              when [status].[NAME_STATUS] = N'ПодготовкаКЗакрытию'
                              and [statusPay].[NAME]  =  N'Этап выплат' 
                              and coalesce([balanceEnd].[VALUE],0) <> 0
                              then N'ПВ' --/есть деньги на резерве выплат'
                              when [status].[NAME_STATUS] = N'ПериодВыплат'
                              then N'ПВ' --/есть деньги на резерве выплат'
                              when 
                                   case 
                                         when [natural].[SEX] = N'ж' and [contract].[SIGN_DATE] < '2019-01-01'
                                         then dateAdd(year,55,[natural].[BIRTH_DATE]) 
                                         when [natural].[SEX] = N'м' and [contract].[SIGN_DATE] < '2019-01-01'
                                         then dateAdd(year,60,[natural].[BIRTH_DATE])
                                         
                                         when [natural].[SEX] = N'ж' and [contract].[SIGN_DATE] >= '2019-01-01'
                                         then dateAdd(month,6,dateAdd(year,55,[natural].[BIRTH_DATE]))
                                         when [natural].[SEX] = N'м' and [contract].[SIGN_DATE] >= '2019-01-01'
                                         then dateAdd(month,6,dateAdd(year,60,[natural].[BIRTH_DATE]))
                                   end
                                      <= @endDate 
                              and [status].[NAME_STATUS] in (N'Открыт',N'Действует') --[pension].[ID_SHARER] is null
                              then N'ВПН' --/пенсионные основания наступили, но пенсия не назначена'
                              when 
                                   case 
                                             when [natural].[SEX] = N'ж' and [contract].[SIGN_DATE] < '2019-01-01'
                                             then dateAdd(year,55,[natural].[BIRTH_DATE]) 
                                             when [natural].[SEX] = N'м' and [contract].[SIGN_DATE] < '2019-01-01'
                                             then dateAdd(year,60,[natural].[BIRTH_DATE])
                                             
                                             when [natural].[SEX] = N'ж' and [contract].[SIGN_DATE] >= '2019-01-01'
                                             then dateAdd(month,6,dateAdd(year,55,[natural].[BIRTH_DATE]))
                                             when [natural].[SEX] = N'м' and [contract].[SIGN_DATE] >= '2019-01-01'
                                             then dateAdd(month,6,dateAdd(year,60,[natural].[BIRTH_DATE]))
                                   end
                                         <= @endDate 
                                          and [status].[NAME_STATUS] = N'ПодготовкаКЗакрытию' 
                                          and [applicationCloseInvestor].[ID_SHARER] is not null --в отчетном периоде поступило Заявление на расторжение
                                          and [transactionTransfer].[ID_SHARER] is null --но выкупная не выплачена
                                          and [pension].[ID_SHARER] is null
                              then N'ВПН' --/пенсионные основания наступили, но пенсия не назначена'
                              when [status].[NAME_STATUS] in (N'Открыт',N'Действует')
                              then N'НП' --/накопительный период'
                              when [status].[NAME_STATUS] = N'ПодготовкаКЗакрытию'
                              and [applicationCloseInvestor].[ID_SHARER] is not null --в отчетном периоде поступило Заявление на расторжение
                              and [transactionTransfer].[ID_SHARER] is null --но выкупная не выплачена
                              and [pension].[ID_SHARER] is null
                              then N'НП' --/накопительный период'
                              when [sharer].[SHARER_TYPE] = N'ФЛ'
                              then N'прочие'
                              else N'-' 
                    end
                    else N'-' 
           end as [STATUS_SHARER]
           ,case when [sharer].[SHARER_TYPE] = N'ФЛ' then coalesce([sharer].[MGD],[sharer].[MGD_PAY],[contract].[MGD],[contract].[MGD_PAY],0) else coalesce([contract].[MGD],[contract].[MGD_PAY],0) end as [VALUE_INCOME]
            ,
            case
                  when [contract].[TYPE_INVESTOR] = N'ЮЛ' then N'другой период (указать)'
                  when [contract].[TYPE_INVESTOR] = N'ФЛ' and [sharer].[SHARER_TYPE] = N'ФЛ'
                  then 
                       case 
                              --если оба заполнены  или оба равны нулю  – «период действия пенсионного договора»
                             when coalesce([contract].[MGD],0) >= 0
                             and coalesce([contract].[MGD_PAY],0) >= 0
                             then N'период действия пенсионного договора'
                             --Если отличное от 0 значение только в графе МГД в нак. период – значение «период накопления»
                             when coalesce([contract].[MGD],0) > 0
                             and coalesce([contract].[MGD_PAY],0) = 0
                             then N'период накопления'
                             --если в графе МГД в вып. период – «период выплат»
                             when coalesce([contract].[MGD_PAY],0) > 0
                             and coalesce([contract].[MGD],0) = 0
                             then N'период выплат'
                             else N'период действия пенсионного договора'
                       end 
             end as [PERIOD_INCOME]
            ,
            case 
            when [sharer].[SHARER_TYPE] = N'ЮЛ' 
                 and coalesce([contract].[ASSIGNEE_PAY],0) = 1 --[Наследование в период выплат]
                 and coalesce([contract].[ASSIGNEE_ACCUM],0) = 1 --[Наследование в период накопления]
            then N'полное'
            when [sharer].[SHARER_TYPE] = N'ЮЛ' 
                 and coalesce([contract].[ASSIGNEE_PAY],0) = 0 --[Наследование в период выплат]
                 and coalesce([contract].[ASSIGNEE_ACCUM],0) = 1 --[Наследование в период накопления]
            then N'накопительное' 
            when [sharer].[SHARER_TYPE] = N'ЮЛ' 
                 and coalesce([contract].[ASSIGNEE_PAY],0) = 1 --[Наследование в период выплат]
                 and coalesce([contract].[ASSIGNEE_ACCUM],0) = 0 --[Наследование в период накопления]
            then N'выплатное' 
            when [sharer].[SHARER_TYPE] = N'ЮЛ' 
                 and coalesce([contract].[ASSIGNEE_PAY],0) = 0 --[Наследование в период выплат]
                 and coalesce([contract].[ASSIGNEE_ACCUM],0) = 0 --[Наследование в период накопления]
            then N'нет' 
            when [sharer].[SHARER_TYPE] = N'ФЛ' 
                 and coalesce([sharer].[ASSIGNEE_PAY],0) = 1 --[Наследование в период выплат]
                 and coalesce([sharer].[ASSIGNEE_ACCUM],0) = 1 --[Наследование в период накопления]
            then N'полное'
            when [sharer].[SHARER_TYPE] = N'ФЛ'
                 and coalesce([sharer].[ASSIGNEE_PAY],0) = 0 --[Наследование в период выплат]
                 and coalesce([sharer].[ASSIGNEE_ACCUM],0) = 1 --[Наследование в период накопления]
            then N'накопительное' 
            when [sharer].[SHARER_TYPE] = N'ФЛ'
                 and coalesce([sharer].[ASSIGNEE_PAY],0) = 1 --[Наследование в период выплат]
                 and coalesce([sharer].[ASSIGNEE_ACCUM],0) = 0 --[Наследование в период накопления]
            then N'выплатное' 
            when [sharer].[SHARER_TYPE] = N'ФЛ' 
                 and coalesce([sharer].[ASSIGNEE_PAY],0) = 0 --[Наследование в период выплат]
                 and coalesce([sharer].[ASSIGNEE_ACCUM],0) = 0 --[Наследование в период накопления]
            then N'нет' 
            end as [ASSIGNEE]
            
            ,[sharer].[valueInpayment] as [valueInpaymentContract]
            -- EVO!!!
            ,coalesce([sharerAnnuity].[VALUE] ,[contract].[ACTUARY_RATE])    as [ACTUARY_RATE]

             ,[pension].[START_DATE_FIRST]as	[START_DATE_PENSION]
             ,[pension].[PENSION] as [PENSION]
             ,[pension].[PENSION_TYPE] as [PERIOD_PENSION]


           ,nullif(coalesce([transactionInpayment].[VALUE],0),0)	[INPAYMENT_VALUE]
           ,nullif(coalesce([transactionMergeAccount].[VALUE],0),0)	[MERGE_VALUE]
           ,nullif(coalesce([transactionOtherTransfer].[VALUE],0),0)	[OTHERTRANSFER_VALUE]
           ,nullif(coalesce([transactionPension].[VALUE],0),0)	[PENSION_VALUE]
           ,nullif(coalesce([transactionTransfer].[VALUE],0),0)	[TRANSFER_VALUE]
           ,nullif(coalesce([transactionAssignee].[VALUE],0),0)	[ASSIGNEE_VALUE]
          ,nullif(coalesce([balanceEndSPS].[VALUE],[balanceEnd].[VALUE],0),0)	as [BALANCE_END_VALUE]

         ,nullif(
            case 

            /*назначена пожизненная пенсия по любой схеме, то обязательства по ВС = 0*/
            when [sharer].[SHARER_TYPE] = N'ФЛ' and coalesce([pension].[PENSION_TYPE], N'') = N'пожизненно' then 0

            /*
            накопительный период  
            договор с ЮЛ 
            договор «Прекращен», то вкладчик уже не может получить ВС и обязательства будут = 0
            */
            when [sharer].[SHARER_TYPE] = N'ФЛ'
                  and [status].[NAME_STATUS] in (N'Открыт',N'Действует')
                  and [contract].[TYPE_INVESTOR] = N'ЮЛ'
                  and [statusContract].[NAME_STATUS] = N'Закрыт'
            then 0

            /*
            тип счета СПС 
            вкладчик = участник = ЮЛ, то Обязательства по ВС 
            = 
            Остаток на конец отчетного периода
            + 
            Сумма остатков на конец отчетного периода по всем ПС участников по этому договору, пенсия которым не назначена
            */
            /*Обязательства по ВС < 0, то 0*/
            when [sharer].[ACCOUNT_TYPE] = N'СПС'
                  and [contract].[TYPE_INVESTOR] = N'ЮЛ'
                  and [sharer].[SHARER_TYPE] = N'ЮЛ'
                  and coalesce([balanceEndSPS].[VALUE],[balanceEnd].[VALUE],0) + coalesce([balanceEndContract].[VALUE],0) > 0
            then coalesce([balanceEndSPS].[VALUE],[balanceEnd].[VALUE],0) + coalesce([balanceEndContract].[VALUE],0) 

            /*
            тип счета СПС 
            вкладчик <> участник, то Обязательства по ВС = 0
            */
            when [sharer].[ACCOUNT_TYPE] = N'СПС'
                  and [contract].[TYPE_INVESTOR] = N'ЮЛ'
                  and [sharer].[SHARER_TYPE] = N'ФЛ'
            then 0

            /*
            тип счета ИПС
            пенсия назначена
            "В период выплат Участником" заполнена, то Обязательства по ВС = Остаток на конец отчетного периода, иначе 0. 
            */
            /*Обязательства по ВС < 0, то 0*/
            -----------------------------------------------------------------------------------------
            when coalesce([sharer].[BALANCE_PAY_SHARER],0) = 1 --РасторжениеВПериодВыпУчастником
                  and [sharer].[ACCOUNT_TYPE] = N'ИПС'
                  and [sharer].[SHARER_TYPE] = N'ФЛ'
                  and [pension].[ID_SHARER] is not null
                  and coalesce([balanceEndSPS].[VALUE],[balanceEnd].[VALUE],0) > 0
            then coalesce([balanceEndSPS].[VALUE],[balanceEnd].[VALUE],0)
            /*
            счета ИПС
            пенсия не назначена
            Вкл = Уч = ФЛ
            "В период накопления Вкладчиком" заполнена, то Обязательства по ВС = Остаток на конец отчетного периода 
            У договор с ФЛ, где Вкладчик не равен Участник: № 90452 и № 96298 – обязательства 
            (равные остатку по счету) должны быть только по вкладчику.
            */
            /*Обязательства по ВС < 0, то 0*/
            when coalesce([sharer].[BALANCE_ACCUM_INVESTOR],0) = 1 --РасторжениеВПериодНакВкладчиком
                  and [sharer].[ACCOUNT_TYPE] = N'ИПС'
                  and [sharer].[SHARER_TYPE] = N'ФЛ'
                  and [contract].[TYPE_INVESTOR] = N'ФЛ'
                  --and [status].[NAME_STATUS] in (N'Открыт',N'Действует')
                  and [sharer].[ID_PERSON] = [contract].[ID_PERSON_INVESTOR]
                  and [pension].[ID_SHARER] is null
                  and coalesce([balanceEndSPS].[VALUE],[balanceEnd].[VALUE],0) > 0
            then coalesce([balanceEndSPS].[VALUE],[balanceEnd].[VALUE],0)

            /*
            пенсия не назначена
            Вкл <> Уч
            "В период накопления Вкладчиком" заполнена, то Обязательства по ВС
            = 
            Остаток на конец отчетного периода
            + 
            Сумма остатков на конец отчетного периода по всем ПС участников по этому договору, пенсия которым не назначена
            */
            /*Обязательства по ВС < 0, то 0*/
            when coalesce([sharer].[BALANCE_ACCUM_INVESTOR],0) = 1 --РасторжениеВПериодНакВкладчиком
                  and [sharer].[ACCOUNT_TYPE] = N'ИПС'
                  and [sharer].[SHARER_TYPE] = N'ЮЛ'
                  and [contract].[TYPE_INVESTOR] = N'ЮЛ'
                  and coalesce([balanceEndSPS].[VALUE],[balanceEnd].[VALUE],0) + coalesce([balanceEndContract].[VALUE],0) > 0
            then coalesce([balanceEndSPS].[VALUE],[balanceEnd].[VALUE],0) + coalesce([balanceEndContract].[VALUE],0)

            /*Обязательства по ВС < 0, то 0*/
            else 0
            end,0) as [BALANCE_TRANSFER]
            
          ,case when [sharer].[SHARER_TYPE] = N'ФЛ'  then [sharer].[REGISTR_DATE] end as [REGISTR_DATE] -- [Дата открытия пенсионного счета (только для ИПС)]
          
                 ,[pension].[PENSION_COUNT] as [PENSION_COUNT] -- [Количество выплат пенсии в год]
                 ,[pension].[END_DATE_PAY] as [END_DATE_PAY_PENSION] -- [Дата окончания выплаты пенсии]
                 ,[pension].[DIVISOR]
                 ,[pension].[PERIOD] as [PERIOD_PAY_PENSION]
                 
                 ,[sharer].[SHARER_TYPE]  --N'ФЛ',N'ЮЛ'
                 
                 ,[balanceByPensionStart].[VALUE] as [balanceByPensionDay]
                 ,[balanceByPensionStart0].[VALUE] as [balanceByPensionDayPlus1]
                 
                 ,[balanceByPensionStartPayDay].[VALUE] as [balanceByPensionStartPayDay] 
                 ,[balanceByPensionStartPay].[VALUE] as [balanceByPensionStartPayDayPlus1]                  
                 ,[sharer].[FUND_SOURCE]
                 
                 ,[status].[NAME_STATUS] as [SHARER_STATUS] --[Статус на конец периода]

          into #data
          from --[project_xbrl].[npo].[registrSharerDate](@endDate) 
                   #sharer as [sharer]	
                  join --[project_xbrl].[npo].[registrContract]() 
                  #contract as [contract] on [sharer].[ID_CONTRACT] = [contract].[ID_CONTRACT]
                  join --[project_xbrl].[npo].[statusSharerDate](@endDate) 
                  #statusSharerDate as [status] on [status].[ID_SHARER] = [sharer].[ID_SHARER]
                  join --[project_xbrl].[npo].[statusContractDate](@endDate) 
                  #statusContractDate as [statusContract] on [statusContract].[ID_CONTRACT] = [sharer].[ID_CONTRACT]
                  
                  left join [DWH].[npf].[npo_pension_scheme]  as [scheme] on [sharer].[ID_SCHEME] = [scheme].[npo_pension_scheme_id]
                  left join [DWH].[npf].[npo_scheme] as [indexScheme] on [scheme].[npo_scheme_id] = [indexScheme].[npo_scheme_id]

                  left join --[project_xbrl].[npo].[statusSharerEffectiveDate] (@endDate) 
                  #statusSharerEffective as [statusSharerEffective] on [statusSharerEffective].[ID_SHARER] = [sharer].[ID_SHARER]
                  left join -- [project_xbrl].[npo].[sharerAnnuityDate](@endDate) 
