                left join [project_xbrl].[npo].[transactionInpayment] (dateAdd(year,-2,@startDate),dateAdd(year,-1,(dateAdd(day,-1,@startDate)))) as [transactionInpayment2] on [transactionInpayment2].[ID_SHARER] = [data].[ID_SHARER]
                left join [project_xbrl].[npo].[transactionInpayment] (dateAdd(year,-3,@startDate),dateAdd(year,-2,(dateAdd(day,-1,@startDate)))) as [transactionInpayment3] on [transactionInpayment3].[ID_SHARER] = [data].[ID_SHARER]

                left join [project_xbrl].[npo].[suspendPay] (@endDate) as [suspendPay] on [data].[ID_SHARER] = [suspendPay].[ID_SHARER]
                left join [project_xbrl].[npo].[lastPayPension](@endDate) as [lastPay] on [lastPay].[ID_SHARER] = [data].[ID_SHARER]
                
                left join (
                              select [transaction].[ID_SHARER], sum([transaction].[VALUE]) as [VALUE]
                              from [project_xbrl].[npo].[transaction]() as [transaction]
                              where [transaction]. [CODE_OPERATION] in (33	/*Возврат пенсий*/ ,34	/*Возврат НДФЛ с пенсий */  )                
                              and [transaction].[VALUE_DATE] <= @endDate                                        
                              group by [transaction].[ID_SHARER]                                                                    
                               ) as [transactionReturn] on  [data].[ID_SHARER] = [transactionReturn].[ID_SHARER]
                
       option( recompile);
     
