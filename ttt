select t.id, t.value, t.effective_date, at2.mnemonics
from ourpension.sharer s
left join back_office.account a on a.owner_sharer_id = s.id
left join back_office.account a1 on a1.owner_individual_id = s.individual_id
left join back_office.account_type at2 on at2.id = a.account_type_id or at2.id = a1.account_type_id
join back_office.transaction t on t.credit_account_id = a.id or t.debit_account_id = a1.id
where s."number" =
order by t.effective_date desc
