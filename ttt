CREATE OR REPLACE FUNCTION actuary.get_balance_by_pension_scheme(p_start_date date, p_end_date date, p_service_type text)
 RETURNS TABLE(date date, scheme_contract text, portfolioinvest text, balancevalue numeric, account_type text, sharer_type text)
 LANGUAGE plpgsql
AS $function$
	declare
		v_started_at timestamptz;
		v_rows bigint;

	begin
		if p_start_date is null or p_end_date is null then
			raise exception 'Inputs dates is NULL';
		end if;

		v_started_at := clock_timestamp();
		create temp table tmp_gbbps_balance on commit drop as
		with fl_owners as (
			select
				s.id as sharer_id,
				c.id as contract_id
			from ourpension.sharer s
			join ourpension.contract c on c.id = s.contract_id
			where s.individual_id is not null
				and c.service_type = p_service_type
		),
		ul_contracts as (
			select
				c.id as contract_id
			from ourpension.contract c
			where c.service_type = p_service_type
				and exists (
					select 1
					from ourpension.sharer s
					where s.contract_id = c.id and s.individual_id is null
				)
		)
		select
			fl.sharer_id as owner_sharer_id,
			fl.contract_id as fl_contract_id,
			ul.contract_id as owner_contract_id,
			b.start_date,
			b.end_date,
			b.total_credit - b.total_debit as amount
		from back_office.balance b
		join back_office.account a on a.id = b.account_id
		left join fl_owners fl on fl.sharer_id = a.owner_sharer_id
		left join ul_contracts ul on ul.contract_id = a.owner_contract_id
		where b.start_date <= p_end_date
			and b.end_date >= p_start_date
			and (fl.sharer_id is not null or ul.contract_id is not null);

		get diagnostics v_rows = row_count;
		analyze pg_temp.tmp_gbbps_balance;
		raise notice 'Загрузка баланса: % строк, %', v_rows, clock_timestamp() - v_started_at;

		v_started_at := clock_timestamp();

		-- История назначений. При нескольких записях за день берем последнюю.
		-- Для ЮЛ владельцем баланса служит договор. Для ФЛ — счет участника.
		create temp table tmp_gbbps_product on commit drop as
		with history as (
			select
				false as is_ul,
				h.sharer_id as owner_id,
				h.begin_date,
				h.end_date,
				h.pens_product_id as product_id,
				h.id as event_id
			from ourpension.sharer_product_history h
			join (select distinct b.owner_sharer_id from pg_temp.tmp_gbbps_balance b
					where b.owner_sharer_id is not null) o on o.owner_sharer_id = h.sharer_id
			where h.begin_date < p_end_date + 1

			union all

			select
				true,
				h.contract_id,
				h.begin_date,
				h.end_date,
				h.pens_product_id,
				h.id
			from ourpension.contract_product_history h
			join (select distinct b.owner_contract_id from pg_temp.tmp_gbbps_balance b
					where b.owner_contract_id is not null) o on o.owner_contract_id = h.contract_id
			where h.begin_date < p_end_date + 1
		),
		last_in_day as (
			select distinct on (h.is_ul, h.owner_id, h.begin_date::date)
				h.is_ul,
				h.owner_id,
				h.begin_date::date as dt,
				h.end_date,
				h.product_id
			from history h
			order by h.is_ul, h.owner_id, h.begin_date::date, h.begin_date desc, h.event_id desc
		),
		periods as (
			select
				h.*,
				lead(h.dt) over (partition by h.is_ul, h.owner_id order by h.dt) as next_dt
			from last_in_day h
		)
		select
			h.is_ul,
			h.owner_id,
			greatest(h.dt, p_start_date) as dt_from,
			least(h.next_dt, h.end_date::date, p_end_date + 1) as dt_until,
			pp.name::text as product_name
		from periods h
		left join prod_line.pens_product pp on pp.id = h.product_id
		where greatest(h.dt, p_start_date) < least(h.next_dt, h.end_date::date, p_end_date + 1);

		create index on tmp_gbbps_product (is_ul, owner_id, dt_from);
		analyze pg_temp.tmp_gbbps_product;
		raise notice 'История продуктов: %', clock_timestamp() - v_started_at;
		v_started_at := clock_timestamp();

		return query
			with balances as (
				select
					x.is_ul,
					x.owner_id,
					b.start_date,
					b.end_date,
					b.amount
				from pg_temp.tmp_gbbps_balance b
				cross join lateral (values
					(false, b.owner_sharer_id), (true, b.owner_contract_id)
				) x(is_ul, owner_id)
				where x.owner_id is not null
			),
			events as (
				select
					b.is_ul,
					b.owner_id,
					e.dt,
					sum(e.delta) as delta
				from balances b
				cross join lateral (values
					(greatest(b.start_date, p_start_date), b.amount),
					(case when b.end_date < p_end_date then b.end_date + 1 end, -b.amount)
				) e(dt, delta)
				where e.dt is not null
				group by b.is_ul, b.owner_id, e.dt
			),
			owner_balance as (
				select
					e.is_ul,
					e.owner_id,
					e.dt as dt_from,
					lead(e.dt, 1, p_end_date + 1) over w as dt_until,
					(sum(e.delta) over w)::numeric(35,2) as amount
				from events e
				window w as (partition by e.is_ul, e.owner_id order by e.dt)
			),
			-- Начисляем весь баланс в группу NULL. На период известного продукта
			-- переносим соответствующую сумму из NULL в группу продукта.
			segments as (
				select
					null::text as product_name,
					b.dt_from,
					b.dt_until,
					b.amount
				from owner_balance b
				where b.amount <> 0

				union all

				select
					v.product_name,
					greatest(b.dt_from, p.dt_from),
					least(b.dt_until, p.dt_until),
					v.amount
				from owner_balance b
				join pg_temp.tmp_gbbps_product p
					on p.is_ul = b.is_ul and p.owner_id = b.owner_id
				and p.dt_from < b.dt_until and b.dt_from < p.dt_until
				cross join lateral (values (p.product_name, b.amount), (null::text, -b.amount))
					v(product_name, amount)
				where p.product_name is not null and b.amount <> 0
			),
			product_events as (
				select
					s.product_name,
					e.dt,
					sum(e.delta) as delta
				from segments s
				cross join lateral (values (s.dt_from, s.amount), (s.dt_until, -s.amount))
					e(dt, delta)
				where e.dt <= p_end_date
				group by s.product_name, e.dt
			),
			totals as (
				select
					e.product_name,
					e.dt,
					lead(e.dt, 1, p_end_date + 1) over w as dt_until,
					sum(e.delta) over w as amount
				from product_events e
				window w as (partition by e.product_name order by e.dt)
			)
			select
				t.dt + d.n,
				t.product_name,
				null::text,
				t.amount,
				null::text,
				null::text
			from totals t
			cross join lateral generate_series(0, t.dt_until - t.dt - 1) d(n)
			where t.amount <> 0
			order by 1, 2;

		raise notice 'Расчет по дням: %', clock_timestamp() - v_started_at;
		drop table pg_temp.tmp_gbbps_product, pg_temp.tmp_gbbps_balance;
	end;
$function$;
