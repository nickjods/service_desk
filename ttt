"CREATE FUNCTION [npo].[transactionAssignee] (@startDate date, @endDate date)
RETURNS TABLE
RETURN (
----------------------------------------------------------------------------------
--Выплаты правопреемникам
----------------------------------------------------------------------------------
select 
[transaction].[ID_SHARER]
,
sum(
case
when [sharer].[ACCOUNT_TYPE] = N'ИПС' and [sharer].[SHARER_TYPE] = N'ФЛ'
then 
     case when [transaction].[CODE_OPERATION] in (
                                                                                    20	--Выплата унаследованных сумм
                                                                                   ,50 --Выплата унаследованных сумм - дополнительная выплата
                                                                                   ,21	--Подоходный налог с унаследованной суммы
                                                                                   )
      then [transaction].[VALUE]
      else - [transaction].[VALUE]
      end
when [sharer].[ACCOUNT_TYPE] = N'СПС' and [sharer].[SHARER_TYPE] = N'ЮЛ'
then 
     case when [transaction].[CODE_OPERATION] in (
                                                                                    20	--Выплата унаследованных сумм
                                                                                   ,50 --Выплата унаследованных сумм - дополнительная выплата
                                                                                   ,21	--Подоходный налог с унаследованной суммы
                                                                                   )
      then [transaction].[VALUE]
      else - [transaction].[VALUE]
      end
else 0    
end) 
as [VALUE]
from [project_xbrl].[npo].[transaction]() as [transaction]
     join [npo].[registrSharer]() as [sharer] on [sharer].[ID_SHARER] = [transaction].[ID_SHARER]
where [transaction].[VALUE_DATE] between @startDate and @endDate
      and [transaction].[CODE_OPERATION] in ( 
                                                                           20	--Выплата унаследованных сумм
                                                                          ,50 --Выплата унаследованных сумм - дополнительная выплата
                                                                          ,21	--Подоходный налог с унаследованной суммы
                                              
                                                                          ,37	--Возврат унаследованных сумм
                                                                         )
group by [transaction].[ID_SHARER]
) ;"

"CREATE FUNCTION [npo].[transactionIncome] (@startDate date, @endDate date)
RETURNS TABLE AS
RETURN (
------------------------------------------------------------------------------------------------------------------------------------------------------
---- Финансовый результат от размещения пенсионных резервов за период @startDate and @endDate     ----
------------------------------------------------------------------------------------------------------------------------------------------------------
select [data].[ID_SHARER],sum([data].[VALUE]) as [VALUE]
from (
          select [transaction].[ID_SHARER],[transaction].[SIGN_VALUE] * [transaction].[VALUE] as [VALUE]
          from [project_xbrl].[npo].[transaction]() as [transaction]
          where [transaction].[CODE_OPERATION] in (  5	/*МГД*/,12	/*Доначисленный доход*/  )
                and [transaction].[VALUE_DATE] between @startDate and @endDate
                and (month([transaction].[VALUE_DATE]) = 12  and day([transaction].[VALUE_DATE]) = 31)
              )  as [data]        
       join [npo].[registrSharer]() as [sharer] on [data].[ID_SHARER] = [sharer].[ID_SHARER]
group by [data].[ID_SHARER]         
) ;"
"CREATE FUNCTION [npo].[transactionInpayment] (@startDate date, @endDate date)
RETURNS TABLE AS
RETURN (
-----------------------------------------------------------
----   Взносы за период @startDate and @endDate        ----
-----------------------------------------------------------
select 
[transaction].[ID_SHARER]
,sum([transaction].[SIGN_VALUE] * [transaction].[VALUE]) as [VALUE]
from [project_xbrl].[npo].[transaction]() as [transaction]
     join [npo].[registrSharer]() as [sharer] on [sharer].[ID_SHARER] = [transaction].[ID_SHARER]
where [transaction].[VALUE_DATE] between @startDate and @endDate
      and [transaction].[CODE_OPERATION] in (  4	--От работодателя
                                              ,8	--Целевые взносы
                                              ,11	--Ч/з банк
                                              ,38	--Возврат взносов вкладчику
                                             )
group by [transaction].[ID_SHARER]
);"

"CREATE FUNCTION [npo].[transactionInpaymentFirst] (@date date)
RETURNS TABLE AS
RETURN (
----------------------------------------------------
----   Первая операция взносов        ----
----------------------------------------------------
select 
[transaction].[ID_SHARER]
,sum([transaction].[SIGN_VALUE] * [transaction].[VALUE]) as [VALUE]
,[transaction].[VALUE_DATE]
from [project_xbrl].[npo].[transaction]() as [transaction]
      join (
               select [transaction].[ID_SHARER],min([transaction].[VALUE_DATE]) as [VALUE_DATE]
               from [project_xbrl].[npo].[transaction]() as [transaction]
               where [transaction].[CODE_OPERATION] in (  
                                                                                                      4	/*От работодателя*/ ,8	/*Целевые взносы*/ ,11	/*Ч/з банк*/
                                                                                                     ,30	/*Перевод между счетами (со взносов)*/ ,31	/*Перевод между счетами (с дохода)*/
                                                                                                     ,29 /*Слияние счетов (с дохода)*/ ,7 /*Слияние счетов (со взносов)*/                                                                                         
                                                                                                    )
                     and [transaction].[VALUE_DATE] <= @date
                     and [type_value] = 'CR' 
                 group by [transaction].[ID_SHARER]     
                 ) as [transactionFirst] on [transaction].[ID_SHARER] = [transactionFirst].[ID_SHARER] and [transaction].[VALUE_DATE] = [transactionFirst].[VALUE_DATE]
where  [transaction].[CODE_OPERATION] in (  
                                                                                          4	/*От работодателя*/ ,8	/*Целевые взносы*/ ,11	/*Ч/з банк*/
                                                                                         ,30	/*Перевод между счетами (со взносов)*/ ,31	/*Перевод между счетами (с дохода)*/
                                                                                         ,29 /*Слияние счетов (с дохода)*/ ,7 /*Слияние счетов (со взносов)*/                                                                                         
                                                                                       )
       and [transaction].[VALUE_DATE] <= @date
       and [type_value] = 'CR' 
group by [transaction].[ID_SHARER],[transaction].[VALUE_DATE]
);"

"CREATE FUNCTION [npo].[transactionMergeAccount] (@startDate date, @endDate date)
RETURNS TABLE
RETURN (
-------------------------------------------------------------------
--Сумма переводов по счету за отчетный период
------------------------------------------------------------------
select [data].[ID_SHARER],sum([data].[VALUE]) as [VALUE]
from (
                select [transaction].[ID_SHARER],[transaction].[SIGN_VALUE] * [transaction].[VALUE] as [VALUE]
                from [project_xbrl].[npo].[transaction]() as [transaction]
                where [transaction].[CODE_OPERATION] in ( 23	--Списание в СР
                                                                                         ,24	--Поступление из СР
                                                                                         ,7	  --Слияние счетов (со взносов)
                                                                                         ,29	--Слияние счетов (с дохода)
                                                                                         )
                          and [transaction].[VALUE_DATE] between @startDate and @endDate

                      union all

                      select [transaction].[ID_SHARER],[transaction].[SIGN_VALUE] * [transaction].[VALUE] as [VALUE]
                      from [project_xbrl].[npo].[transaction]() as [transaction]
                      where [transaction].[CODE_OPERATION] in (  5	/*МГД*/ ,12	/*Доначисленный доход*/   )
                             and [transaction].[VALUE_DATE] between @startDate and @endDate
                             and not (month([transaction].[VALUE_DATE]) = 12  and day([transaction].[VALUE_DATE]) = 31)
                             
                             
                    union all
                    
                    --https://portal.futurenpf.ru/company/personal/user/3645/tasks/task/view/32628/
                    /* 0420258 форма переводы с СПС на ИПС и обратно
                    Прошу в 0420258 форме движения между ИПС и СПС в обе стороны отражать в столбце ""Сумма переводов""
                    */
                    select [transaction].[ID_SHARER] ,sum([transaction].[SIGN_VALUE] * [transaction].[VALUE]) as [VALUE]
                    from [project_xbrl].[npo].[transaction]() as [transaction]
                               join [npo].[registrSharer]() as [sharer] on [transaction].[ID_SHARER] = [sharer].[ID_SHARER] 
                    where [transaction].[VALUE_DATE] between @startDate and @endDate
                                       and [transaction].[CODE_OPERATION] in ( 30	/*Перевод между счетами (со взносов)*/ ,31	/*Перевод между счетами (с дохода)*/  )
                                       and [transaction].[ID_DOCUMENT] in (
                                                                                                                 select  [transaction].[ID_DOCUMENT]
                                                                                                                 from [project_xbrl].[npo].[transaction]() as [transaction]
                                                                                                                                           join [npo].[registrSharer]() as [sharer] on [transaction].[ID_SHARER] = [sharer].[ID_SHARER]
                                                                                                                  where [transaction].[VALUE_DATE] between @startDate and @endDate
                                                                                                                                                      and [transaction].[CODE_OPERATION] in ( 30	/*Перевод между счетами (со взносов)*/ ,31	/*Перевод между счетами (с дохода)*/  )
                                                                                                                  group by [transaction].[ID_DOCUMENT]
                                                                                                                  having count(distinct [sharer].[ACCOUNT_TYPE]) = 2
                                                                                                                  )
                       group by [transaction].[ID_SHARER]
                    
       )  as [data]        
       join [npo].[registrSharer]() as [sharer] on [data].[ID_SHARER] = [sharer].[ID_SHARER]

group by [data].[ID_SHARER]        
);"

"CREATE FUNCTION [npo].[transactionOtherTransfer] (@startDate date, @endDate date)
RETURNS TABLE as 
RETURN (
-------------------------------------------------------
----   Иные переводы по счету            ----
------------------------------------------------------
select [ID_SHARER], sum([VALUE]) as [VALUE]
from (
                        select [transaction].[ID_SHARER] ,sum([transaction].[SIGN_VALUE] * [transaction].[VALUE]) as [VALUE]
                        from [project_xbrl].[npo].[transaction]() as [transaction]
                                 join [npo].[registrSharer]() as [sharer] on [transaction].[ID_SHARER] = [sharer].[ID_SHARER]
                        where [transaction].[VALUE_DATE] between @startDate and @endDate
                                                               and [transaction].[CODE_OPERATION] in ( 30	/*Перевод между счетами (со взносов)*/ ,31	/*Перевод между счетами (с дохода)*/  )
                                            
                                                              --https://portal.futurenpf.ru/company/personal/user/3645/tasks/task/view/32628/
                                                              /* 0420258 форма переводы с СПС на ИПС и обратно
                                                              Прошу в 0420258 форме движения между ИПС и СПС в обе стороны отражать в столбце ""Сумма переводов""
                                                              */
                                                               and [transaction].[ID_DOCUMENT] in (
                                                                                                                                         select  [transaction].[ID_DOCUMENT]
                                                                                                                                         from [project_xbrl].[npo].[transaction]() as [transaction]
                                                                                                                                                                   join [npo].[registrSharer]() as [sharer] on [transaction].[ID_SHARER] = [sharer].[ID_SHARER]
                                                                                                                                          where [transaction].[VALUE_DATE] between @startDate and @endDate
                                                                                                                                                                              and [transaction].[CODE_OPERATION] in ( 30	/*Перевод между счетами (со взносов)*/ ,31	/*Перевод между счетами (с дохода)*/  )
                                                                                                                                          group by [transaction].[ID_DOCUMENT]
                                                                                                                                          having count(distinct [sharer].[ACCOUNT_TYPE]) = 1
                                                                                                                                          )
                                                                                                                                          
                        group by [transaction].[ID_SHARER]        

                        union all

                        select [transaction].[ID_SHARER] ,
                         sum(
                         case 
                              when [transaction].[CODE_OPERATION] in (6	/*Выплата пенсии участнику*/ ,13	/*Подоходный налог с пенсии*/ ,14	/*Выплата по исполнительному листу*/) and [transaction].[TYPE_VALUE] = 'DB' 
                              then  case when  [sharer].[SHARER_TYPE] = N'ФЛ' then  [transaction].[VALUE] else -1 * [transaction].[VALUE] end 
                              when [transaction].[CODE_OPERATION] in (33	/*Возврат пенсий*/,34	/*Возврат НДФЛ с пенсий*/) and [transaction].[TYPE_VALUE] = 'CR' 
                              then  case  when [sharer].[SHARER_TYPE] = N'ФЛ' then   -1 * [transaction].[VALUE] else [transaction].[VALUE] end
                              else 0 end
                             ) as [VALUE]
                         from [project_xbrl].[npo].[transaction]() as [transaction]
                                   join [npo].[registrSharer]() as [sharer] on [sharer].[ID_SHARER] = [transaction].[ID_SHARER] and [sharer].[ACCOUNT_TYPE] = N'СПС'
                        where [transaction].[CODE_OPERATION] in (6	/*Выплата пенсии участнику*/ ,13	/*Подоходный налог с пенсии*/ ,14	/*Выплата по исполнительному листу*/
                                                                                                            ,33	/*Возврат пенсий*/,34	/*Возврат НДФЛ с пенсий*/ )
                              and [transaction].[VALUE_DATE] between @startDate and @endDate
                        group by [transaction].[ID_SHARER]
) as [data]  group by  [ID_SHARER]

) ;"

