"CREATE FUNCTION [npo].[transactionTransfer] (@startDate date, @endDate date)
RETURNS TABLE
RETURN (
-------------------------------------------------------------------------------
--Выкупная сумма 
-------------------------------------------------------------------------------
select 
[transaction].[ID_SHARER]
,sum( 
case 
when [transaction].[CODE_OPERATION] in (
                                                                        17	--Выплата выкупной суммы
                                                                       ,49  --Выплата выкупной суммы - дополнительная выплата
                                                                       ,19	--Подоходный налог с выкупной суммы
                                                                       ,39	--Выплата выкупной суммы без расторжения
                                                                       )
then [transaction].[VALUE] 
else - [transaction].[VALUE] 
end
) as [VALUE]
,max([transaction].[VALUE_DATE]) as [VALUE_DATE]
from [project_xbrl].[npo].[transaction]() as [transaction]
     join [npo].[registrSharer]() as [sharer] on [sharer].[ID_SHARER] = [transaction].[ID_SHARER]
where [transaction].[VALUE_DATE] between @startDate and @endDate
      and [transaction].[CODE_OPERATION] in (  
                                                                        17	--Выплата выкупной суммы
                                                                       ,49  --Выплата выкупной суммы - дополнительная выплата
                                                                       ,19	--Подоходный налог с выкупной суммы
                                                                       ,39	--Выплата выкупной суммы без расторжения
                                              
                                                                      ,35	--Возврат выкупных сумм
                                                                      ,36	--Возврат НДФЛ с выкупных сумм
                                                                     )
group by [transaction].[ID_SHARER]
) ;"

"CREATE FUNCTION [npo].[transactionTransferDate] (@Date date)
RETURNS TABLE
RETURN (
-------------------------------------------------------------------------------
--Выкупная сумма 
-------------------------------------------------------------------------------
select [transaction].[npo_pension_account_id]  as [ID_SHARER]
,cast(min([transaction].[period_date]) as date) as [VALUE_DATE]
,cast(max([transaction].[period_date]) as date) as [LAST_DATE]
from [DWH].[npf].[npo_pension_account_operation] as [transaction] 
     join [DWH].[npf].[npo_operation_types] as [typeAccount] on [typeAccount].[npo_operation_type_id] = [transaction].[npo_operation_type_id]
            and [typeAccount].[is_marked_for_delete] = 0
            and [typeAccount].[npo_operation_type_code] in (17 ,49 ) --Выплата выкупной суммы
where [transaction].[is_active] = 1
and [transaction].[period_date] < dateadd(day,1,@Date)
group by [transaction].[npo_pension_account_id]
) ;"







