"CREATE FUNCTION [npo].[lastPayPension] (@date date)
RETURNS  TABLE as 
RETURN (
-----------------------------------------------------------
----   Последняя Выплата пенсии        ----
-----------------------------------------------------------
select [transaction].[ID_SHARER]
,max([transaction].[VALUE_DATE]) as [VALUE_DATE]
,sum(
 case 
      when [transaction].[CODE_OPERATION] in (6	/*Выплата пенсии участнику*/ ,13	/*Подоходный налог с пенсии*/ ,14	/*Выплата по исполнительному листу*/) and [transaction].[TYPE_VALUE] = 'DB' 
      then  [transaction].[VALUE] 
      when [transaction].[CODE_OPERATION] in (33	/*Возврат пенсий*/,34	/*Возврат НДФЛ с пенсий*/) and [transaction].[TYPE_VALUE] = 'CR' 
      then -1 * [transaction].[VALUE]
      else 0 end ) as [VALUE]
from [project_xbrl].[npo].[transaction]() as [transaction]
           join [npo].[registrSharer]() as [sharer] on [sharer].[ID_SHARER] = [transaction].[ID_SHARER] and [sharer].[SHARER_TYPE] = N'ФЛ' 
where [transaction].[CODE_OPERATION] in (6	/*Выплата пенсии участнику*/ 
                                                                                    ,13	/*Подоходный налог с пенсии*/ 
                                                                                    ,14	/*Выплата по исполнительному листу*/
                                                                                    ,33	/*Возврат пенсий*/
                                                                                    ,34	/*Возврат НДФЛ с пенсий*/ )
                                                                                    
      and [transaction].[VALUE_DATE] <= @date
group by [transaction].[ID_SHARER]
) ;"

"CREATE FUNCTION [npo].[transaction] ()
RETURNS TABLE 
AS
RETURN 
(
-----------------------------------------------------------
--список транзакций 
-----------------------------------------------------------
select 
 [transaction].[npo_pension_account_id]  as [ID_SHARER]
,[typeAccount].[npo_operation_type_code] as [CODE_OPERATION]
,cast([transaction].[period_date] as date) as [VALUE_DATE]

,[transaction].[amount] as [VALUE]

,
case 
when [transaction].[record_kind] = 0 
then 1
else -1
end as [SIGN_VALUE]

,
case 
when [transaction].[record_kind] = 0 
then N'CR'
else N'DB'
end as [TYPE_VALUE]

,[transaction].[period_date] as [VALUE_TIME]

,[transaction].[name] as [NAME_OPERATION]
,[typeAccount].[npo_operation_type_name] as [SUB_ACCOUNT_TYPE]
,[transaction].[comment] as [COMMENT]

,[transaction].[register_object_type] as [ID_TYPE_DOCUMENT]
,[transaction].[register_document_id] as [ID_DOCUMENT]
,[transaction].[npo_operation_type_id] as [ID_ACCOUNT_TYPE]
from [DWH].[npf].[npo_pension_account_operation] as [transaction]  with(nolock)
      left join [DWH].[npf].[npo_operation_types] as [typeAccount] with(nolock) on [typeAccount].[npo_operation_type_id] = [transaction].[npo_operation_type_id]
            and [typeAccount].[is_marked_for_delete] = 0
where [transaction].[is_active] = 1
);"

