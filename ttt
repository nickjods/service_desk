with recursive base as (
		        select
		            s.id,
		            s.contract_id,
		            s.individual_id,
		            di.death_date::date as death_date,
		            ls.code as last_status_code,
		            ls.status_date as last_status_date,
		            ss.name as last_status_name,
		            prev_status.code as previous_status_code,
		            prev_status.status_name as previous_status_name
		        from ourpension.sharer s
		        left join lateral (
		            select
		                adi.death_date
		            from ourpension.application_death_info adi
		            where adi.accepted is not null
		              and adi.canceled is null
		              and adi.rejected is null
		              and adi.individual_id = s.individual_id
		            order by adi.version desc
		            limit 1
		        ) di on true
		        left join lateral (
		            select
		                ssh.code,
		                ssh.status_date,
		                ssh.id as status_history_id
		            from ourpension.sharer_statuses_history ssh
		            where ssh.sharer_id = s.id
		              and ssh.status_date < v_calc_datetime
		            order by ssh.status_date desc, ssh.id desc
		            limit 1
		        ) ls on true
		        left join ourpension.sharer_statuses ss
		          on ss.code = ls.code
		        left join lateral (
		            select
		                ssh.code,
		                ss0.name as status_name
		            from ourpension.sharer_statuses_history ssh
		            join ourpension.sharer_statuses ss0
		              on ss0.code = ssh.code
		            where ssh.sharer_id = s.id
		              and ls.code = 'IA0'
		              and (ssh.status_date, ssh.id) <
		                  (ls.status_date, ls.status_history_id)
		              and ssh.code <> 'IA0'
		            order by ssh.status_date desc, ssh.id desc
		            limit 1
		        ) prev_status on true
		        where s.id = p_sharer_id
		    ),
		    death_period as (
		        select
		            b.death_date,
		            date_trunc('month', b.death_date)::date as death_month_start,
		            (date_trunc('month', b.death_date) + interval '1 month')::date
		                as death_month_end_exclusive
		        from base b
		    ),
		    settings as materialized (
		        select distinct
		            sc.direction,
		            sc.s_ts,
		            sc.operation_type_code,
		            sc.mnemonics
		        from actuary.settings_for_redemption_calculation sc
		        where sc.service_type = 'NPO'
		          and sc.calculation_type = 'FULL'
		          and sc.direction in ('credit', 'debit')
		          and sc.s_ts in (
		              's_vznos', 's_dd', 's_mgd', 's_vosp',
		              's_vypl', 's_perevod', 's_vozvrat', 's_pereplat'
		          )
		    ),
		    trans_all_credit as materialized (
		        select
		            s.id,
		            t.credit_account_id,
		            t.debit_account_id,
		            a.owner_sharer_id as side_owner_sharer_id,
		            t.id as transaction_id,
		            o.id as operation_id,
		            ot.code as operation_name,
		            at2.mnemonics,
		            t.effective_date,
		            t.value::numeric as trans_amount,
		            'credit'::text as direction
		        from back_office.transaction t
		        join back_office.operation o on o.id = t.operation_id
		        join back_office.operation_type ot on ot.id = o.operation_type_id
		        join back_office.account a on a.id = t.credit_account_id
		        join back_office.account_type at2 on at2.id = a.account_type_id
		        join ourpension.sharer s 
		        	on (
		        		s.id = a.owner_sharer_id 
		        		or a.owner_individual_id = s.individual_id
		        	)
		        where s.id = p_sharer_id
		          and t.effective_date < p_calc_date + 1
		    ),
		    trans_all_debit as materialized (
		        select
		            s.id,
		            t.credit_account_id,
		            t.debit_account_id,
		            a.owner_sharer_id as side_owner_sharer_id,
		            t.id as transaction_id,
		            o.id as operation_id,
		            ot.code as operation_name,
		            at2.mnemonics,
		            t.effective_date,
		            t.value::numeric as trans_amount,
		            'debit'::text as direction
		        from back_office.transaction t
		        join back_office.operation o on o.id = t.operation_id
		        join back_office.operation_type ot on ot.id = o.operation_type_id
		        join back_office.account a on a.id = t.debit_account_id
		        join back_office.account_type at2 on at2.id = a.account_type_id
		        join ourpension.sharer s 
		        	on (
		        		s.id = a.owner_sharer_id 
		        		or a.owner_individual_id = s.individual_id
		        	)
		        where s.id = p_sharer_id
		          and t.effective_date < p_calc_date + 1
		    ),
		    trans_source as materialized (
		        select * from trans_all_credit
		        union all
		        select * from trans_all_debit
		    ),
		    last_operation_before_close as (
		        select
		            t.operation_id,
		            t.operation_name,
		            t.effective_date
		        from trans_source t
		        join base b on b.id = t.id
		        where b.last_status_code = 'IA0'
		          and t.effective_date < b.last_status_date::date + 1
		        order by t.effective_date desc, t.operation_id desc
		        limit 1
		    ),
		    trans_checked as materialized (
		        select
		            t.*,
		            (
		                b.last_status_code = 'IA0'
		                and t.operation_name = 'TRANSFER_TO_INSURED_FUND_RESERVE'
		                and t.operation_id = loc.operation_id
		            ) is true as excluded_final_reserve
		        from trans_source t
		        join base b on b.id = t.id
		        left join last_operation_before_close loc on true
		    ),
		    -- s_pereplat: единый отбор движений из двух логических источников:
		    --   1) DEBIT счет участника (owner_sharer_id = b.id) -- старый источник;
		    --   2) CREDIT счет участника ИЛИ DEBIT счет физлица-держателя счета.
		    -- Участник = b.individual_id, НЕ p_individual_id правопреемника.
		    -- В trans_source одна проводка часто видна по двум сторонам.
		    -- Поэтому сначала оставляем только одну строку на (id, transaction_id).
		    -- Мнемонику берем с той ФАКТИЧЕСКОЙ стороны проводки,
		    -- чья мнемоника присутствует в settings для s_pereplat / debit.
		    -- Если подходят обе стороны, приоритет у DEBIT.
		    -- Направление 'debit' в trans_mapped -- направление РАСЧЕТА,
		    -- даже если выбранная мнемоника находится на CREDIT-счете.
		    pereplat_candidates as materialized (
		        select
		            t.id,
		            t.transaction_id,
		            t.operation_id,
		            t.operation_name,
		            pm.mnemonics,
		            t.effective_date,
		            t.trans_amount,
		            case
		                when ad.owner_sharer_id = b.id
		                    then 'DEBIT_SHARER'
		                when ac.owner_sharer_id = b.id
		                 and ad.owner_individual_id = b.individual_id
		                    then 'CREDIT_SHARER_DEBIT_INDIVIDUAL'
		                when ad.owner_individual_id = b.individual_id
		                    then 'DEBIT_INDIVIDUAL'
		                else 'CREDIT_SHARER'
		            end::text as pereplat_source,
		            pm.account_side as pereplat_mnemonics_side
		        from (
		            select distinct on (ts.id, ts.transaction_id)
		                ts.id,
		                ts.transaction_id,
		                ts.operation_id,
		                ts.operation_name,
		                ts.effective_date,
		                ts.trans_amount,
		                ts.credit_account_id,
		                ts.debit_account_id
		            from trans_source ts
		            order by ts.id, ts.transaction_id,
		                     case when ts.direction = 'debit' then 0 else 1 end
		        ) t
		        join base b on b.id = t.id
		        left join back_office.account ac
		          on ac.id = t.credit_account_id
		        left join back_office.account ad
		          on ad.id = t.debit_account_id
		        left join back_office.account_type atc
		          on atc.id = ac.account_type_id
		        left join back_office.account_type atd
		          on atd.id = ad.account_type_id
		        cross join death_period dp
		        join lateral (
		            select x.mnemonics, x.account_side
		            from (
		                values
		                    (atd.mnemonics, 'DEBIT_ACCOUNT'::text, 1),
		                    (atc.mnemonics, 'CREDIT_ACCOUNT'::text, 2)
		            ) x(mnemonics, account_side, priority)
		            where exists (
		                select 1
		                from settings sc
		                where sc.s_ts = 's_pereplat'
		                  and sc.direction = 'debit'
		                  and sc.mnemonics = x.mnemonics
		            )
		            order by x.priority
		            limit 1
		        ) pm on true
		        where dp.death_month_end_exclusive is not null
		          and t.effective_date >= dp.death_month_end_exclusive
		          -- Верхняя граница (< p_calc_date + 1) уже стоит в trans_all_*.
		          -- Два источника учитываются по независимым условиям владельца.
		          and (
		              ad.owner_sharer_id = b.id
		              or ac.owner_sharer_id = b.id
		              or ad.owner_individual_id = b.individual_id
		          )
		          and t.operation_name <> 'TRANSFER_TO_INSURED_FUND_RESERVE'
		    ),
		    trans_mapped as materialized (
		        select
		            t.id,
		            t.transaction_id,
		            t.operation_id,
		            t.operation_name,
		            t.mnemonics,
		            t.effective_date,
		            t.trans_amount,
		            t.direction,
		            st.s_ts,
		            null::text as pereplat_source,
		            null::text as pereplat_mnemonics_side
		        from trans_checked t
		        cross join death_period dp
		        cross join (
		            values
		                ('s_vznos'::text),
		                ('s_dd'::text),
		                ('s_mgd'::text),
		                ('s_vosp'::text),
		                ('s_vypl'::text),
		                ('s_perevod'::text),
		                ('s_vozvrat'::text)
		        ) st(s_ts)
		        where not t.excluded_final_reserve
		        	and t.side_owner_sharer_id = t.id
		          and (
		              (
		                  st.s_ts = 's_vozvrat'
		                  and exists (
		                      select 1
		                      from settings sc
		                      where sc.direction = t.direction
		                        and sc.s_ts = st.s_ts
		                        and sc.mnemonics = t.mnemonics
		                  )
		              )
		              or
		              (
		                  st.s_ts in ('s_vznos', 's_dd', 's_mgd', 's_vosp')
		                  and exists (
		                      select 1
		                      from settings sc
		                      where sc.direction = t.direction
		                        and sc.s_ts = st.s_ts
		                        and sc.operation_type_code = t.operation_name
		                  )
		                  and exists (
		                      select 1
		                      from settings sc
		                      where sc.direction = t.direction
		                        and sc.s_ts = st.s_ts
		                        and sc.mnemonics = t.mnemonics
		                  )
		              )
		              or
		              (
		                  st.s_ts in ('s_vypl', 's_perevod')
		                  and exists (
		                      select 1
		                      from settings sc
		                      where sc.direction = t.direction
		                        and sc.s_ts = st.s_ts
		                        and sc.operation_type_code = t.operation_name
		                  )
		                  and (
		                      t.direction = 'debit'
		                      or exists (
		                          select 1
		                          from settings sc
		                          where sc.direction = 'credit'
		                            and sc.mnemonics = t.mnemonics
		                      )
		                  )
		              )
		          )
		          -- Если транзакция признана переплатой, не удваиваем её как возврат.
		          -- Другие типы сумм FULL не затрагиваем.
		          and (
		              st.s_ts <> 's_vozvrat'
		              or not exists (
		                  select 1
		                  from pereplat_candidates pc
		                  where pc.id = t.id
		                    and pc.transaction_id = t.transaction_id
		              )
		          )
		          and (
		              st.s_ts = 's_vozvrat'
		              or not exists (
		                  select 1
		                  from settings sr
		                  where sr.s_ts = 's_vozvrat'
		                    and sr.direction = t.direction
		                    and sr.mnemonics = t.mnemonics
		              )
		          )
		          
		        union all

		        -- Только один экземпляр каждой переплатной транзакции.
		        select
		            pc.id,
		            pc.transaction_id,
		            pc.operation_id,
		            pc.operation_name,
		            pc.mnemonics,
		            pc.effective_date,
		            pc.trans_amount,
		            'debit'::text as direction,
		            's_pereplat'::text as s_ts,
		            pc.pereplat_source,
		            pc.pereplat_mnemonics_side
		        from pereplat_candidates pc
		    ),
		    trans_included as materialized (
		        select t.*
		        from trans_checked t
		        where not t.excluded_final_reserve
		          and exists (
		              select 1
		              from trans_mapped m
		              where m.transaction_id = t.transaction_id
		                and m.direction = t.direction
		          )
		    ),
		    trans_not_included as materialized (
		        select t.*
		        from trans_checked t
		        where t.excluded_final_reserve
		           or not exists (
		               select 1
		               from trans_mapped m
		               where m.transaction_id = t.transaction_id
		                 and m.direction = t.direction
		           )
		    ),
		    trans_amounts as (
		        select
		            m.*,
		            case
		                when m.s_ts = 's_pereplat'
		                    then case when m.direction = 'debit'
		                              then m.trans_amount else -m.trans_amount end
		                when m.s_ts in ('s_vznos', 's_dd', 's_mgd', 's_vosp', 's_vozvrat')
		                    then case when m.direction = 'credit'
		                              then m.trans_amount else -m.trans_amount end
		                else case when m.direction = 'credit'
		                          then -m.trans_amount else m.trans_amount end
		            end as signed_amount
		        from trans_mapped m
		    ),
		    trans_calc_credit as (
		        select
		            id,
		            sum(signed_amount) filter (where s_ts = 's_vznos') as s_vznos,
		            sum(signed_amount) filter (where s_ts = 's_dd') as s_dd,
		            sum(signed_amount) filter (where s_ts = 's_mgd') as s_mgd,
		            sum(signed_amount) filter (where s_ts = 's_vosp') as s_vosp,
		            sum(signed_amount) filter (where s_ts = 's_vypl') as s_vypl,
		            sum(signed_amount) filter (where s_ts = 's_perevod') as s_perevod,
		            sum(signed_amount) filter (where s_ts = 's_vozvrat') as s_vozvrat,
		            sum(signed_amount) filter (where s_ts = 's_pereplat') as s_pereplat
		        from trans_amounts
		        where direction = 'credit'
		        group by id
		    ),
		    trans_calc_debit as (
		        select
		            id,
		            sum(signed_amount) filter (where s_ts = 's_vznos') as s_vznos,
		            sum(signed_amount) filter (where s_ts = 's_dd') as s_dd,
		            sum(signed_amount) filter (where s_ts = 's_mgd') as s_mgd,
		            sum(signed_amount) filter (where s_ts = 's_vosp') as s_vosp,
		            sum(signed_amount) filter (where s_ts = 's_vypl') as s_vypl,
		            sum(signed_amount) filter (where s_ts = 's_perevod') as s_perevod,
		            sum(signed_amount) filter (where s_ts = 's_vozvrat') as s_vozvrat,
		            sum(signed_amount) filter (where s_ts = 's_pereplat') as s_pereplat
		        from trans_amounts
		        where direction = 'debit'
		        group by id
		    ),
		    trans_included_json as (
		        select
		            id,
		            coalesce(
		                jsonb_agg(
		                    jsonb_build_object(
		                        'operation_name', operation_name,
		                        'mnemonics', mnemonics,
		                        'amount', trans_amount
		                    ) order by operation_name, mnemonics
		                ) filter (where direction = 'credit'),
		                '[]'::jsonb
		            ) as credit_included_json,
		            coalesce(
		                jsonb_agg(
		                    jsonb_build_object(
		                        'operation_name', operation_name,
		                        'mnemonics', mnemonics,
		                        'amount', trans_amount
		                    ) order by operation_name, mnemonics
		                ) filter (where direction = 'debit'),
		                '[]'::jsonb
		            ) as debit_included_json
		        from (
		            select
		                id,
		                direction,
		                operation_name,
		                mnemonics,
		                sum(trans_amount) as trans_amount
		            from trans_included
		            group by id, direction, operation_name, mnemonics
		        ) a
		        group by id
		    ),
		    trans_not_included_json as (
		        select
		            id,
		            coalesce(
		                jsonb_agg(
		                    jsonb_build_object(
		                        'operation_name', operation_name,
		                        'mnemonics', mnemonics,
		                        'amount', trans_amount,
		                        'reason', case
		                            when excluded_final_reserve
		                                then 'FINAL_TRANSFER_TO_INSURED_FUND_RESERVE'
		                            else 'NOT_MAPPED'
		                        end
		                    ) order by operation_name, mnemonics
		                ) filter (where direction = 'credit'),
		                '[]'::jsonb
		            ) as credit_not_included_json,
		            coalesce(
		                jsonb_agg(
		                    jsonb_build_object(
		                        'operation_name', operation_name,
		                        'mnemonics', mnemonics,
		                        'amount', trans_amount,
		                        'reason', case
		                            when excluded_final_reserve
		                                then 'FINAL_TRANSFER_TO_INSURED_FUND_RESERVE'
		                            else 'NOT_MAPPED'
		                        end
		                    ) order by operation_name, mnemonics
		                ) filter (where direction = 'debit'),
		                '[]'::jsonb
		            ) as debit_not_included_json
		        from (
		            select
		                id,
		                direction,
		                operation_name,
		                mnemonics,
		                excluded_final_reserve,
		                sum(trans_amount) as trans_amount
		            from trans_not_included
		            group by id, direction, operation_name, mnemonics, excluded_final_reserve
		        ) a
		        group by id
		    ),
		    successors_share as (
		        select
		            s.id,
		            a.d
		        from ourpension.sharer s
		        left join lateral (
		            select
		                ip.share_numerator::numeric /
		                    nullif(ip.share_denominator::numeric, 0) as d
		            from ourpension.inherited_payment ip
		            left join ourpension.inherited_payment_data ipd
		                on ipd.inherited_payment_id = ip.id
		            where s.id = coalesce(ipd.sharer_id, ip.sharer_id)
		              and ip.inheritor_id = p_individual_id
		              and ip."date" <= p_calc_date
		            order by ip."date" desc, ip.id desc
		            limit 1
		        ) a on true
		        where s.id = p_sharer_id
		    ),
		    calc_params as (
		        select
		            coalesce(tcc.s_vznos, 0) + coalesce(tcd.s_vznos, 0) as s_vznos,
		            coalesce(tcc.s_dd, 0) + coalesce(tcd.s_dd, 0) as s_dd,
		            coalesce(tcc.s_mgd, 0) + coalesce(tcd.s_mgd, 0) as s_mgd,
		            coalesce(tcc.s_vosp, 0) + coalesce(tcd.s_vosp, 0) as s_vosp,
		            coalesce(tcc.s_vypl, 0) + coalesce(tcd.s_vypl, 0) as s_vypl,
		            coalesce(tcc.s_perevod, 0) + coalesce(tcd.s_perevod, 0) as s_perevod,
		            coalesce(tcc.s_vozvrat, 0) + coalesce(tcd.s_vozvrat, 0) as s_vozvrat,
		            coalesce(tcc.s_pereplat, 0) + coalesce(tcd.s_pereplat, 0) as s_pereplat,
		            coalesce(tcc.s_vypl, 0) + coalesce(tcd.s_vypl, 0)
		              + coalesce(tcc.s_perevod, 0) + coalesce(tcd.s_perevod, 0)
		                as s_vypl_per,
		            ss.d
		        from base b
		        left join trans_calc_credit tcc on tcc.id = b.id
		        left join trans_calc_debit tcd on tcd.id = b.id
		        left join successors_share ss on ss.id = b.id
		    ),
		    coeff_params as (
		        select
		            coalesce(t.k1, 1)::numeric as k1,
		            coalesce(t.k2, 1)::numeric as k2,
		            coalesce(t.k3, 1)::numeric as k3,
		            coalesce(t.k4, 1)::numeric as k4,
		            coalesce(t.kf, 1)::numeric as kf,
		            case
		                when t.sharer_id is null
		                    then jsonb_build_object('code', 'REDEMPTION_COEFF_NOT_FOUND')
		                else t.details_json
		            end as details_json,
		            t.inheritance_on_pay,
		            t.inheritance_on_accum
		        from base b
		        left join lateral (
		            select
		                grc.sharer_id,
		                grc.k1,
		                grc.k2,
		                grc.k3,
		                grc.k4,
		                grc.kf,
		                grc.details_json,
		                grc.inheritance_on_pay,
		                grc.inheritance_on_accum
		            from actuary.get_redemption_coeff(
		                b.id,
		                '{}'::integer[],
		                'NPO',
		                p_calc_date,
		                'Правопреемники',
		                null,
		                null
		            ) grc
		            where grc.sharer_id = b.id
		        ) t on true
		    ),
		    inheritance_source as (
		        select
		            nullif(btrim(cp.inheritance_on_pay::text), '') as inheritance_on_pay,
		            nullif(btrim(cp.inheritance_on_accum::text), '') as inheritance_on_accum
		        from coeff_params cp
		    ),
		    inheritance_classified as (
		        select
		            src.*,
		            case
		                when src.inheritance_on_pay = 'ПредусмотрПериодНакоплИВыплат'
		                 and src.inheritance_on_accum = 'ПредусмотрПериодНакоплИВыплат'
		                    then 'FULL'
		                when src.inheritance_on_pay is null
		                 and src.inheritance_on_accum = 'ПредусмотрПериодНакопл'
		                    then 'ACCUM_ONLY'
		                when src.inheritance_on_pay = 'ПредусмотрПериодВыплат'
		                 and src.inheritance_on_accum is null
		                    then 'PAY_ONLY'
		                when coalesce(
		                        src.inheritance_on_pay,
		                        src.inheritance_on_accum
		                     ) = 'НеПредусмотрено'
		                 and (src.inheritance_on_pay is null
		                      or src.inheritance_on_pay = 'НеПредусмотрено')
		                 and (src.inheritance_on_accum is null
		                      or src.inheritance_on_accum = 'НеПредусмотрено')
		                    then 'EXCLUDED'
		                else 'UNRESOLVED'
		            end::text as inheritance_type
		        from inheritance_source src
		    ),
		    inheritance_mode as (
		        select
		            c.inheritance_on_pay,
		            c.inheritance_on_accum,
		            c.inheritance_type,
		            case
		                when c.inheritance_type in ('FULL', 'PAY_ONLY') then true
		                when c.inheritance_type in ('ACCUM_ONLY', 'EXCLUDED') then false
		                else null::boolean
		            end as on_pay,
		            case
		                when c.inheritance_type in ('FULL', 'ACCUM_ONLY') then true
		                when c.inheritance_type in ('PAY_ONLY', 'EXCLUDED') then false
		                else null::boolean
		            end as on_accum,
		            (
		                c.inheritance_on_pay is not null
		                and c.inheritance_on_pay not in (
		                    'ПредусмотрПериодНакоплИВыплат',
		                    'ПредусмотрПериодВыплат',
		                    'НеПредусмотрено'
		                )
		            ) as pay_conflict,
		            (
		                c.inheritance_on_accum is not null
		                and c.inheritance_on_accum not in (
		                    'ПредусмотрПериодНакоплИВыплат',
		                    'ПредусмотрПериодНакопл',
		                    'НеПредусмотрено'
		                )
		            ) as accum_conflict
		        from inheritance_classified c
		    ),
		    account_phase as (
		        select
		            b.last_status_code,
		            b.last_status_name,
		            b.last_status_date,
		            b.previous_status_code,
		            b.previous_status_name,
		            case
		                when coalesce(
		                    case when b.last_status_code = 'IA0'
		                         then b.previous_status_code
		                         else b.last_status_code end,
		                    ''
		                ) = 'GA0' then 'ACCUM'::text
		                when coalesce(
		                    case when b.last_status_code = 'IA0'
		                         then b.previous_status_code
		                         else b.last_status_code end,
		                    ''
		                ) = 'HA0' then 'PAY'::text
		                else 'UNKNOWN'::text
		            end as account_phase
		        from base b
		    ),
		    inheritance_decision as (
		        select
		            im.inheritance_on_pay,
		            im.inheritance_on_accum,
		            im.on_pay,
		            im.on_accum,
		            im.inheritance_type,
		            im.pay_conflict,
		            im.accum_conflict,
		            dp.death_date,
		            dp.death_month_start,
		            dp.death_month_end_exclusive,
		            ap.account_phase,
		            ap.last_status_code,
		            ap.last_status_name,
		            ap.last_status_date,
		            ap.previous_status_code,
		            ap.previous_status_name,
		            case
		                when im.inheritance_type = 'FULL' then true
		                when im.inheritance_type = 'ACCUM_ONLY'
		                    then ap.account_phase = 'ACCUM'
		                         or ap.last_status_code = 'IA0'
		                when im.inheritance_type = 'PAY_ONLY'
		                    then ap.account_phase = 'PAY'
		                else false
		            end as use_standard_redemption,
		            (
		                im.inheritance_type = 'EXCLUDED'
		                or (
		                    im.inheritance_type = 'ACCUM_ONLY'
		                    and ap.account_phase = 'PAY'
		                    and ap.last_status_code <> 'IA0'
		                )
		            ) as requires_arrears_calculation,
		            case
		                when im.pay_conflict or im.accum_conflict
		                    then 'CONFLICTING_INHERITANCE_FLAGS'
		                when im.inheritance_type in ('EXCLUDED','ACCUM_ONLY')
		                     and ap.account_phase = 'PAY'
		                     and dp.death_date is null
		                    then 'DEATH_DATE_REQUIRED_FOR_SETTLEMENT'
		                when im.inheritance_type = 'EXCLUDED'
		                     and dp.death_date is null
		                    then 'DEATH_DATE_REQUIRED_FOR_SETTLEMENT'
		                when im.inheritance_type = 'UNRESOLVED'
		                     and im.inheritance_on_pay is null
		                     and im.inheritance_on_accum is null
		                    then 'INHERITANCE_SOURCE_VALUE_REQUIRED'
		                when im.inheritance_type = 'UNRESOLVED'
		                    then 'INHERITANCE_ATTRIBUTES_INCONSISTENT'
		                when im.inheritance_type in ('ACCUM_ONLY','PAY_ONLY')
		                    and ap.account_phase = 'UNKNOWN'
		                    and not (im.inheritance_type = 'ACCUM_ONLY'
		                             and ap.last_status_code = 'IA0')
		                    then 'ACCOUNT_PHASE_UNKNOWN'
		                else null::text
		            end as calculation_warning
		        from inheritance_mode im
		        cross join account_phase ap
		        cross join death_period dp
		    ),
		    payment_last_status as (
		        select
		            h.id,
		            h.sharer_id,
		            h.status_id,
		            h.status_date,
		            h.status_end_date
		        from base b
		        left join lateral (
		            select
		                psh.id,
		                psh.sharer_id,
		                psh.status_id,
		                psh.status_date,
		                psh.status_end_date
		            from ourpension.payment_statuses_history psh
		            where psh.sharer_id = b.id
		              and b.death_date is not null
		              and psh.status_date < b.death_date + interval '1 day'
		            order by psh.status_date desc,
		                     psh.version desc,
		                     psh.id desc
		            limit 1
		        ) h on true
		    ),
		    payment_suspension as (
		        select
		            pls.status_id,
		            pls.status_date,
		            pls.status_end_date,
		            case
		                when pls.status_id = 2
		                 and (
		                     pls.status_end_date is null
		                     or pls.status_end_date > b.death_date::timestamp
		                 )
		                then pls.status_date::date
		                else null::date
		            end as suspended_from
		        from payment_last_status pls
		        cross join base b
		    ),
		    pension_decision_history as materialized (
		        select
		            pc.id as decision_id,
		            pc.calculation_date::date as calculation_date,
		            pc.period_end_date::date as period_end_date,
		            ndpt.short_name::text as payment_type_name,
		            coalesce(pcs1.value_pension, pcs3.value_pension)::numeric
		                as value_pension,
		            coalesce(pcs1.times_in_year, pcs3.times_in_year)::numeric
		                as times_in_year
		        from base b
		        join back_office.pension_calculation pc
		          on pc.sharer_id = b.id
		        join ourpension.npo_decision_payment_type ndpt
		          on ndpt.code = pc.npo_decision_payment_type_code
		        join back_office.npo_decision_type ndt
		          on ndt.id = pc.npo_decision_type_id
		        left join lateral (
		            select x.value_pension, x.times_in_year
		            from back_office.pension_calculation_scheme1 x
		            where x.pension_calculation_id = pc.id
		            limit 1
		        ) pcs1 on true
		        left join lateral (
		            select x.value_pension, x.times_in_year
		            from back_office.pension_calculation_scheme3 x
		            where x.pension_calculation_id = pc.id
		            limit 1
		        ) pcs3 on true
		        where pc.calculation_date < p_calc_date + interval '1 day'
		          and ndpt.short_name in (
		              'До исчерпания', 'Срочная', 'Пожизненная'
		          )
		          and ndt.code in ('УСТН', 'КОРР')
		    ),
		    pension_decision_params as (
		        select
		            pd.calculation_date,
		            pd.period_end_date,
		            pd.payment_type_name,
		            pd.value_pension as last_pension_amount,
		            pd.times_in_year,
		            pd.decision_id
		        from base b
		        left join lateral (
		            select h.*
		            from pension_decision_history h
		            order by h.calculation_date desc, h.decision_id desc
		            limit 1
		        ) pd on true
		    ),
		    pension_decision_at_suspension as (
		        select
		            h.decision_id,
		            h.calculation_date,
		            h.value_pension,
		            h.times_in_year
		        from payment_suspension ps
		        left join lateral (
		            select pd.*
		            from pension_decision_history pd
		            where pd.calculation_date <= ps.suspended_from
		            order by pd.calculation_date desc, pd.decision_id desc
		            limit 1
		        ) h on true
		    ),
		    pension_frequency as (
		        select
		            pd.*,
		            pas.decision_id as suspension_decision_id,
		            pas.calculation_date as suspension_decision_date,
		            pas.value_pension as suspension_pension_amount,
		            pas.times_in_year as suspension_times_in_year,
		            case
		                when pas.times_in_year > 0
		                 and mod(12::numeric, pas.times_in_year) = 0
		                    then (12::numeric / pas.times_in_year)::integer
		                else null::integer
		            end as payment_interval_months
		        from pension_decision_params pd
		        cross join pension_decision_at_suspension pas
		    ),
		    pension_arrears_period as (
		        select
		            ps.suspended_from,
		            (dp.death_month_end_exclusive - 1)::date
		                as death_month_last_day,
		            pf.period_end_date,
		            case
		                when dp.death_date is null then null::date
		                else least(
		                    (dp.death_month_end_exclusive - 1)::date,
		                    coalesce(
		                        pf.period_end_date,
		                        (dp.death_month_end_exclusive - 1)::date
		                    )
		                )
		            end as calculation_until
		        from payment_suspension ps
		        cross join death_period dp
		        cross join pension_frequency pf
		    ),
		    last_pension_payment as (
		        select
		            lp.effective_date::date as last_pension_payment_date,
		            lp.operation_name as last_pension_operation_name,
		            lp.mnemonics as last_pension_mnemonics,
		            lp.signed_amount as last_pension_operation_amount
		        from payment_suspension ps
		        left join lateral (
		            select
		                ta.effective_date,
		                ta.operation_name,
		                ta.mnemonics,
		                ta.signed_amount
		            from trans_amounts ta
		            where ta.s_ts = 's_vypl'
		              and ta.signed_amount > 0
		              and ps.suspended_from is not null
		              and ta.effective_date::date <= ps.suspended_from
		            order by ta.effective_date desc, ta.transaction_id desc
		            limit 1
		        ) lp on true
		    ),
		    arrears_due_dates as (
		        select
		            due.due_date,
		            pd.decision_id,
		            pd.calculation_date as decision_date,
		            pd.value_pension,
		            pd.times_in_year as decision_times_in_year,
		            pd.period_end_date as decision_period_end_date
		        from pension_arrears_period pap
		        cross join pension_frequency pf
		        cross join last_pension_payment lpp
		        cross join lateral generate_series(
		            1,
		            case
		                when pap.calculation_until is not null
		                 and lpp.last_pension_payment_date is not null
		                 and pf.payment_interval_months is not null
		                 and pap.calculation_until >= lpp.last_pension_payment_date
		                    then greatest(
		                        0,
		                        ceil(
		                            (pap.calculation_until -
		                             lpp.last_pension_payment_date)::numeric
		                            / (28 * pf.payment_interval_months)
		                        )::integer + 2
		                    )
		                else 0
		            end
		        ) n(step_no)
		        cross join lateral (
		            select (
		                lpp.last_pension_payment_date
		                + make_interval(
		                    months => n.step_no * pf.payment_interval_months
		                )
		            )::date as due_date
		        ) due
		        left join lateral (
		            select h.*
		            from pension_decision_history h
		            where h.calculation_date <= due.due_date
		            order by h.calculation_date desc, h.decision_id desc
		            limit 1
		        ) pd on true
		        where pap.suspended_from is not null
		          and pap.calculation_until >= pap.suspended_from
		          and due.due_date >= pap.suspended_from
		          and due.due_date <= pap.calculation_until
		          and (
		              pd.period_end_date is null
		              or due.due_date <= pd.period_end_date
		          )
		    ),
		    arrears_due_months as (
		        select
		            count(*)::integer as due_payments,
		            min(due_date)::date as first_due_payment_date,
		            max(due_date)::date as last_due_payment_date,
		            coalesce(sum(value_pension), 0)::numeric
		                as scheduled_pension_sum,
		            count(*) filter (
		                where decision_id is null or value_pension is null
		            )::integer as missing_decision_due_dates,
		            count(*) filter (
		                where decision_times_in_year is distinct from
		                      (select suspension_times_in_year
		                       from pension_frequency)
		            )::integer as changed_periodicity_due_dates,
		            coalesce(jsonb_agg(
		                jsonb_build_object(
		                    'due_date', due_date,
		                    'decision_id', decision_id,
		                    'decision_date', decision_date,
		                    'value_pension', value_pension,
		                    'times_in_year', decision_times_in_year
		                ) order by due_date
		            ), '[]'::jsonb) as payment_due_details
		        from arrears_due_dates
		    ),
		    refund_aggregates as (
		        select
		            coalesce(sum(t.signed_amount) filter (
		                where t.mnemonics like 'ВЗ Р(ВС)%'
		            ), 0)::numeric as redemption_refunds,
		            coalesce(sum(t.signed_amount) filter (
		                where t.mnemonics like 'ВЗ Р(С)%'
		                   or t.mnemonics like 'ВЗ Р(П)%'
		            ), 0)::numeric as pension_refunds_all_time,
		            count(*) filter (
		                where t.s_ts = 's_vozvrat'
		                  and t.mnemonics not like 'ВЗ Р(ВС)%'
		                  and t.mnemonics not like 'ВЗ Р(С)%'
		                  and t.mnemonics not like 'ВЗ Р(П)%'
		            )::integer as unclassified_refund_transactions
		        from trans_amounts t
		        where t.s_ts = 's_vozvrat'
		    ),
		    pension_arrears as (
		        select
		            ps.suspended_from,
		            ps.status_id as last_payment_status_id,
		            pf.calculation_date as pension_decision_date,
		            pf.period_end_date as pension_period_end_date,
		            pf.payment_type_name,
		            pf.last_pension_amount,
		            pf.times_in_year,
		            pf.suspension_decision_date,
		            pf.suspension_pension_amount,
		            pf.suspension_times_in_year,
		            pf.payment_interval_months,
		            lpp.last_pension_payment_date,
		            lpp.last_pension_operation_name,
		            lpp.last_pension_mnemonics,
		            adm.first_due_payment_date,
		            adm.last_due_payment_date,
		            adm.payment_due_details,
		            adm.scheduled_pension_sum,
		            adm.missing_decision_due_dates,
		            adm.changed_periodicity_due_dates,
		            pap.death_month_last_day,
		            pap.calculation_until,
		            case
		                when dp.death_date is null then null::integer
		                when ps.suspended_from is null
		                  or pap.calculation_until < ps.suspended_from
		                    then 0::integer
		                when pf.suspension_pension_amount is null
		                  or pf.payment_interval_months is null
		                  or lpp.last_pension_payment_date is null
		                  or adm.missing_decision_due_dates > 0
		                  or adm.changed_periodicity_due_dates > 0
		                    then null::integer
		                else adm.due_payments
		            end as due_payments,
		            ra.pension_refunds_all_time as pension_refunds,
		            ra.redemption_refunds as redemption_refunds,
		            ra.unclassified_refund_transactions,
		            case
		                when dp.death_date is null then null::numeric
		                when ps.suspended_from is null
		                  or pap.calculation_until < ps.suspended_from
		                    then greatest(0::numeric,
		                                  coalesce(ra.pension_refunds_all_time, 0))
		                when pf.suspension_pension_amount is null
		                  or pf.payment_interval_months is null
		                  or lpp.last_pension_payment_date is null
		                  or adm.missing_decision_due_dates > 0
		                  or adm.changed_periodicity_due_dates > 0
		                    then null::numeric
		                else greatest(
		                    0::numeric,
		                    adm.scheduled_pension_sum
		                    + coalesce(ra.pension_refunds_all_time, 0)
		                )
		            end as arrears_total
		        from payment_suspension ps
		        cross join pension_frequency pf
		        cross join pension_arrears_period pap
		        cross join arrears_due_months adm
		        cross join last_pension_payment lpp
		        cross join refund_aggregates ra
		        cross join death_period dp
		    ),
		    overpayment_details as (
		    	select
			    	coalesce(jsonb_agg(
			                jsonb_build_object(
			                	'transaction_id', t.transaction_id,
			                	'operation_id', t.operation_id,
			                	'operation_name', t.operation_name,
			                	'mnemonics', t.mnemonics,
			                	'pereplat_source', t.pereplat_source,
		                	'mnemonics_account_side', t.pereplat_mnemonics_side,
			                	'effective_date', t.effective_date,
			                    'direction', t.direction,
			                    'amount', t.trans_amount,
			                    'signed_amount', t.signed_amount
			                ) order by t.effective_date, t.transaction_id, t.direction
			            ), '[]'::jsonb) as details, 
			    	count(*)::integer as transaction_count,
			    	coalesce(
			    		sum(t.signed_amount),
			    		0
			    	)::numeric as total_pereplat
		    	from trans_amounts t
		    	where t.s_ts = 's_pereplat'
		    ),
		    pension_overpayment as (
			    select
			        case
			            when idec.death_date is null then null::numeric
			            else coalesce(od.total_pereplat, 0)
			        end as s_pereplat,
			        (
			        	date_trunc('month', idec.death_date)::date
			        	+ interval '1 month'
			        )::date as period_from,
			        p_calc_date as period_until,
			        od.transaction_count,
			        (od.transaction_count > 0) as overpayment_found,
			        od.details as transaction_details
			    from calc_params cp
			    cross join inheritance_decision idec
			    cross join overpayment_details od
			),
		    ost_pre_calc as (
		        select
		            id,
		            s_ts,
		            mnemonics,
		            operation_name,
		            signed_amount as trans_amount
		        from trans_amounts
		        where s_ts in ('s_vznos', 's_dd', 's_mgd', 's_vosp')
		    ),
		    calc_ost as (
		        select
		            case opc.s_ts
		                when 's_vznos' then opc.trans_amount * cp.k1
		                when 's_dd' then opc.trans_amount * cp.k2
		                when 's_mgd' then opc.trans_amount * cp.k3
		                when 's_vosp' then opc.trans_amount * cp.k2
		            end as amount_with_k,
		            opc.s_ts,
		            opc.mnemonics,
		            opc.id
		        from ost_pre_calc opc
		        cross join coeff_params cp
		    ),
		    calc_ost_by_type as (
		        select
		            s_ts,
		            mnemonics,
		            sum(amount_with_k) as amount_with_k
		        from calc_ost
		        group by s_ts, mnemonics
		    ),
		    ost_priority as (
		        select
		            o.s_ts,
		            o.amount_with_k,
		            o.mnemonics,
		            row_number() over (
		                order by
		                    case o.s_ts
		                        when 's_dd' then 1
		                        when 's_vosp' then 2
		                        when 's_mgd' then 3
		                        when 's_vznos' then 4
		                    end,
		                    o.mnemonics
		            ) as priority
		        from calc_ost_by_type o
		    ),
		    write_off as (
		        select
		            o.priority,
		            o.s_ts,
		            o.amount_with_k,
		            o.mnemonics,
		            cp.s_vypl_per * cp1.k4 as payment_before,
		            least(
		                greatest(o.amount_with_k, 0),
		                greatest(cp.s_vypl_per * cp1.k4, 0)
		            ) as written_off,
		            o.amount_with_k - least(
		                greatest(o.amount_with_k, 0),
		                greatest(cp.s_vypl_per * cp1.k4, 0)
		            ) as amount_after,
		            greatest(
		                cp.s_vypl_per * cp1.k4
		                - least(
		                    greatest(o.amount_with_k, 0),
		                    greatest(cp.s_vypl_per * cp1.k4, 0)
		                ),
		                0
		            ) as payment_left
		        from ost_priority o
		        cross join calc_params cp
		        cross join coeff_params cp1
		        where o.priority = 1
		
		        union all
		
		        select
		            o.priority,
		            o.s_ts,
		            o.amount_with_k,
		            o.mnemonics,
		            w.payment_left as payment_before,
		            least(
		                greatest(o.amount_with_k, 0),
		                greatest(w.payment_left, 0)
		            ) as written_off,
		            o.amount_with_k - least(
		                greatest(o.amount_with_k, 0),
		                greatest(w.payment_left, 0)
		            ) as amount_after,
		            greatest(
		                w.payment_left
		                - least(
		                    greatest(o.amount_with_k, 0),
		                    greatest(w.payment_left, 0)
		                ),
		                0
		            ) as payment_left
		        from write_off w
		        join ost_priority o on o.priority = w.priority + 1
		    ),
		    write_off_json as (
		        select
		            coalesce(
		                jsonb_agg(
		                    jsonb_build_object(
		                        's_ts', w.s_ts,
		                        'mnemonics', w.mnemonics,
		                        'amount_before', w.amount_with_k,
		                        'payment_before', w.payment_before,
		                        'written_off', w.written_off,
		                        'amount_after_kf_d', coalesce((
		                            select r.pension
		                            from actuary.round_calc_res(
		                                v_round_type,
		                                case
		                                    when idec.use_standard_redemption
		                                        then w.amount_after * cp1.kf * cp.d
		                                    else 0::numeric
		                                end,
		                                v_service_type
		                            ) r
		                        ), 0),
		                        'amount_after', w.amount_after,
		                        'payment_left', w.payment_left
		                    ) order by w.priority
		                ),
		                '[]'::jsonb
		            ) as write_off_json
		        from write_off w
		        cross join coeff_params cp1
		        cross join calc_params cp
		        cross join inheritance_decision idec
		    ),
		    calc_vykup as (
		        select
		            case
		                when idec.use_standard_redemption
		                    then v.s_vykup_full * cp.d
		                when idec.inheritance_type = 'EXCLUDED'
		                    then (
		                        par.arrears_total
		                        + coalesce(ra.redemption_refunds, 0)
		                    ) * cp.d
		                when idec.requires_arrears_calculation
		                    then par.arrears_total * cp.d
		                when idec.inheritance_type = 'UNRESOLVED'
		                    then null::numeric
		                else 0::numeric
		            end as s_vykup,
		            case
		                when idec.use_standard_redemption then v.s_vykup_full
		                else null::numeric
		            end as s_vykup_without_share,
		            v.s_vykup_full as s_vykup_before_inheritance_gate
		        from calc_params cp
		        cross join coeff_params cp1
		        cross join inheritance_decision idec
		        cross join pension_arrears par
		        cross join refund_aggregates ra
		        cross join lateral (
		            select
		                greatest(
		                    0,
		                    cp1.k1 * coalesce(cp.s_vznos, 0)
		                    + cp1.k2 * (coalesce(cp.s_dd, 0) + coalesce(cp.s_vosp, 0))
		                    + cp1.k3 * coalesce(cp.s_mgd, 0)
		                    - cp1.k4 * coalesce(cp.s_vypl, 0)
		                    - cp1.k4 * coalesce(cp.s_perevod, 0)
		                ) * cp1.kf
		                + coalesce(ra.redemption_refunds, 0) as s_vykup_full
		        ) v
		    ),
		    sr_npo_prepare as (
		        select
		            greatest(
		                0,
		                cp.s_vznos + cp.s_dd + cp.s_mgd + cp.s_vosp
		                - cp.s_vypl - cp.s_perevod
		                + coalesce(ra.redemption_refunds, 0)
		            )::numeric as raw_balance
		        from calc_params cp
		        cross join refund_aggregates ra
		    ),
		    sr_npo as (
		        select
		            case
		                when idec.use_standard_redemption
		                    then greatest(
		                        0,
		                        sr.raw_balance - coalesce(cv.s_vykup_without_share, 0)
		                    )::numeric
		                else null::numeric
		            end as s_sr,
		            sr.raw_balance,
		            cv.s_vykup_without_share
		        from sr_npo_prepare sr
		        cross join calc_vykup cv
		        cross join inheritance_decision idec
		    ),
		    mapping_diagnostics as (
		        select
		            coalesce(
		                jsonb_agg(
		                    jsonb_build_object(
		                        'direction', direction,
		                        'operation_name', operation_name,
		                        'mnemonics', mnemonics,
		                        'mapped_types', mapped_types
		                    )
		                ),
		                '[]'::jsonb
		            ) as ambiguous_mapping
		        from (
		            select
		                m.direction,
		                m.operation_name,
		                m.mnemonics,
		                array_agg(distinct m.s_ts order by m.s_ts) as mapped_types
		            from trans_mapped m
		            group by m.direction, m.operation_name, m.mnemonics
		            having count(distinct m.s_ts) > 1
		        ) x
		    ),
		    mapping_special_overlap as (
		        select
		            coalesce(jsonb_agg(
		                jsonb_build_object(
		                    'direction', d.direction,
		                    'mnemonics', d.mnemonics,
		                    'mapped_types', d.mapped_types
		                ) order by d.direction, d.mnemonics
		            ), '[]'::jsonb) as details
		        from (
		            select
		                direction,
		                mnemonics,
		                array_agg(distinct s_ts order by s_ts) as mapped_types
		            from settings
		            where s_ts in ('s_vozvrat', 's_pereplat')
		              and mnemonics is not null
		            group by direction, mnemonics
		            having count(distinct s_ts) > 1
		        ) d
		    ),
		    reserve_exclusion_diagnostics as (
		        select
		            jsonb_build_object(
		                'last_status_code', b.last_status_code,
		                'last_status_date', b.last_status_date,
		                'last_operation_before_close', loc.operation_name,
		                'last_operation_id', loc.operation_id,
		                'excluded_transactions', count(t.transaction_id),
		                'excluded_amount', coalesce(sum(t.trans_amount), 0)
		            ) as details
		        from base b
		        left join last_operation_before_close loc on true
		        left join trans_checked t on t.excluded_final_reserve
		        group by
		            b.last_status_code, b.last_status_date,
		            loc.operation_name, loc.operation_id
		    )
		    select
		        case
		            when idec.inheritance_type = 'UNRESOLVED'
		              or cp.d is null
		              or (idec.requires_arrears_calculation and cv.s_vykup is null)
		                then null::numeric
		            else coalesce((
		                select r.pension
		                from actuary.round_calc_res(v_round_type, cv.s_vykup, v_service_type) r
		            ), 0)::numeric
		        end,
		        coalesce((
		            select r.pension
		            from actuary.round_calc_res(v_round_type, cp.s_vznos, v_service_type) r
		        ), 0)::numeric,
		        coalesce((
		            select r.pension
		            from actuary.round_calc_res(v_round_type, cp.s_dd, v_service_type) r
		        ), 0)::numeric,
		        coalesce((
		            select r.pension
		            from actuary.round_calc_res(v_round_type, cp.s_mgd, v_service_type) r
		        ), 0)::numeric,
		        coalesce((
		            select r.pension
		            from actuary.round_calc_res(v_round_type, cp.s_vosp, v_service_type) r
		        ), 0)::numeric,
		        coalesce((
		            select r.pension
		            from actuary.round_calc_res(v_round_type, cp.s_vypl, v_service_type) r
		        ), 0)::numeric,
		        coalesce((
		            select r.pension
		            from actuary.round_calc_res(v_round_type, cp.s_perevod, v_service_type) r
		        ), 0)::numeric,
		        null::numeric as s_finrez,
		        coalesce(cp1.k1, 0)::numeric,
		        coalesce(cp1.k2, 0)::numeric,
		        coalesce(cp1.k3, 0)::numeric,
		        coalesce(cp1.k4, 0)::numeric,
		        coalesce(cp1.kf, 0)::numeric,
		        coalesce(cp.d, 0)::numeric,
		        jsonb_build_object(
		            'credit_included',
		            coalesce(tij.credit_included_json, '[]'::jsonb),
		            'credit_not_included',
		            coalesce(nij.credit_not_included_json, '[]'::jsonb),
		            'debit_included',
		            coalesce(tij.debit_included_json, '[]'::jsonb),
		            'debit_not_included',
		            coalesce(nij.debit_not_included_json, '[]'::jsonb),
		            'write_off',
		            woj.write_off_json,
		            's_sr',
		            jsonb_build_object(
		                'amount', sr.s_sr,
		                'raw_balance', coalesce(sr.raw_balance, 0),
		                's_vykup_without_share', coalesce(sr.s_vykup_without_share, 0),
		                'share_applied', false,
		                'calculation_performed', idec.use_standard_redemption
		            ),
		            'inheritance',
		            jsonb_build_object(
		                'inheritance_on_pay', cp1.inheritance_on_pay,
		                'inheritance_on_accum', cp1.inheritance_on_accum,
		                'on_pay', idec.on_pay,
		                'on_accum', idec.on_accum,
		                'inheritance_type', idec.inheritance_type,
		                'account_phase', idec.account_phase,
		                'last_status_code', idec.last_status_code,
		                'last_status_name', idec.last_status_name,
		                'previous_status_code', idec.previous_status_code,
		                'previous_status_name', idec.previous_status_name,
		                'use_standard_redemption', idec.use_standard_redemption,
		                'inheritance_classification_valid',
		                    idec.inheritance_type <> 'UNRESOLVED',
		                'calculation_warning', idec.calculation_warning,
		                'requires_arrears_calculation',
		                    idec.requires_arrears_calculation,
		                'death_date', idec.death_date,
		                'death_month_start', idec.death_month_start,
		                'death_month_end_exclusive', idec.death_month_end_exclusive,
		                'pay_conflict', idec.pay_conflict,
		                'accum_conflict', idec.accum_conflict,
		                's_vykup_before_inheritance_gate',
		                    cv.s_vykup_before_inheritance_gate
		            ),
		            'pension_arrears',
		            jsonb_build_object(
		                'calculation_required', idec.requires_arrears_calculation,
		                'suspended_from', par.suspended_from,
		                'last_payment_status_id', par.last_payment_status_id,
		                'pension_decision_date', par.pension_decision_date,
		                'pension_period_end_date', par.pension_period_end_date,
		                'payment_type_name', par.payment_type_name,
		                'last_pension_amount', par.last_pension_amount,
		                'suspension_decision_date', par.suspension_decision_date,
		                'suspension_pension_amount', par.suspension_pension_amount,
		                'suspension_times_in_year', par.suspension_times_in_year,
		                'times_in_year', par.times_in_year,
		                'payment_interval_months', par.payment_interval_months,
		                'death_month_last_day', par.death_month_last_day,
		                'calculation_until', par.calculation_until,
		                'due_payments', par.due_payments,
		                'scheduled_pension_sum', par.scheduled_pension_sum,
		                'payment_due_details', par.payment_due_details,
		                'missing_decision_due_dates', par.missing_decision_due_dates,
		                'changed_periodicity_due_dates', par.changed_periodicity_due_dates,
		                'last_pension_payment_date', par.last_pension_payment_date,
		                'last_pension_operation_name', par.last_pension_operation_name,
		                'last_pension_mnemonics', par.last_pension_mnemonics,
		                'first_due_payment_date', par.first_due_payment_date,
		                'last_due_payment_date', par.last_due_payment_date,
		                'pension_refunds_all_time', par.pension_refunds,
		                'redemption_refunds', par.redemption_refunds,
		                'unclassified_refund_transactions',
		                    par.unclassified_refund_transactions,
		                'arrears_before_share', par.arrears_total,
		                'excluded_total_before_share',
		                    case
		                        when idec.inheritance_type = 'EXCLUDED'
		                            then par.arrears_total + coalesce(par.redemption_refunds, 0)
		                        else null::numeric
		                    end,
		                'excluded_calculation_components',
		                    case
		                        when idec.inheritance_type = 'EXCLUDED'
		                            then 'pension_due_during_suspension + pension_refunds_all_time + redemption_refunds_all_time'
		                        else null::text
		                    end,
		                'arrears_included_in_result',
		                    idec.requires_arrears_calculation,
		                'refund_period_source',
		                    'all mapped refunds up to p_calc_date; obligation month not available',
		                'payment_schedule_anchor_source',
		                    'last actual s_vypl before or on suspended_from',
		                'pension_amount_source',
		                    'latest pension_calculation USTN/KORR on each due_date',
		                'error', case
		                    when idec.requires_arrears_calculation
		                     and par.arrears_total is null
		                        then case
		                            when par.changed_periodicity_due_dates > 0
		                                then 'PENSION_PERIODICITY_CHANGED_DURING_SUSPENSION'
		                            when par.missing_decision_due_dates > 0
		                                then 'PENSION_DECISION_MISSING_FOR_DUE_DATE'
		                            else 'ARREARS_INPUTS_INCOMPLETE'
		                        end
		                    else null::text
		                end
		            ),
		            's_pereplat',
		            pov.s_pereplat,
		            'pension_overpayment',
		            jsonb_build_object(
		                's_pereplat', pov.s_pereplat,
		                'amount', pov.s_pereplat,
		                'overpayment_found', pov.overpayment_found,
		                'transaction_count', pov.transaction_count,
		                'period_from', pov.period_from,
		                'period_until', pov.period_until,
		                'transactions', pov.transaction_details,
		                'mapping_source',
		                    'settings_for_redemption_calculation: NPO / FULL / s_pereplat',
		                'period_rule',
		                    'effective_date >= first day of month after death; match either actual account side to debit settings mnemonics',
		                'sign_rule',
		                    'debit + / credit -',
		                'included_in_s_vykup', false,
		                'included_in_s_sr', false
		            ),
		            'mapping_diagnostics',
		            md.ambiguous_mapping,
		            'refund_overpayment_mapping_overlap',
		            mso.details,
		            'reserve_exclusion',
		            red.details,
		            'exception',
		            jsonb_build_object(
		                'error', cp1.details_json,
		                'share_not_found', cp.d is null,
		                'inheritance_warning', idec.calculation_warning,
		                'arrears_input_missing',
		                    idec.requires_arrears_calculation and par.arrears_total is null
		            )
		        )::jsonb as details_json
		    from calc_params cp
		    cross join coeff_params cp1
		    cross join calc_vykup cv
		    cross join write_off_json woj
		    cross join sr_npo sr
		    cross join mapping_diagnostics md
		    cross join mapping_special_overlap mso
		    cross join reserve_exclusion_diagnostics red
		    cross join inheritance_decision idec
		    cross join pension_arrears par
		    cross join pension_overpayment pov
		    left join trans_included_json tij on true
		    left join trans_not_included_json nij on true;
