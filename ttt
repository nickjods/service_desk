select
    t.id as transaction_id,
    t.value,
    t.effective_date,

    s.id as sharer_id,
    s.individual_id,

    ac.owner_sharer_id as credit_sharer_id,
    ac.owner_individual_id as credit_individual_id,

    ad.owner_sharer_id as debit_sharer_id,
    ad.owner_individual_id as debit_individual_id,

    atc.mnemonics as credit_mnemonics,
    atd.mnemonics as debit_mnemonics,

    -- Первый источник: старая схема
    (ad.owner_sharer_id = s.id)
        as debit_sharer_ok,

    -- Второй источник
    (ac.owner_sharer_id = s.id)
        as credit_sharer_ok,

    (ad.owner_individual_id = s.individual_id)
        as debit_individual_ok,

    -- Проверка настроек переплаты
    exists (
        select 1
        from actuary.settings_for_redemption_calculation sc
        where sc.service_type = 'NPO'
          and sc.calculation_type = 'FULL'
          and sc.s_ts = 's_pereplat'
          and sc.direction = 'debit'
          and sc.mnemonics = atd.mnemonics
    ) as debit_mapping_ok

from back_office.transaction t

left join back_office.account ac
    on ac.id = t.credit_account_id

left join back_office.account ad
    on ad.id = t.debit_account_id

left join back_office.account_type atc
    on atc.id = ac.account_type_id

left join back_office.account_type atd
    on atd.id = ad.account_type_id

left join ourpension.sharer s
    on s.id = p_sharer_id

where t.id = 123456; -- Реальный ID из твоего запроса
