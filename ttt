-- DROP FUNCTION actuary.get_af_npo_fl_ul(text, date, date);

CREATE OR REPLACE FUNCTION actuary.get_af_npo_fl_ul(p_name_in_pfr text, p_start_date date, p_end_date date)
 RETURNS TABLE(nn integer, code integer, code_contract integer, code_sharer integer, selfnumber_sharer text, selfnumber_contract text, sign_date date, effective_date date, inpaymentfirst_date date, name_investor text, investor_sharer integer, status_sharer text, sex text, birth_date date, fund text, scheme_contract text, scheme_name text, portfolioinvest text, account_type text, registr_date date, class_sharer integer, oud numeric, segment bigint, value_income numeric, period_income text, assignee_type text, valueinpaymentcontract numeric, get_actuary_rate integer, balance_end numeric, balance_end_ips numeric, balance_transfer numeric, incomevaluetotal numeric, inpayment_value numeric, othertransfer_value numeric, value_pay numeric, condition text, respons text, start_date_pension date, period_pension text, pension_value numeric, indexation bigint, pension_next_pay_date date, suspend_pay_date date, period_pay_pension text, end_date_pension_period date, type integer, fixed_value bigint, actuary_rate numeric, valuereturn numeric, transactioninpaymentvalue1 numeric, transactioninpaymentvalue2 numeric, transactioninpaymentvalue3 numeric, age smallint, type_group text, contract_type integer, pension_count integer, end_date_pay_pension date, sharer_type text, valueinpaymentfirst numeric, balancebypensionstart numeric, fund_source text)
 LANGUAGE plpgsql
 SET work_mem TO '1GB'
AS $function$
	declare
		v_datetime_end timestamp;		
	begin

		if p_start_date is null or p_end_date is null then 
			raise exception 'Inputs dates is NULL';
		end if;
	
	v_datetime_end = p_end_date::timestamp + interval '23 hours 59 minutes';
		
	
		drop table if exists t_sharer_base_npo_af;
	
		create temp table t_sharer_base_npo_af on commit drop as
		
		with eligible_sharer as materialized (
		    select
		        s.id as sharer_id
		    from ourpension.sharer s
		    join ourpension.contract c on c.id = s.contract_id
		    join ourpension.fund f on f.id = c.fund_id
		    left join lateral(
				select distinct on (ssh.sharer_id)
					ssh.sharer_id,
					ssh.code,
					ssh.status_date
				from ourpension.sharer_statuses_history ssh
				where ssh.sharer_id = s.id
					and ssh.status_date < p_start_date
				order by ssh.sharer_id, ssh.status_date desc, ssh.id desc
			) last_before_ssh on true
			left join lateral (
				select
					array_agg(
						t.code
						order by t.status_date desc, t.id desc
					) as codes
				from (
					select
						ssh.id,
						ssh.code,
						ssh.status_date
					from ourpension.sharer_statuses_history ssh
					where ssh.sharer_id = s.id
						and ssh.status_date < v_datetime_end
					order by ssh.status_date desc, ssh.id desc
					limit 2
				) t
			) last_statuses on true
		    where c."service_type" = 'NPO'
				and (p_name_in_pfr is null or f.name_in_pfr = p_name_in_pfr)
				and s.individual_id is not null
				and	(
					last_before_ssh.code in ('HA0','GA0','FA0')
					or exists (
						select 1
						from ourpension.sharer_statuses_history ssh2
						where ssh2.sharer_id = s.id
							and ssh2.code in ('HA0','GA0','FA0')
							and ssh2.status_date >= p_start_date
							and ssh2.status_date < v_datetime_end
						 )
				)
				and not (
					coalesce(last_statuses.codes[1] = 'FA0', false)
					and coalesce(last_statuses.codes[2] = 'IA0', false)
				)
				limit 1
		)
		    select
		        s.id as sharer_id,
		        c.effective_date as contract_effective_date,
		        coalesce(
		        	coalesce(i.counterparty_code_1c, i1.counterparty_code_1c), 
		        	coalesce(i.code_1c, i1.code_1c)
		        ) as code,
		        c.code_1c as contract_code_1c,
		        s.code_1c as sharer_code_1c,
		        s.number as sharer_number,
		        c.number as contract_number,
		        csh_sign.status_date::date as sign_date,
		        ssh_eff.status_date::date as effective_date,
		        case
		            when c.entity_id is null then 'ФЛ'
		            else e.name
		        end as name_investor,
		        case
		            when c.client_type = 0 then 'ФЛ'
		            else 'ЮЛ'
		        end as type_investor,
		        case
		            when c.individual_id is null then 1
		            else null
		        end as investor_sharer,
		        case
		            when coalesce(i.sex, i1.sex) = 'M' then 'M'
		            when coalesce(i.sex, i1.sex) = 'F' then 'Ж'
		        end as sex,
		        coalesce(i.birth_date, i1.birth_date) as birth_date,
		        coalesce(i.sex, i1.sex) as sex_raw,
		        extract(
		            year from age(p_end_date, coalesce(i.birth_date, i1.birth_date))
		        )::smallint as age,
		        f.name_in_pfr,
		        ps0.investment_portfolio_name,
		        case
		            when sp.sharer_type in ('SPS_U', 'SPS_P', 'SPS')
		                then 'СПС'
		            when sp.sharer_type in ('KIPS', 'IPS_P', 'IPS')
		                then 'ИПС'
		        end as account_type,
		        date(s.created) as registr_date,
		        ve.value_income,
		        coalesce(
		            ve.min_actuarial_yield,
		            0
		        ) as get_actuary_rate,
		        sp.min_actuarial_yield * 100 as actuary_rate,
		        'ФЛ'::text as sharer_type,
		        case
		            when edp.times_in_year = 1  then 'год'
		            when edp.times_in_year = 2  then 'полугодие'
		            when edp.times_in_year = 4  then 'квартал'
		            when edp.times_in_year = 12 then 'месяц'
		            else null
		        end as period_pay_pension,
		        edp.times_in_year as pension_count,
		        edp.value_pension as pension_value,
		        case
		            when ssh_tg.code = 'GA0' 
		            	and ssh_tg.status_date < coalesce(edp.period_end_date, '9999-01-01')
		            	and ssh_tg.status_date < coalesce(di.death_date, '9999-01-01')
		            	and ssh_tg.status_date < coalesce(end_pay.date, '9999-01-01')
		            then 'НП'
		            when ssh_tg.code = 'HA0'
		            	and ssh_tg.status_date < coalesce(edp.period_end_date, '9999-01-01')
		            	and ssh_tg.status_date < coalesce(di.death_date, '9999-01-01')
		            	and ssh_tg.status_date < coalesce(end_pay.date, '9999-01-01')
		            then 'ПВ'
		            else 'ПР'
		        end as type_group,
		        sdp.period_start_date as start_date_pension,
		        case
		            when edp.short_name = 'Срочная'
		                then edp.period_end_date
		            else null
		        end as end_date_pension_period,
		        edp.period_end_date as end_date_pay_pension,
		        psh.status_date::date as suspend_pay_date,
		        clas.class_id as contract_type,
		        fl.name_in_pfr as fund,
		        lower(edp.short_name) as period_pension,
		        case
		            when clsh.name = 'Инвестиционный'
		                then 1::integer
		            else 2::integer
		        end as class_sharer,
		        case
		            when clsh.name = 'Инвестиционный'
		             and ssh_tg.code = 'HA0'
		                then 1::integer
		            else 0::integer
		        end as "TYPE",
		        ish.individual_sharer_status,
		        appl_term.appl_term_sharer_id,
		        obligation.obligation_types,
		        di.death_date,
		        transfer_out_all.redemption_sharer_id as transfer_out_all_redemption_sharer_id
		    from eligible_sharer es
		    join ourpension.sharer s on s.id = es.sharer_id
		    join ourpension.contract c on c.id = s.contract_id
		    join ourpension.sharer_params sp on sp.sharer_id = s.id
		    left join ourpension.pension_scheme ps0 on ps0.id = s.scheme_id
		    left join ourpension.entity e on e.id = c.entity_id
		    left join ourpension.individual i on i.id = c.individual_id
		    left join ourpension.individual i1 on i1.id = s.individual_id
		    left join ourpension.fund fl on fl.id = c.sign_fund_id
		    left join ourpension.fund f on f.id = c.fund_id
		    left join lateral (
		        select
		            tcc.sharer_id as redemption_sharer_id,
		            tcc.date as value_date
		        from back_office.termination_contract_calculation tcc
		        where tcc.service_type = 'NPO'
		          and tcc.accepted is not null
		          and tcc.canceled is null
		          and tcc.rejected is null
		          and tcc.date <= p_end_date
		          and tcc.sharer_id = s.id
		        order by tcc.date asc
		        limit 1
		    ) transfer_out_all on true
		    left join lateral (
		        select
		            vpot.label as obligation_types,
		            case
		                when f.date_reorganization is null
		                    then greatest(
		                        poth.start_date,
		                        p_start_date
		                    )
		                else greatest(
		                        poth.start_date,
		                        p_start_date,
		                        f.date_reorganization
		                    )
		            end as status_oblig_start,
		            case
		                when poth.end_date = DATE '9999-01-01'
		                    then null
		                else poth.end_date
		            end as close_status_oblig_end
		        from ourpension.pension_obligation_types_history poth
		        join ourpension.voc_pension_obligation_types vpot on vpot.id = poth.type_id
		        where poth.sharer_id = s.id
		          and poth.end_date >
		              case
		                  when f.date_reorganization is not null
		                      then greatest(
		                          f.date_reorganization,
		                          p_start_date
		                      )
		                  else p_start_date
		              end
		        order by poth.start_date desc
		        limit 1
		    ) obligation on true
		    left join lateral (
		        select
		            psh.status_date
		        from ourpension.payment_statuses_history psh
		        where psh.sharer_id = s.id
		          and psh.status_id = 2
		          and psh.status_date < v_datetime_end
		        order by psh.status_date desc
		        limit 1
		    ) psh on true
		    left join lateral (
		        select
		            case
		                when ish.enum_status_id = 681
		                    then 'Действующий'
		                when ish.enum_status_id = 682
		                    then 'Выбывший'
		                else 'Неопределено'
		            end as individual_sharer_status
		        from ourpension.individual_status_history ish
		        where ish.individual_id = coalesce(i.id, i1.id)
		          and ish.service_type = 'NPO'
		          and v_datetime_end
		              between ish.status_date_start
		                  and coalesce(
		                      ish.status_date_end,
		                      timestamp '9999-01-01'
		                  )
		        order by ish.status_date_start desc
		        limit 1
		    ) ish on true
		    left join lateral (
		        select
		            atcd.sharer_id as appl_term_sharer_id
		        from ourpension.application_termination_contract_data atcd
		        join ourpension.application_termination_contract atc 
		        	on atcd.application_termination_contract_id = atc.id
		        where atcd.sharer_id = s.id
		          and atc.date >= p_start_date
		          and atc.date <  v_datetime_end
		          and atc.rejected is null
		        order by atc.date desc
		        limit 1
		    ) appl_term on true
		    left join lateral (
		        select
		            adi.individual_id,
		            adi.death_date,
		            adi.death_info_date
		        from ourpension.application_death_info adi
		        where adi.accepted is not null
		          and adi.canceled is null
		          and adi.rejected is null
		          and adi.individual_id = i.id
		        order by adi.version desc
		        limit 1
		    ) di on true
		    left join lateral (
		        select
		            cc.name
		        from ourpension.sharer_class_history sch
		        join ourpension.contract_classes cc on cc.id = sch.class_id
		        where sch.sharer_id = s.id
		          and sch.begin_date < v_datetime_end
		        order by sch.begin_date desc
		        limit 1
		    ) clsh on true
		    left join lateral (
		        select
		            cch.class_id
		        from ourpension.contract_class_history cch
		        where cch.contract_id = c.id
		          and cch.begin_date >= p_start_date
		        order by cch.begin_date desc
		        limit 1
		    ) clas on true
		    left join lateral (
		        select
		            pc.period_start_date as date
		        from back_office.pension_calculation pc
		        join ourpension.npo_decision_payment_type ndpt on ndpt.code = pc.npo_decision_payment_type_code
		        join back_office.npo_decision_type ndt on ndt.id = pc.npo_decision_type_id
		        where pc.sharer_id = s.id
		          and pc.calculation_date <= p_end_date
		          and ndt.code = 'ПРЕК'
		        order by pc.calculation_date desc
		        limit 1
		    ) end_pay on true
		    left join lateral (
		        select
		            case
		                when pc.period_start_date > DATE '1992-09-16'
		                 and pc.period_start_date is not null
		                    then pc.period_start_date
		                else pc.calculation_date
		            end as period_start_date,
		            coalesce(
		                pcs1.value_pension,
		                pcs3.value_pension
		            ) as value_pension
		        from back_office.pension_calculation pc
		        left join back_office.pension_calculation_scheme1 pcs1 on pcs1.pension_calculation_id = pc.id
		        left join back_office.pension_calculation_scheme3 pcs3 on pcs3.pension_calculation_id = pc.id
		        join ourpension.npo_decision_payment_type ndpt on ndpt.code = pc.npo_decision_payment_type_code
		        join back_office.npo_decision_type ndt on ndt.id = pc.npo_decision_type_id
		        where pc.sharer_id = s.id
		          and pc.calculation_date <= p_end_date
		          and ndpt.short_name in (
		              'До исчерпания',
		              'Срочная',
		              'Пожизненная'
		          )
		          and ndt.code = 'УСТН'
		        order by pc.calculation_date asc
		        limit 1
		    ) sdp on true
		    left join lateral (
		        select
		            pc.period_end_date,
		            ndpt.short_name,
		            coalesce(
		                pcs1.value_pension,
		                pcs3.value_pension
		            ) as value_pension,
		            coalesce(
		                pcs1.times_in_year,
		                pcs3.times_in_year
		            ) as times_in_year
		        from back_office.pension_calculation pc
		        join ourpension.npo_decision_payment_type ndpt on ndpt.code = pc.npo_decision_payment_type_code
		        join back_office.npo_decision_type ndt on ndt.id = pc.npo_decision_type_id
		        left join back_office.pension_calculation_scheme1 pcs1 on pcs1.pension_calculation_id = pc.id
		        left join back_office.pension_calculation_scheme3 pcs3 on pcs3.pension_calculation_id = pc.id
		        where pc.sharer_id = s.id
		          and pc.calculation_date <= p_end_date
		          and ndpt.short_name in (
		              'До исчерпания',
		              'Срочная',
		              'Пожизненная'
		          )
		          and ndt.code in ('УСТН', 'КОРР')
		        order by pc.calculation_date desc
		        limit 1
		    ) edp on true
		    left join lateral (
		        select
		            ssh.code,
		            ssh.status_date::date
		        from ourpension.sharer_statuses_history ssh
		        where ssh.sharer_id = s.id
		          and ssh.code in ('GA0', 'HA0')
		          and ssh.status_date < v_datetime_end
		        order by
		            ssh.status_date desc,
		            ssh.id desc
		        limit 1
		    ) ssh_tg on true
		    left join lateral (
		        select
		            ssh.status_date
		        from ourpension.sharer_statuses_history ssh
		        where ssh.sharer_id = s.id
		          and ssh.id = 1
		        order by ssh.status_date
		        limit 1
		    ) ssh_eff on true
		    left join lateral (
		        select
		            csh.status_date
		        from ourpension.contract_statuses_history csh
		        where csh.contract_id = c.id
		          and csh.id = 1
		        order by csh.status_date
		        limit 1
		    ) csh_sign on true
		    left join lateral (
		        select
		            case
		                when cp.min_annual_income_period > 0
		                    then cp.min_annual_income_period
		                when cp.min_annual_savings_income > 0
		                    then cp.min_annual_savings_income
		                else 0::numeric
		            end as value_income,
		            cp.min_actuarial_yield
		        from ourpension.contract_params cp
		        where cp.contract_id = c.id
		        limit 1
		    ) ve on true
		    where c."service_type" = 'NPO';
		   
		create index on t_sharer_base_npo_af(sharer_id);
		analyze t_sharer_base_npo_af;
		   
		drop table if exists t_pension_scheme_npo_af;
		create temp table t_pension_scheme_npo_af on commit drop as  
		   
		with sharer_ids as (
		    select
		        array_agg(
		            sb.sharer_id
		            order by sb.sharer_id
		        )::integer[] as sharer_ids
		    from t_sharer_base_npo_af sb
		),
		pension_scheme_raw as (
		    select
		        gps.sharer_id,
		        gps.name,
		        gps.investment_portfolio_name,
		        gps.scheme_rule_name,
		        gps.mgd_accum,
		        gps.mgd_pay,
		        --array_agg(
		        gps.inheritance_on_pay as inheritance_on_pay,
		        --array_agg(
		        gps.inheritance_on_accum as inheritance_on_accum,
		        gps.min_deposit_value,
		        gps.oud
		    from sharer_ids a
		    cross join lateral actuary.get_pension_scheme_for_report(
		        a.sharer_ids,
		        '{}'::integer[],
		        p_start_date,
		        p_end_date,
		        'NPO'
		    ) gps
		   /* group by gps.sharer_id,
		    	gps.name,
		        gps.investment_portfolio_name,
		        gps.scheme_rule_name,
		        gps.mgd_accum,
		        gps.mgd_pay,
		        gps.min_deposit_value,
		        gps.oud*/
		)
			select
		        gps.sharer_id,
		        gps.name as pension_scheme_name,
		        gps.investment_portfolio_name,
		        gps.scheme_rule_name,
		        case
		            when sb.type_group = 'НП'
		                then gps.mgd_accum
		            else 0::numeric
		        end as mgd_accum,
		        case
		            when sb.type_group = 'ПВ'
		                then gps.mgd_pay
		            else 0::numeric
		        end as mgd_pay,
		        case
		            when 'true' = any(gps.inheritance_on_pay)
		             and 'true' = any(gps.inheritance_on_accum)
		                then 'полное'
		            when 'false' = any(gps.inheritance_on_pay)
		             and 'true' = any(gps.inheritance_on_accum)
		                then 'накопительное'
		            when 'false' = any(gps.inheritance_on_pay)
		             and 'false' = any(gps.inheritance_on_accum)
		                then 'нет'
		            else 'нет'
		        end as assignee_type,
		        gps.min_deposit_value as valueInpaymentContract,
		        gps.oud
		    from pension_scheme_raw gps
		    join t_sharer_base_npo_af sb on sb.sharer_id = gps.sharer_id;
		   
		create index on t_pension_scheme_npo_af(sharer_id);
		analyze t_pension_scheme_npo_af;

		drop table if exists t_credit_tx_npo_af;
		create temp table t_credit_tx_npo_af on commit drop as  
		
		    select
		        sb.sharer_id,
		        sb.effective_date as sharer_effective_date,
		        t.effective_date,
		        t.value,
		        ot.code as operation_code
		    from t_sharer_base_npo_af sb
		    join back_office.account a on a.owner_sharer_id = sb.sharer_id
		    join back_office.transaction t on t.credit_account_id = a.id
		    join back_office.operation o on o.id = t.operation_id
		    join back_office.operation_type ot on ot.id = o.operation_type_id
		    where t.effective_date between '1992-09-16'::date and p_end_date
		    	and t.effective_date >= sb.effective_date
		    	and ot.code in (
				    'PENSION_INVESTMENT_REVENUE_ENROLLMENT_PR',
				    'DEPOSIT_ENROLLMENT',
				    'NPO_RETURN_SUCCESSOR_PAYMENT',
				    'NPO_RETURN_RPPO_PENSION_PAYMENT',
				    'NPO_RETURN_REDEMPTION_SUM',
				    'NPO_RETURN_NDFL_REDEMPTION'
		      );
		create index on t_credit_tx_npo_af(sharer_id);
		create index on t_credit_tx_npo_af(sharer_effective_date);
		create index on t_credit_tx_npo_af(effective_date);
		analyze t_credit_tx_npo_af;
		     
		drop table if exists t_debit_tx_npo_af;
		create temp table t_debit_tx_npo_af on commit drop as  
		    select
		        sb.sharer_id,
		        sb.effective_date as sharer_effective_date,
		        t.effective_date,
		        t.value,
		        ot.code as operation_code
		    from t_sharer_base_npo_af sb
		    join back_office.account a on a.owner_sharer_id = sb.sharer_id
		    join back_office.transaction t on t.debit_account_id = a.id
		    join back_office.operation o on o.id = t.operation_id
		    join back_office.operation_type ot on ot.id = o.operation_type_id
		    where t.effective_date between '1992-09-16'::date and p_end_date
				and ot.code in (
					'PAYMENT_PENSION',
					'NPO_NDFL_NONSTATE_PENSION',
					'NPO_WITHHOLDING_UNDER_WRIT_EXECUTION',
					'PAYMENT_TERMINATED',
					'NPO_NDFL_REDEMPTION',
					'PAYMENT_SUCCESSOR',
					'NPO_NDFL_SUCCESSOR'
				);
		create index on t_debit_tx_npo_af(sharer_id);
		create index on t_debit_tx_npo_af(sharer_effective_date);
		create index on t_debit_tx_npo_af(effective_date);
		analyze t_debit_tx_npo_af;
			
			
		
	return query
		with first_inpay_day as (
		    select
		        sb.sharer_id,
		        ct.effective_date::date as effective_date,
		        sum(ct.value) as value_inpayment_first
		    from t_sharer_base_npo_af sb
		    join t_credit_tx_npo_af ct on ct.sharer_id = sb.sharer_id
		    	and ct.operation_code = 'DEPOSIT_ENROLLMENT'
		    where ct.effective_date < v_datetime_end
		    group by
		        sb.sharer_id,
		        ct.effective_date::date
		),
		first_inpay as (
		    select distinct on (f.sharer_id)
		        f.sharer_id,
		        f.effective_date as inpaymentFirst_DATE,
		        f.value_inpayment_first as valueInpaymentFirst
		    from first_inpay_day f
		    order by
		        f.sharer_id,
		        f.effective_date asc
		),
		payments_credit as (
		    select
		        ct.sharer_id,
		        sum(ct.value) filter (
		            where ct.operation_code =
		                  'PENSION_INVESTMENT_REVENUE_ENROLLMENT_PR'
		        ) as incomeValueTotal,
		        sum(ct.value) filter (
		            where ct.operation_code = 'DEPOSIT_ENROLLMENT'
		              and ct.effective_date >= p_start_date
		              and ct.effective_date < v_datetime_end
		        ) as inpayment_value,
		        sum(ct.value) filter (
		            where ct.operation_code = 'DEPOSIT_ENROLLMENT'
		              and ct.effective_date >= p_start_date::date - interval '1 year'
		              and ct.effective_date < p_start_date::date
		        ) as transactionInpaymentValue1,
		        sum(ct.value) filter (
		            where ct.operation_code = 'DEPOSIT_ENROLLMENT'
		              and ct.effective_date >= p_start_date::date - interval '2 year'
		              and ct.effective_date < p_start_date::date - interval '1 year'
		        ) as transactionInpaymentValue2,
		        sum(ct.value) filter (
		            where ct.operation_code = 'DEPOSIT_ENROLLMENT'
		              and ct.effective_date >= p_start_date::date - interval '3 year'
		              and ct.effective_date < p_start_date::date - interval '2 year'
		        ) as transactionInpaymentValue3,
		        sum(-ct.value) filter (
		            where ct.operation_code in (
		                'NPO_RETURN_SUCCESSOR_PAYMENT',
		                'NPO_RETURN_RPPO_PENSION_PAYMENT',
		                'NPO_RETURN_REDEMPTION_SUM',
		                'NPO_RETURN_NDFL_REDEMPTION'
		            )
		            and ct.effective_date >= p_start_date
		            and ct.effective_date < v_datetime_end
		        ) as value_pay
		    from t_credit_tx_npo_af ct
		    group by ct.sharer_id
		),
		payments_debit as (
		    select
		        dt.sharer_id,
		        sum(dt.value) as value_pay
		    from t_debit_tx_npo_af dt
		    where dt.effective_date = dt.sharer_effective_date
		    group by dt.sharer_id
		),
		last_pension_payment as (
		    select
		        dt.sharer_id,
		        max(dt.effective_date) as effective_date
		    from t_debit_tx_npo_af dt
		    where dt.operation_code = 'PAYMENT_PENSION'
		    group by dt.sharer_id
		),
		next_pay_pension_date as (
		    select
		        sb.sharer_id,
		        case
		            when sb.period_pay_pension = 'год'
		                then lpp.effective_date + interval '1 year'
		            when sb.period_pay_pension = 'полугодие'
		                then lpp.effective_date + interval '6 months'
		            when sb.period_pay_pension = 'квартал'
		                then lpp.effective_date + interval '3 months'
		            when sb.period_pay_pension = 'месяц'
		                then lpp.effective_date + interval '1 month'
		            else null
		        end as pension_next_pay_date
		    from t_sharer_base_npo_af sb
		    join last_pension_payment lpp on lpp.sharer_id = sb.sharer_id
		),
		balances as materialized (
		    select
		        sb.sharer_id,
		        greatest(
		            coalesce(
		                sum(
		                    b.total_credit - b.total_debit
		                ) filter (
		                    where b.start_date <= p_end_date
		                      and b.end_date >= p_end_date
		                ),
		                0
		            ),
		            0
		        ) as balance_end,
		        greatest(
		            coalesce(
		                sum(
		                    b.total_credit - b.total_debit
		                ) filter (
		                    where sb.start_date_pension is not null
		                      and b.start_date <= sb.start_date_pension
		                      and b.end_date >= sb.start_date_pension
		                ),
		                0
		            ),
		            0
		        ) as balance_by_pension_start
		    from t_sharer_base_npo_af sb
		    join back_office.account a on a.owner_sharer_id = sb.sharer_id
		    join back_office.balance b on b.account_id = a.id
		     and (
		            (
		                b.start_date <= p_end_date
		                and b.end_date >= p_end_date
		            )
		            OR
		            (
		                sb.start_date_pension is not null
		                and b.start_date <= sb.start_date_pension
		                and b.end_date >= sb.start_date_pension
		            )
		         )
		    group by sb.sharer_id
		),
		sharer_status_calc as (
		    select
		        sb.sharer_id,
		        bal.balance_end as balance_value,
		        case
		            when sb.obligation_types in (
		                    'ОНПП',
		                    'ОНСП',
		                    'ОНИП'
		                 )
		             and sb.suspend_pay_date is not null
		                then 'ПВП'
		            when sb.individual_sharer_status = 'Выбывший'
		             and sb.transfer_out_all_redemption_sharer_id is not null
		                then 'ВС'
		            when coalesce(
		                    sb.end_date_pay_pension,
		                    DATE '2050-01-01'
		                 )
		                 between p_start_date and p_end_date
		             and coalesce(bal.balance_end, 0) = 0
		             and sb.individual_sharer_status = 'Выбывший'
		                then 'ИД'
		            when sb.individual_sharer_status = 'Выбывший'
		             and coalesce(
		                    sb.death_date,
		                    DATE '2050-01-01'
		                 ) < p_end_date
		                then 'СМ'
		            when coalesce(
		                    sb.birth_date,
		                    DATE '1901-01-01'
		                 ) = DATE '1901-01-01'
		                then 'прочие'
		            when sb.obligation_types in (
		                    'ОНПП',
		                    'ОНСП',
		                    'ОНИП'
		                 )
		                then 'ПВ'
		            when
		                case
		                    when sb.sex_raw = 'F'
		                     and sb.sign_date < DATE '2019-01-01'
		                        then sb.birth_date + interval '55 year'
		                    when sb.sex_raw = 'M'
		                     and sb.sign_date < DATE '2019-01-01'
		                        then sb.birth_date + interval '60 year'
		                    when sb.sex_raw = 'F'
		                     and sb.sign_date >= DATE '2019-01-01'
		                        then sb.birth_date
		                           + interval '55 year'
		                           + interval '6 month'
		                    when sb.sex_raw = 'M'
		                     and sb.sign_date >= DATE '2019-01-01'
		                        then sb.birth_date
		                           + interval '60 year'
		                           + interval '6 month'
		                end <= p_end_date
		             and sb.individual_sharer_status = 'Действующий'
		                then 'ВПН'
		            when
		                case
		                    when sb.sex_raw = 'F'
		                     and sb.sign_date < DATE '2019-01-01'
		                        then sb.birth_date + interval '55 year'
		                    when sb.sex_raw = 'M'
		                     and sb.sign_date < DATE '2019-01-01'
		                        then sb.birth_date + interval '60 year'
		                    when sb.sex_raw = 'F'
		                     and sb.sign_date >= DATE '2019-01-01'
		                        then sb.birth_date
		                           + interval '55 year'
		                           + interval '6 month'
		                    when sb.sex_raw = 'M'
		                     and sb.sign_date >= DATE '2019-01-01'
		                        then sb.birth_date
		                           + interval '60 year'
		                           + interval '6 month'
		                end <= p_end_date
		             and sb.individual_sharer_status = 'Выбывший'
		             and sb.appl_term_sharer_id is not null
		             and sb.transfer_out_all_redemption_sharer_id is null
		                then 'ВПН'
		            when sb.individual_sharer_status = 'Действующий'
		                then 'НП'
		            when sb.individual_sharer_status = 'Выбывший'
		             and sb.appl_term_sharer_id is not null
		             and sb.transfer_out_all_redemption_sharer_id is null
		                then 'НП'
		            else 'прочие'
		        end as status_sharer
		    from t_sharer_base_npo_af sb
		    left join balances bal on bal.sharer_id = sb.sharer_id
		),
		res as (
		    select
		        sb.sharer_code_1c::integer as nn,
		        sb.code as code,
		        sb.contract_code_1c::integer as code_contract,
		        sb.sharer_code_1c::integer as code_sharer,
		        sb.sharer_number::text as selfnumber_sharer,
		        sb.contract_number::text as selfnumber_contract,
				sb.sign_date::date as sign_date,
		        sb.effective_date::date as effective_date,
		        fi.inpaymentFirst_DATE::date as inpaymentFirst_DATE,
		        sb.name_investor::text as name_investor,
				sb.investor_sharer::integer as investor_sharer,
		        coalesce(ssc.status_sharer, 'прочие')::text as status_sharer,
		        sb.sex::text as sex,
		        sb.birth_date::date as birth_date,
		        sb.fund::text as fund,
		        coalesce(ps.pension_scheme_name,'БУД_Схема 1')::text as scheme_contract,
		        coalesce(ps.scheme_rule_name,'Схема 1')::text as scheme_name,
		        ps.investment_portfolio_name::text as portfolioInvest,
		        sb.account_type::text as account_type,
		        sb.registr_date::date as registr_date,
		        sb.class_sharer::integer as class_sharer,
		        ps.oud::numeric as oud,
		        null::bigint as segment,
		        coalesce(sb.value_income, 0)::numeric as value_income,
		        case
		            when sb.type_investor = 'ЮЛ'
		                then 'другой период (указать)'
		
		            when sb.type_investor = 'ФЛ'
		                then
		                    case
		                        when coalesce(ps.mgd_accum, 0) >= 0
		                         and coalesce(ps.mgd_pay, 0) >= 0
		                            then 'период действия пенсионного договора'
		                        when coalesce(ps.mgd_accum, 0) > 0
		                         and coalesce(ps.mgd_pay, 0) = 0
		                            then 'период накопления'
		                        when coalesce(ps.mgd_pay, 0) > 0
		                         and coalesce(ps.mgd_accum, 0) = 0
		                            then 'период выплат'
		                        else 'период действия пенсионного договора'
		                    end
		        end::text as period_income,
		        ps.assignee_type::text as assignee_type,
		        ps.valueInpaymentContract::numeric as valueInpaymentContract,
		        sb.get_actuary_rate::integer as get_actuary_rate,
		        bal.balance_end::numeric as balance_end,
		        bal.balance_end::numeric as balance_end_ips,
		        null::numeric as balance_transfer,
		        pc.incomeValueTotal::numeric as incomeValueTotal,
		        pc.inpayment_value::numeric as inpayment_value,
		        null::numeric as othertransfer_value,
		        (coalesce(pd.value_pay, 0) + coalesce(pc.value_pay, 0))::numeric as value_pay,
		        'Фондированная'::text as "condition",
		        case
		            when sb.account_type = 'СПС'
		                then 'Фонд, в пределах остатка счета'
		            when sb.account_type = 'ИПС'
		                then 'Фонд, в объеме обязательств по выплате'
		        end::text as respons,
		        sb.start_date_pension::date as start_date_pension,
		        sb.period_pension::text as period_pension,
		        sb.pension_value::numeric as pension_value,
		        null::bigint as indexation,
		        nppd.pension_next_pay_date::date as pension_next_pay_date,
		        sb.suspend_pay_date::date as suspend_pay_date,
		        sb.period_pay_pension::text as period_pay_pension,
		        sb.end_date_pension_period::date as end_date_pension_period,
		        sb."TYPE"::integer as "TYPE",
		        null::bigint as fixed_value,
		        sb.actuary_rate::numeric as actuary_rate,
		        null::numeric as valueReturn,
		        pc.transactionInpaymentValue1::numeric as transactionInpaymentValue1,
		        pc.transactionInpaymentValue2::numeric as transactionInpaymentValue2,
		        pc.transactionInpaymentValue3::numeric as transactionInpaymentValue3,
		        sb.age::smallint as age,
		        sb.type_group::text as type_group,
		        sb.contract_type::integer as contract_type,
		        sb.pension_count::integer as pension_count,
		        sb.end_date_pay_pension::date as end_date_pay_pension,
		        sb.sharer_type::text as sharer_type,
		        fi.valueInpaymentFirst::numeric as valueInpaymentFirst,
		        bal.balance_by_pension_start::numeric as balanceByPensionStart,
		        sb.name_in_pfr::text as fund_source
		    from t_sharer_base_npo_af sb
		    left join payments_credit pc on pc.sharer_id = sb.sharer_id
		    left join payments_debit pd on pd.sharer_id = sb.sharer_id
		    left join first_inpay fi on fi.sharer_id = sb.sharer_id
		    left join balances bal on bal.sharer_id = sb.sharer_id
		    left join next_pay_pension_date nppd on nppd.sharer_id = sb.sharer_id
		    left join sharer_status_calc ssc on ssc.sharer_id = sb.sharer_id
		    left join t_pension_scheme_npo_af ps on ps.sharer_id = sb.sharer_id
			
			union all
			
			select	
				s.code_1c::integer					as NN,
				e.counterparty_code_1c::integer		as CODE,
				c.code_1c::integer	 				as CODE_CONTRACT,	
				s.code_1c::integer	 				as CODE_SHARER,
				s."number" ::text 					as SELFNUMBER_SHARER,
				c."number"::text	 				as SELFNUMBER_CONTRACT,
				csh_sign.status_date::date			as SIGN_DATE,
				ssh_eff.status_date::date			as EFFECTIVE_DATE,
				first_trans.fdate::date 			as inpaymentFirst_DATE,
				(c.entity_id || e.short_name)::text	as NAME_INVESTOR,
				1::integer							as INVESTOR_SHARER,
				case
		            when ssh_tg.code = 'GA0' then 'НП'::text
		            when ssh_tg.code = 'HA0' then 'ПВ'::text
		            else 'ПР'::text
		        end									as STATUS_SHARER,
				null::text	 						as SEX,
				null::date		 					as BIRTH_DATE,
				f.name_in_pfr::text					as FUND,
				coalesce(ps_pl.pension_scheme_name,'БУД_Схема 1')::text as SCHEME_CONTRACT,
				coalesce(ps_pl.scheme_rule_name,'Схема 1')::text 		as SCHEME_NAME,
				ps_pl.investment_portfolio_name::text		 			as portfolioInvest,
				case
		            when sp.sharer_type in ('SPS_U', 'SPS_P', 'SPS')
		                then 'СПС'
		            when sp.sharer_type in ('KIPS', 'IPS_P', 'IPS')
		                then 'ИПС'
		        end 										as ACCOUNT_TYPE,
				date(s.created)								as REGISTR_DATE,
				case
		            when clsh.name = 'Инвестиционный'
		                then 1::integer
		            else 2::integer
		        end											as CLASS_SHARER,
				ps_pl.oud::numeric 							as OUD,
				null::bigint								as segment,
				coalesce(ve.value_income, 0)::numeric		as VALUE_INCOME,
				null::text									as PERIOD_INCOME,
				case
		            when 'true' = any(ps_pl.inheritance_on_pay)
		             and 'true' = any(ps_pl.inheritance_on_accum)
		                then 'полное'
		            when 'false' = any(ps_pl.inheritance_on_pay)
		             and 'true' = any(ps_pl.inheritance_on_accum)
		                then 'накопительное'
		            when 'false' = any(ps_pl.inheritance_on_pay)
		             and 'false' = any(ps_pl.inheritance_on_accum)
		                then 'нет'
		            else 'нет'
		        end 										as assignee_type,
				ps_pl.min_deposit_value::numeric			as valueInpaymentContract,
				(coalesce(ve.min_actuarial_yield, 0))::integer	as GET_ACTUARY_RATE,
				balance_end.value::numeric					as BALANCE_END,
				0::numeric									as BALANCE_END_IPS,
				0::numeric									as BALANCE_TRANSFER,
				income.value::numeric 						as incomeValueTotal,
				null::numeric 								as INPAYMENT_VALUE,
				null::numeric								as OTHERTRANSFER_VALUE,
				null::numeric 								as VALUE_PAY,
				'Фондированная'::text						as "CONDITION",
				case
					when c.account_management_form = 'JOINT'
					then 'Фонд, в пределах остатка счета'
					when c.account_management_form = 'PERSONAL'
					then 'Фонд, в объеме обязательств по выплате'
				end											as RESPONS,
				null::date									as START_DATE_PENSION,
				null::text									as PERIOD_PENSION,
				null::numeric 								as PENSION_VALUE,
				null::bigint								as INDEXATION,
				null::date									as PENSION_NEXT_PAY_DATE,
				null::date 									as SUSPEND_PAY_DATE,
				null::text									as PERIOD_PAY_PENSION,
				null::date									as END_DATE_PENSION_PERIOD,
				null::integer			 					as "TYPE",
				null::bigint		 						as FIXED_VALUE,
				(sp.min_actuarial_yield * 100)::numeric		as ACTUARY_RATE,
				null::numeric								as valueReturn,
				null::numeric	 							as transactionInpaymentValue1,
				null::numeric	 							as transactionInpaymentValue2,
				null::numeric	 							as transactionInpaymentValue3,
				null::smallint								as AGE,
				case
		            when ssh_tg.code = 'GA0' then 'НП'
		            when ssh_tg.code = 'HA0' then 'ПВ'
		            else 'ПР'
		        end as type_group,
				clas.class_id::integer						as CONTRACT_TYPE,
				null::integer								as PENSION_COUNT,
				null::date									as END_DATE_PAY_PENSION,
				'ЮЛ'::text 									as SHARER_TYPE,
				first_trans.value::numeric 					as valueInpaymentFirst,
				null::numeric								as balanceByPensionStart,
				f1.name_in_pfr::text						as FUND_SOURCE
			from ourpension.contract c
			join ourpension.entity e on c.entity_id = e.id
			left join ourpension.sharer s 
				on s.contract_id = c.id 
				and s.individual_id is null
				and (s.close_date is null or s.close_date >= p_end_date)
			join ourpension.sharer_params sp on sp.sharer_id = s.id
				and sp.sharer_type in ('SPS_U', 'SPS_P', 'SPS', 'KIPS')
			left join ourpension.fund f1 on f1.id = c.sign_fund_id
			left join ourpension.fund f on f.id = c.fund_id
			--left join ourpension.pension_scheme ps on ps.id = c.scheme_id
			left join lateral (
		        select
		            cc.name
		        from ourpension.sharer_class_history sch
		        join ourpension.contract_classes cc on cc.id = sch.class_id
		        where sch.sharer_id = s.id
		          and sch.begin_date < v_datetime_end
		        order by sch.begin_date desc
		        limit 1
		    ) clsh on true
			left join lateral (
				select
					gps.sharer_id,
					gps.contract_id,
					gps.name as pension_scheme_name,
					gps.investment_portfolio_name,
					gps.scheme_rule_name,
					gps.mgd_accum,
					gps.mgd_pay,
					gps.inheritance_on_pay as inheritance_on_pay,
					gps.inheritance_on_accum as inheritance_on_accum,
					gps.min_deposit_value,
					gps.oud
				from actuary.get_pension_scheme_for_report(
					array[s.id]::integer[],
					array[c.id]::integer[],
					p_start_date,
					p_end_date,
					'NPO'
				) gps
				where gps.sharer_id = s.id
					and gps.contract_id = c.id
			) ps_pl on true
			left join lateral (
		        select
		            ssh.code
		        from ourpension.sharer_statuses_history ssh
		        where ssh.sharer_id = s.id
		          and ssh.code in ('GA0', 'HA0')
		          and ssh.status_date < v_datetime_end
		        order by
		            ssh.status_date desc,
		            ssh.id desc
		        limit 1
		    ) ssh_tg on true
			left join lateral(
				select distinct on (a.owner_contract_id)
					a.owner_contract_id,
					t.value,
					t.effective_date as fdate
				from back_office."account" a 
				join back_office."transaction" t on t.credit_account_id = a.id
				join back_office.operation o on o.id = t.operation_id
				where a.owner_contract_id = c.id
					and t.effective_date <= p_end_date
					and o.operation_type_id = 9
				order by a.owner_contract_id, t.effective_date asc
			) first_trans on true
			left join lateral(
				select
					a.owner_contract_id,
					sum(t.value) as value
				from back_office."account" a 
				join back_office."transaction" t on t.credit_account_id = a.id
				join back_office.operation o on o.id = t.operation_id
				where a.owner_contract_id = c.id
					and t.effective_date <= p_end_date
					and o.operation_type_id in (143,89)
				group by a.owner_contract_id
			) income on true
			left join lateral(
				select
					coalesce(sum(b.total_credit - b.total_debit),0) as value
				from back_office.balance b 
				join back_office."account" a on a.id = b.account_id
				where a.owner_contract_id = c.id
					and b.start_date <= p_end_date
					and b.end_date >= p_end_date
			) balance_end on true
			left join lateral(
				select distinct on (cch.contract_id)
					cch.class_id
				from ourpension.contract_class_history cch
				join ourpension.contract_classes cc on cc.id = cch.class_id
				where cch.contract_id = c.id
					and cch.begin_date >= p_start_date
				order by cch.contract_id, cch.begin_date desc
			) clas on true
			left join lateral(
				select
					case
						when cp.min_annual_income_period > 0 then cp.min_annual_income_period
						when cp.min_annual_savings_income > 0 then cp.min_annual_savings_income
						else 0::numeric
					end	as value_income,
					cp.min_actuarial_yield,
					cp.contract_id
				from ourpension.contract_params cp
				where cp.contract_id = c.id
			) ve on true
			left join lateral (
		        select
		            ssh.status_date
		        from ourpension.sharer_statuses_history ssh
		        where ssh.sharer_id = s.id
		          and ssh.id = 1
		        order by ssh.status_date
		        limit 1
		    ) ssh_eff on true
			left join (
				select
					csh.contract_id,
					csh.status_date
				from ourpension.contract_statuses_history csh
				where csh.id = 1
			) csh_sign on csh_sign.contract_id = c.id
			left join lateral (
				select
					1 as has_moves
				from back_office.operation o
				join back_office.transaction t on o.id = t.operation_id 
				left join back_office.account a on t.credit_account_id = a.id
				left join back_office.account a1 on t.debit_account_id = a1.id
				where a.owner_contract_id = c.id
					and t.effective_date between p_start_date and p_end_date
				group by a.owner_contract_id
				limit 1
			) chek_moves on true
			left join lateral (
            	select 1 as is_active
                	where
                    	(
                        	select csh.code
                            from ourpension.contract_statuses_history csh
                            where csh.contract_id = c.id
                            	and csh.status_date < p_start_date
                            order by csh.status_date desc
                            limit 1
                        ) = 'HA0'
                        or
                        exists (
                        	select 1
                            from ourpension.contract_statuses_history csh
                            where csh.contract_id = c.id
                            	and csh.status_date >= p_start_date
                            	and csh.status_date < v_datetime_end
                                and csh.code = 'HA0'
                        )
            ) active_chk on true
            left join lateral (
            	select 1 as is_active
                	where
                    	(
                        	select ssh.code
                            from ourpension.sharer_statuses_history ssh
                            where ssh.sharer_id = s.id
                            	and ssh.status_date < p_start_date
                            order by ssh.status_date desc
                            limit 1
                        ) in ('HA0','GA0','FA0')
                        or
                        exists (
                        	select 1
                            from ourpension.sharer_statuses_history ssh
                            where ssh.sharer_id = s.id
                            	and ssh.status_date >= p_start_date
                            	and ssh.status_date < v_datetime_end
                                and ssh.code in ('HA0','GA0','FA0')
                        )
            ) active_chk_sharer on true
			where c."service_type" = 'NPO'
				--and c.code_1c = 50012679
				and (p_name_in_pfr is null or f.name_in_pfr = p_name_in_pfr)
				and active_chk.is_active = 1
				and active_chk_sharer.is_active = 1
				or (
					chek_moves.has_moves = 1
					or exists (
					    select 1
					    from (
					        select
					            x.dt,
					            sum(x.delta) over (
					                order by x.dt
					            ) as total_balance
					        from (
					            select
					                greatest(b.start_date, p_start_date) as dt,
					                sum(
					                    coalesce(b.total_credit, 0)
					                    - coalesce(b.total_debit, 0)
					                ) as delta
					            from back_office.account a
					            join back_office.balance b
					                on b.account_id = a.id
					            where a.owner_contract_id = c.id
					              and b.start_date <= p_end_date
					              and b.end_date > p_start_date
					            group by 1
					
					            union all
					
					            select
					                b.end_date as dt,
					                -sum(
					                    coalesce(b.total_credit, 0)
					                    - coalesce(b.total_debit, 0)
					                ) as delta
					            from back_office.account a
					            join back_office.balance b
					                on b.account_id = a.id
					            where a.owner_contract_id = c.id
					              and b.start_date <= p_end_date
					              and b.end_date > p_start_date
					              and b.end_date <= p_end_date
					            group by 1
					        ) x
					    ) t
					    where t.total_balance > 0
					)
				)
		)
		select
			*
		from res;
	
	exception when others then
		raise exception 'ERROR: %', sqlerrm;
	
	end;
$function$
;


-- DROP FUNCTION actuary.get_af_pds_fl(text, date, date);

CREATE OR REPLACE FUNCTION actuary.get_af_pds_fl(p_name_in_pfr text, p_start_date date, p_end_date date)
 RETURNS TABLE(code integer, code_sharer integer, code_contract integer, selfnumber_sharer text, selfnumber_contract text, sign_date date, effective_date date, inpaymentfirst_date date, name_investor text, investor_sharer integer, status_sharer text, type_group text, sex text, birth_date date, age smallint, fund text, scheme_contract text, scheme_name text, portfolioinvest text, account_type text, registr_date date, class_sharer integer, contract_type integer, oud numeric, segment bigint, value_income numeric, period_income text, assignee_type text, valueinpaymentcontract numeric, get_actuary_rate integer, balance_end numeric, balance_by_pension numeric, balance_end_ips numeric, balance_transfer numeric, incomevaluetotal numeric, inpayment_value numeric, othertransfer_value numeric, value_pay numeric, "CONDITION" text, respons text, start_date_pension date, period_pension text, pension_value numeric, indexation bigint, pension_next_pay_date date, suspend_pay_date date, period_pay_pension text, pension_count integer, end_date_pay_pension date, end_date_pension_period date, "TYPE" integer, fixed_value bigint, actuary_rate numeric, valuereturn numeric, transactioninpaymentvalue1 numeric, transactioninpaymentvalue2 numeric, transactioninpaymentvalue3 numeric, sharer_type text, valueinpaymentfirst numeric, balancebypensionstart numeric, obligationtypes text, inpayment_ev_value numeric, inpayment_add_value numeric, inpayment_sb_value numeric, date_investment_horizont date, period_investment_horizont integer, value_investment_horizont numeric, datecalcredemption date, check_appl_ev integer, balance_end_ops numeric, countpaypension integer, income_last_value numeric)
 LANGUAGE plpgsql
AS $function$
	declare
		v_datetime_end timestamp;
	begin
		
		if p_start_date is null or p_end_date is null then 
			raise exception 'Inputs dates is NULL';
		end if;
	
	v_datetime_end = p_end_date::timestamp + interval '23 hours 59 minutes';

        drop table if exists t_tx_pds_af;
        create temp table t_tx_pds_af on commit drop as
        select
            s.id as sharer_id,
            t.effective_date,
            t.value,
            ot.code as operation_code,
            o.operation_type_id,
            at2.mnemonics,
            case
                when t.credit_account_id = a.id then 'credit'
                when t.debit_account_id = a.id then 'debit'
            end as direction,
            (t.debit_account_id = a.id) as is_debit_account,
            o.approved,
            o.deleted,
            o.revoked
        from ourpension.sharer s
        join ourpension.contract c
          on c.id = s.contract_id and c.service_type = 'PDS'
        left join ourpension.fund f on f.id = c.fund_id
        join back_office.account a on a.owner_sharer_id = s.id
        join back_office.transaction t
          on a.id in (t.credit_account_id, t.debit_account_id)
        left join back_office.operation o on o.id = t.operation_id
        left join back_office.operation_type ot on ot.id = o.operation_type_id
        left join back_office.account_type at2 on at2.id = a.account_type_id
        where (p_name_in_pfr is null or f.name_in_pfr = p_name_in_pfr)
          and t.effective_date <= p_end_date
          and s.code_1c = 5006805
         ;

        create index on t_tx_pds_af(sharer_id, effective_date);
        analyze t_tx_pds_af;

    drop table if exists t_balance_pds_af;
    create temp table t_balance_pds_af on commit drop as
    select
        s.id as sharer_id,
        a.account_type_id,
        b.start_date,
        b.end_date,
        greatest(sum(b.total_credit - b.total_debit), 0) as balance_value
    from back_office.balance b
    join back_office.account a on a.id = b.account_id
    join ourpension.sharer s on s.id = a.owner_sharer_id
    join ourpension.contract c
      on c.id = s.contract_id and c.service_type = 'PDS'
    left join ourpension.fund f on f.id = c.fund_id
    where (p_name_in_pfr is null or f.name_in_pfr = p_name_in_pfr)
    	and s.code_1c = 5006805
    group by s.id, a.account_type_id, b.start_date, b.end_date;

    create index on t_balance_pds_af(sharer_id, start_date, end_date);
    analyze t_balance_pds_af;

    drop table if exists t_balance_period_pds_af;
    create temp table t_balance_period_pds_af on commit drop as
    select
        b.sharer_id,
        coalesce(sum(b.balance_value) filter (
            where b.start_date <= p_start_date - 1
              and b.end_date >= p_start_date - 1
        ), 0) as balance_start_raw,
        coalesce(sum(b.balance_value) filter (
            where b.start_date <= p_end_date
              and b.end_date >= p_end_date
        ), 0) as balance_end_raw
    from t_balance_pds_af b
    where (b.start_date <= p_start_date - 1 and b.end_date >= p_start_date - 1)
       or (b.start_date <= p_end_date and b.end_date >= p_end_date)
    group by b.sharer_id;

    create unique index on t_balance_period_pds_af(sharer_id);
    analyze t_balance_period_pds_af;

	drop table if exists t_sharer_base_pds_af;
	create temp table t_sharer_base_pds_af on commit drop as
			select
				s.id as sharer_id,
                coalesce(selection_balance.balance_end_raw, 0) as balance_end_raw,
				c.effective_date as contract_effective_date,
				coalesce(i.counterparty_code_1c, i1.counterparty_code_1c) as code,
				c.code_1c as contract_code_1c,
				s.code_1c as sharer_code_1c,
				s.number as sharer_number,
				c.number as contract_number,
				csh_sign.status_date as sign_date,
				ssh_eff.status_date as effective_date,
				case
		            when c.entity_id is null then 'фл'
		            else e.name
		        end as name_investor,
		        case
		            when c.client_type = 0 then 'ФЛ'
		            else 'ЮЛ'
		        end as type_investor,
		        case
		            when c.individual_id is null then 1
		            else null
		        end as investor_sharer,
		        case
		            when coalesce(i.sex, i1.sex) = 'M' then 'м'
		            when coalesce(i.sex, i1.sex) = 'F' then 'ж'
		        end as sex,
		        case
		            when sp.sharer_type = 'SDS' then 'СДС'
		        end as account_type,
		        coalesce(i.birth_date, i1.birth_date) as birth_date,
		        coalesce(i.sex, i1.sex) as sex_raw,
		        extract(
		            year from age(p_end_date, coalesce(i.birth_date, i1.birth_date))
		        )::smallint as age,
				f.name_in_pfr,
				ps.investment_portfolio_name,
				date(s.created) as REGISTR_DATE,
				ve.value_income as value_income,
				coalesce(sp.min_actuarial_yield, 0,01::numeric) * 100 as actuary_rate,
				case
					when ps.inheritance_on_pay = 'true' and ps.inheritance_on_accum = 'true' then 'полное'
					when ps.inheritance_on_pay = 'false' and ps.inheritance_on_accum = 'true' then 'накопительное'
					when ps.inheritance_on_pay = 'false' and ps.inheritance_on_accum = 'false' then 'нет'
					else 'нет'
				end as assignee_type,
				'ФЛ'::text as sharer_type,
				case
		            when edp.times_in_year = 1  then 'год'
		            when edp.times_in_year = 2  then 'полугодие'
		            when edp.times_in_year = 4  then 'квартал'
		            when edp.times_in_year = 12 then 'месяц'
		            else null
		        end as period_pay_pension,
		        edp.times_in_year as pension_count,
		        case
			        when coalesce(edp.short_name, 'Единовременная') != 'Единовременная'
			        then edp.value_pension
			        else null::numeric
			    end as pension_value,
		        case 
       				when extract(year from p_end_date) -
       					extract(year from coalesce(i.birth_date, '1901-01-01')) > 100 
       					then 'ПР'   
        			when obligation.obligation_types = 'ОДНВ' 
        				then 'НП'
        			when obligation.obligation_types = 'ОНППВ' 
        				then 'ПВ'
        			when obligation.obligation_types = 'ОНСПВ' 
        				then 'ПВ'
       				when obligation.obligation_types = 'ППДС' 
       					then 'ПР' 
					else 'ПР' 
				end as type_group, --Группа по виду обязательств
		        sdp.period_start_date as start_date_pension,
		        case
		            when edp.short_name = 'Срочная'
		                then edp.period_end_date
		            else null
		        end as end_date_pension_period,
		        case 
			        when edp.short_name = 'Единовременная' 
			        then null::date 
			        else edp.period_end_date 
			    end as end_date_pay_pension,
		        psh.status_date::date as suspend_pay_date,
		        clas.class_id as contract_type,
		        f1.name_in_pfr as fund,
		        case 
					when edp.short_name = 'Срочная' 
					then 'срочная' 
					when edp.short_name = 'Пожизненная' 
					then 'пожизненная' 
					when obligation.obligation_types = 'ППДС' and edp.short_name = 'Единовременная' 
					then 'единовременно'
				end as period_pension,
		        case
		            when clsh.name = 'Инвестиционный'
		                then 1::integer
		            else 2::integer
		        end as class_sharer,
				coalesce(i.id,i1.id) as individual_id,
				case
					when zev.chek is not null then 1::int
					else 0::int
				end as check_appl_ev,
				case
                	when obligation.close_status_oblig_end != p_end_date then 'ПО'
                 	else
                    	case
                        	when coalesce(i.birth_date, '1901-01-01') <= '1901-01-01' then 'прочие'
                            when coalesce(edp.pension_payment_type_code, '01') != '01' 
                            	and individual_sharer_status.status_text = 'Выбывший' then 'ИД'
                           	when obligation.obligation_types = 'ППДС' 
                           		and transaction_transfer_out_all.redemption_sharer_id is not null then 'ВС'
                         	when obligation.obligation_types = 'ППДС' 
                         		and di.death_date < p_end_date then 'СМ'
                        	when obligation.obligation_types in ('ОНППВ', 'ОНСПВ') then 'ПВ'
                            when obligation.obligation_types = 'ППДС' 
                            	and coalesce(edp.pension_payment_type_code, '') = '01' then 'ПВ'
                            when 
                            	case
                            		when i.sex = 'F' then i.birth_date + interval '55 year'
                                    when i.sex = 'M' then i.birth_date + interval '60 year' 
                                end <= obligation.close_status_oblig_end
                                  	and obligation.obligation_types = 'ОДНВ' then 'ВПН'
                                  	when obligation.obligation_types = 'ОДНВ' then 'НП'
                                  	else 'Прочие'
                         end
                 end as STATUS_SHARER,
                 obligation.obligation_types,
                 obligation.close_status_oblig_end,
                 case 
	                 when coalesce(edp.short_name, 'Единовременная') != 'Единовременная'
	                 then 1::integer 
	                 else 0::integer
	             end as "TYPE", --Тип: 0 -нет, 1-да в сумме остатка, 2 - в фиксированной сумме
                 coalesce(
		            ve.min_actuarial_yield,
		            0
		        ) as get_actuary_rate,
		        fix.fixing_date,
		        case
			        when edp.period_end_date > p_end_date and edp.short_name != 'Единовременная' then
			        	(
			        		(
			        			extract(year from edp.period_end_date)
			        			- extract(year from p_end_date)
			        		) * 12
			        		+ extract(month from edp.period_end_date)
			        		- extract(month from p_end_date)
			        	)::integer
			        else null::integer
			    end as countPayPension
			from ourpension.sharer s
			join ourpension.contract c on c.id = s.contract_id
			join ourpension.sharer_params sp on sp.sharer_id = s.id
			left join ourpension.pension_scheme ps on ps.id = s.scheme_id
			left join ourpension.entity e on c.entity_id = e.id
			left join ourpension.individual i on i.id = s.individual_id
			left join ourpension.individual i1 on i1.id = c.individual_id
			left join ourpension.fund f on f.id = c.fund_id
			left join ourpension.fund f1 on f1.id = c.sign_fund_id
			left join lateral (
            	select distinct on (nfds.sharer_id)
                    nf.fixing_date
                 from back_office.npo_fixing_details nfds
                 join back_office.npo_fixing nf on nf.id = nfds.npo_fixing_id
                 where nf.approved is not null
                 	and nfds.sharer_id = s.id
                    and nf.service_type = 'PDS'
                    --and nf.fixing_type = 'FIXING_BY_PERIOD_IH'
                    and nf.fixing_date <= p_end_date
                 order by nfds.sharer_id, nf.fixing_date desc
            ) fix on true
			left join lateral (
		        select
		            cc.name
		        from ourpension.sharer_class_history sch
		        join ourpension.contract_classes cc on cc.id = sch.class_id
		        where sch.sharer_id = s.id
		          and sch.begin_date < v_datetime_end
		        order by sch.begin_date desc
		        limit 1
		    ) clsh on true
			left join lateral (
		        select
		            cch.class_id
		        from ourpension.contract_class_history cch
		        where cch.contract_id = c.id
		          and cch.begin_date >= p_start_date
		        order by cch.begin_date desc
		        limit 1
		    ) clas on true
			left join lateral (
		        select
		            psh.status_date
		        from ourpension.payment_statuses_history psh
		        where psh.sharer_id = s.id
		          and psh.status_id = 2
		          and psh.status_date < v_datetime_end
		        order by psh.status_date desc
		        limit 1
		    ) psh on true
			left join lateral(
				select
					case
						when cp.min_annual_income_period > 0 then cp.min_annual_income_period
						when cp.min_annual_savings_income > 0 then cp.min_annual_savings_income
						else 0::numeric
					end	as value_income,
					cp.min_actuarial_yield,
					cp.contract_id
				from ourpension.contract_params cp
				where cp.contract_id = c.id
			) ve on true
			left join lateral (
		        select
		        	case 
						when pc.npo_decision_payment_type_code = '01'
						then pc.calculation_date
						when npaa.appeal_date is null 
						then pc.period_start_date
						else npaa.appeal_date
					end period_start_date,
		            coalesce(
		                pcs1.value_pension,
		                pcs3.value_pension
		            ) as value_pension
		        from back_office.pension_calculation pc
		        left join back_office.pension_calculation_scheme1 pcs1 on pcs1.pension_calculation_id = pc.id
		        left join back_office.pension_calculation_scheme3 pcs3 on pcs3.pension_calculation_id = pc.id
		        join ourpension.npo_decision_payment_type ndpt on ndpt.code = pc.npo_decision_payment_type_code
		        join back_office.npo_decision_type ndt on ndt.id = pc.npo_decision_type_id
		        left join ourpension.npo_pension_assignment_application npaa 
		        	on npaa.id = pc.npo_pension_assignment_application_id
		        where pc.sharer_id = s.id
		          and pc.calculation_date <= p_end_date
		          and ndpt.short_name in (
		              'Единовременная',
		              'Срочная',
		              'Пожизненная'
		          )
		          and ndt.code = 'УСТН'
		        order by pc.calculation_date asc
		        limit 1
		    ) sdp on true
		    left join lateral (
		        select
		            pc.period_end_date,
		            ndpt.short_name,
		            pc.npo_decision_payment_type_code as pension_payment_type_code,
		            coalesce(
		                pcs1.value_pension,
		                pcs3.value_pension
		            ) as value_pension,
		            coalesce(
		                pcs1.times_in_year,
		                pcs3.times_in_year
		            ) as times_in_year
		        from back_office.pension_calculation pc
		        join ourpension.npo_decision_payment_type ndpt on ndpt.code = pc.npo_decision_payment_type_code
		        join back_office.npo_decision_type ndt on ndt.id = pc.npo_decision_type_id
		        left join back_office.pension_calculation_scheme1 pcs1 on pcs1.pension_calculation_id = pc.id
		        left join back_office.pension_calculation_scheme3 pcs3 on pcs3.pension_calculation_id = pc.id
		        where pc.sharer_id = s.id
		          and pc.calculation_date <= p_end_date
		          and ndpt.short_name in (
		              'Единовременная',
		              'Срочная',
		              'Пожизненная'
		          )
		          and ndt.code in ('УСТН', 'КОРР')
		        order by pc.calculation_date desc
		        limit 1
		    ) edp on true
            left join lateral (
                select tx.sharer_id as redemption_sharer_id
                from t_tx_pds_af tx
                where tx.sharer_id = s.id
                  and tx.is_debit_account
                  and tx.operation_type_id in (115, 76, 121, 132, 127, 176)
                  and tx.effective_date <= p_start_date
                limit 1
            ) transaction_transfer_out_all on true
			left join lateral (
				select distinct on (poth.sharer_id)
					vpot.label as obligation_types,
                    case 
	                    when poth.end_date = '9999-01-01' 
	                    	then null 
	                    else poth.end_date 
	            	end as close_status_oblig_end
                from ourpension.pension_obligation_types_history poth
                join ourpension.voc_pension_obligation_types vpot on poth.type_id = vpot.id
                where s.id = poth.sharer_id
                	and poth.start_date <= p_end_date
					and (poth.end_date is null or poth.end_date >= p_end_date)
	            order by poth.sharer_id, poth.start_date desc
            ) obligation on true
            left join lateral (
            	select distinct on (adi.individual_id)
            		adi.individual_id,
            		adi.death_date, 
            		adi.death_info_date, 
            		adi.date as death_registration_date
                from ourpension.application_death_info adi
                where adi.accepted is not null
                	and adi.canceled is null
                	and adi.rejected is null
                	and adi.individual_id = i.id
                order by adi.individual_id, adi.version desc
                limit 1
            ) di on true
            left join lateral (
            	select 
            		case
                    	when ish.enum_status_id = 681 then 'Действующий'
                        when ish.enum_status_id = 682 then 'Выбывший'
                        else 'Неопределено' 
                     end as status_text,
                     ish.enum_status_id as status_id
                 from ourpension.individual_status_history ish
                 where ish.individual_id = i.id
                 	and ish.service_type = 'PDS'
                    and p_start_date between ish.status_date_start and coalesce(ish.status_date_end, '9999-01-01')
                 order by ish.status_date_start desc
                 limit 1
            ) individual_sharer_status on true
			left join lateral (
				select distinct on (afotc.sharer_id)
					afotc.accepted as chek
				from ourpension.application_for_one_time_contribution afotc
				where afotc.sharer_id = s.id
					and afotc.accepted is not null
					and afotc.canceled is null
					and afotc.date <= p_end_date
				order by afotc.sharer_id, afotc.date
			) zev on true
			left join (
				select
					ssh.sharer_id,
					ssh.status_date
				from ourpension.sharer_statuses_history ssh
				where ssh.id = 1
			) ssh_eff on ssh_eff.sharer_id = s.id
			left join (
				select
					csh.contract_id,
					csh.status_date
				from ourpension.contract_statuses_history csh
				where csh.id = 1
			) csh_sign on csh_sign.contract_id = c.id
            left join lateral (
                select ssh.code
                from ourpension.sharer_statuses_history ssh
                where ssh.sharer_id = s.id
                  and ssh.status_date < p_start_date + interval '1 day'
                order by ssh.status_date desc, ssh.id desc
                limit 1
            ) last_before_ssh on true
            left join t_balance_period_pds_af selection_balance
                on selection_balance.sharer_id = s.id
            where c.service_type = 'PDS'
              and s.code_1c = 5006805
              and (p_name_in_pfr is null or f.name_in_pfr = p_name_in_pfr)
              and (
                  coalesce(selection_balance.balance_start_raw, 0) <> 0
                  or coalesce(selection_balance.balance_end_raw, 0) <> 0
                  or exists (
                      select 1 from t_tx_pds_af tx
                      where tx.sharer_id = s.id
                        and tx.effective_date >= p_start_date
                  )
                  or last_before_ssh.code in ('KA0','LA0','MA0')
                  or exists (
                      select 1
                      from ourpension.sharer_statuses_history ssh2
                      where ssh2.sharer_id = s.id
                        and ssh2.code in ('MA0','KA0')
                        and ssh2.status_date >= p_start_date
                        and ssh2.status_date < p_end_date + interval '1 day'
                  )
              );
		create index on t_sharer_base_pds_af(sharer_id);
		create index on t_sharer_base_pds_af(individual_id);
		analyze t_sharer_base_pds_af;
	
		drop table if exists t_pension_scheme_pds_af;
		create temp table t_pension_scheme_pds_af on commit drop as
			with sharer_ids as materialized (
			    select
			        array_agg(
			            sb.sharer_id
			            order by sb.sharer_id
			        )::integer[] as sharer_ids
			    from t_sharer_base_pds_af sb
			),
			pension_scheme_raw as materialized (
			    select
			        gps.*
			    from sharer_ids a
			    cross join lateral actuary.get_pension_scheme_for_report(
			        a.sharer_ids,
			        '{}'::integer[],
			        p_start_date,
			        p_end_date,
			        'PDS'
			    ) gps
			)
			    select
			        gps.sharer_id,
			        gps.name as pension_scheme_name,
			        gps."number" as scheme_contract,
			        gps.investment_portfolio_name,
			        gps.scheme_rule_name,
			        case
			            when sb.type_group = 'НП'
			                then gps.mgd_accum
			            else 0::numeric
			        end as mgd_accum,
			        case
			            when sb.type_group = 'ПВ'
			                then gps.mgd_pay
			            else 0::numeric
			        end as mgd_pay,
			        case
			            when 'true' = any(gps.inheritance_on_pay)
			             and 'true' = any(gps.inheritance_on_accum)
			                then 'полное'
			            when 'false' = any(gps.inheritance_on_pay)
			             and 'true' = any(gps.inheritance_on_accum)
			                then 'накопительное'
			            when 'false' = any(gps.inheritance_on_pay)
			             and 'false' = any(gps.inheritance_on_accum)
			                then 'нет'
			            else 'нет'
			        end as assignee_type,
			        gps.min_deposit_value as valueInpaymentContract,
			        gps.oud,
			        gps.period_investment_horizont
			    from pension_scheme_raw gps
			    join t_sharer_base_pds_af sb on sb.sharer_id = gps.sharer_id;
		create index on t_pension_scheme_pds_af(sharer_id);
		analyze t_pension_scheme_pds_af;
		
	return query
		with credit_tx as materialized (
		    select
		        *
		    from t_tx_pds_af
		    where direction = 'credit'
		    	and operation_code in (
		    		'PDS_DEPOSIT_ENROLLMENT_CONTRIBUTIONS',
		            'PDS_DEPOSIT_ENROLLMENT',
					'PDS_OPS_ENROLLMENT_PDS',
					'PDS_OPS_ENROLLMENT_OPS',
					'PDS_GOS_ENROLLMENT',
					'PDS_PENSION_INVESTMENT_REVENUE_ENROLLMENT',
					'PDS_RETURN_NDFL_LUMP_SUM',
					'PDS_RETURN_REDEMPTION_SUM',
					'PDS_RETURN_PERIODIC_PAYMENT',
					'PDS_RETURN_SUCCESSOR_PAYMENT',
					'PDS_RETURN_NDFL_REDEMPTION',
					'PDS_RETURN_NDFL_PERIODIC',
					'PDS_RETURN_NDFL_SUCCESSOR',
					'PDS_RETURN_LUMP_SUM_PAYMENT',
					'PDS_DEPOSIT_ENROLLMENT_FOR_EMPLOYER',
					'PDS_RETURN_PENSION_PAYMENT',
					--
					'GUARANTEE_ENROLLMENT'
					
		      )
		),
		debit_tx as materialized (
			select
		    	*
		    from t_tx_pds_af
		    where direction = 'debit'
		    	and operation_code in (
					'PDS_PENSION_PAYMENT',
					'PDS_NDFL_PENSION_PAYMENT',
					'PDS_REDEMPTION_PAYMENT',
					'PDS_ADDITIONAL_PAYMENT_PP',
					'PDS_REDEMPTION_ENROLLMENT_TO_NPF',
					'PDS_ADDITIONAL_PAYMENT_REDEMPTION',
					'PDS_REP_PAYMENT_TERMINATED',
					'PDS_NDFL_REDEMPTION_PAYMENT',
					'PDS_EV_PAYMENT_CHARGE_FROM_RESERVE',
					'PDS_SUCCESSOR_PAYMENT',
					'PDS_PERIODIC_PAYMENT',
					'PDS_NDFL_REDEMPTION_LIFELONG',
					'PDS_EV_PAYMENT',
					'PDS_NDFL_LUMP_SUM_PAYMENT',
					'PDS_REDEMPTION_LIFELONG_PAYMENT',
					'PDS_REDEMPTION_REDEMPTION_LOSS',
					'PDS_ADDITIONAL_PAYMENT_EV',
					'PDS_NDFL_SUCCESSOR_PAYMENT',
					'PDS_NDFL_PERIODIC_PAYMENT',
					'PDS_TRNSF_TO_INSURED_FUND_REDEMPTION',
					'SECOND_PAYMENT',
					'PDS_SAVINGS_CONTRIB_RETURN',
					--
					'PDS_TRNSF_TO_INSURED_FUND_REDEMPTION',
					'PDS_TRNSF_TO_INSURED_FUND_DECEASED'
				)
		),
		first_inpay_day as materialized (
		    select
		        sb.sharer_id,
		        ct.effective_date::date as effective_date,
		        sum(ct.value) as value_inpayment_first
		    from t_sharer_base_pds_af sb
		    join credit_tx ct on ct.sharer_id = sb.sharer_id
		    	and ct.operation_code in (
		    		'PDS_DEPOSIT_ENROLLMENT',
					'PDS_OPS_ENROLLMENT_PDS',
					'PDS_OPS_ENROLLMENT_OPS',
					'PDS_DEPOSIT_ENROLLMENT_CONTRIBUTIONS',
					'PDS_GOS_ENROLLMENT'
				)
		    group by
		        sb.sharer_id,
		        ct.effective_date::date
		),
		first_inpay as materialized (
		    select distinct on (f.sharer_id)
		        f.sharer_id,
		        f.effective_date as inpaymentFirst_DATE,
		        f.value_inpayment_first as valueInpaymentFirst
		    from first_inpay_day f
		    order by
		        f.sharer_id,
		        f.effective_date asc
		),
		payments_credit as materialized (
		    select
		        ct.sharer_id,
		        sum(ct.value) filter (
		            where ct.operation_code =
		                  'PDS_PENSION_INVESTMENT_REVENUE_ENROLLMENT'
		        ) as incomeValueTotal,
		        sum(ct.value)
					filter(where ct.operation_code = 'PDS_PENSION_INVESTMENT_REVENUE_ENROLLMENT'
							and ct.effective_date 
								between make_date(
									extract(
										year from p_start_date
									)::integer - 1, 1, 1
								)
								and make_date(
									extract(
										year from p_start_date
									)::integer - 1, 12, 31
								)
				) as income_last_value,
				sum(ct.value) filter (
		            where ct.operation_code in (
		            		'PDS_RETURN_LUMP_SUM_PAYMENT',
		            		'PDS_RETURN_NDFL_LUMP_SUM',
		            		'PDS_RETURN_PENSION_PAYMENT',
		            		--''
		            		'PDS_RETURN_PERIODIC_PAYMENT',
		            		'PDS_RETURN_NDFL_PERIODIC'
		            	)
		            	and ct.effective_date <= p_end_date
		        ) as value_return,
				sum(ct.value) filter (
		            where ct.operation_code in (
		            		'PDS_DEPOSIT_ENROLLMENT',
							'PDS_DEPOSIT_ENROLLMENT_FOR_EMPLOYER'
		            	)
		            	and ct.effective_date between p_start_date and p_end_date
		        ) as sber_vznos,
				sum(ct.value) filter (
		            where ct.operation_code = 'PDS_GOS_ENROLLMENT'
		              and ct.effective_date between p_start_date and p_end_date
		        ) as stimul_vznos,
		        sum(ct.value) filter (
		            where ct.operation_code in (
		            	'PDS_DEPOSIT_ENROLLMENT',
						'PDS_OPS_ENROLLMENT_PDS',
						'PDS_OPS_ENROLLMENT_OPS',
						'PDS_DEPOSIT_ENROLLMENT_CONTRIBUTIONS',
						'PDS_GOS_ENROLLMENT'
			          )
		              and ct.effective_date between p_start_date and p_end_date
		        ) as inpayment_value,
		        sum(ct.value) filter (
		            where ct.operation_code in (
		            	'PDS_DEPOSIT_ENROLLMENT',
						'PDS_OPS_ENROLLMENT_PDS',
						'PDS_OPS_ENROLLMENT_OPS',
						'PDS_DEPOSIT_ENROLLMENT_CONTRIBUTIONS',
						'PDS_GOS_ENROLLMENT'
			          )
		              and ct.effective_date >= p_start_date::date - interval '1 year'
		              and ct.effective_date <  p_start_date::date
		        ) as transactionInpaymentValue1,
		        sum(ct.value) filter (
		            where ct.operation_code in (
		            	'PDS_DEPOSIT_ENROLLMENT',
						'PDS_OPS_ENROLLMENT_PDS',
						'PDS_OPS_ENROLLMENT_OPS',
						'PDS_DEPOSIT_ENROLLMENT_CONTRIBUTIONS',
						'PDS_GOS_ENROLLMENT'
			          )
		              and ct.effective_date >= p_start_date::date - interval '2 year'
		              and ct.effective_date <  p_start_date::date - interval '1 year'
		        ) as transactionInpaymentValue2,
		        sum(ct.value) filter (
		            where ct.operation_code in (
		            	'PDS_DEPOSIT_ENROLLMENT',
						'PDS_OPS_ENROLLMENT_PDS',
						'PDS_OPS_ENROLLMENT_OPS',
						'PDS_DEPOSIT_ENROLLMENT_CONTRIBUTIONS',
						'PDS_GOS_ENROLLMENT'
			          )
		              and ct.effective_date >= p_start_date::date - interval '3 year'
		              and ct.effective_date <  p_start_date::date - interval '2 year'
		        ) as transactionInpaymentValue3,
		        sum(-ct.value) filter (
		            where ct.operation_code in (
			                'PDS_RETURN_NDFL_LUMP_SUM',
							'PDS_RETURN_REDEMPTION_SUM',
							'PDS_RETURN_PERIODIC_PAYMENT',
							'PDS_RETURN_SUCCESSOR_PAYMENT',
