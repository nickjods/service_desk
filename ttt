                  outer apply ( 
                  select [balance].[ID_SHARER],sum([balance].[VALUE]) as [VALUE]
                  from (
                                            --I[balance]
                                            select
                                             [balance].[npo_pension_account_id] as [ID_SHARER]
                                            ,[balance].[summ] as [VALUE]
                                            from [DWH].[npf].[npo_pension_account_operation_totals] as [balance] with(nolock)
                                            where [balance].[period]  = '3999-11-01'
                                                 and [pension].[ID_SHARER] is not null 
                                                 and [sharer].[ACCOUNT_TYPE] = N'ИПС'
                                                 and  [balance].[npo_pension_account_id] = [sharer].[ID_SHARER]
                                            
                                            union all

                                            --II [transaction]
                                            select 
                                            [transaction].[npo_pension_account_id] as [ID_SHARER],
                                            case 
                                            when [transaction].[record_kind] = 0 
                                            then - [transaction].[amount] --'CR'
                                            else   [transaction].[amount] --'DB'
                                            end as [VALUE]
                                            from [DWH].[npf].[npo_pension_account_operation] as [transaction] with(nolock)
                                            where [transaction].[is_active] = 1
                                                 and [pension].[ID_SHARER] is not null 
                                                 and [sharer].[ACCOUNT_TYPE] = N'ИПС'
                                                 and  [transaction].[npo_pension_account_id] = [sharer].[ID_SHARER]
                                                 and [transaction].[period_date]  between [pension].[START_DATE_FIRST] and dateAdd(day,-1,'3999-11-01')
                                            ) as [balance]   
                                            group by [balance].[ID_SHARER]
                  ) as [balanceByPensionStart]	


                  outer apply ( 
                  select [balance].[ID_SHARER],sum([balance].[VALUE]) as [VALUE]
                  from (
                                            --I[balance]
                                            select
                                             [balance].[npo_pension_account_id] as [ID_SHARER]
                                            ,[balance].[summ] as [VALUE]
                                            from [DWH].[npf].[npo_pension_account_operation_totals] as [balance] with(nolock)
                                            where [balance].[period]  = '3999-11-01'
                                                 and [pension].[ID_SHARER] is not null 
                                                 and [sharer].[ACCOUNT_TYPE] = N'ИПС'
                                                 and  [balance].[npo_pension_account_id] = [sharer].[ID_SHARER]
                                            
                                            union all

                                            --II [transaction]
                                            select 
                                            [transaction].[npo_pension_account_id] as [ID_SHARER],
                                            case 
                                            when [transaction].[record_kind] = 0 
                                            then - [transaction].[amount] --'CR'
                                            else   [transaction].[amount] --'DB'
                                            end as [VALUE]
                                            from [DWH].[npf].[npo_pension_account_operation] as [transaction] with(nolock)
                                            where [transaction].[is_active] = 1
                                                 and [pension].[ID_SHARER] is not null 
                                                 and [sharer].[ACCOUNT_TYPE] = N'ИПС'
                                                 and  [transaction].[npo_pension_account_id] = [sharer].[ID_SHARER]
                                                 and [transaction].[period_date]  between dateAdd(day,1,[pension].[START_DATE_FIRST]) and dateAdd(day,-1,'3999-11-01')
                                            ) as [balance]   
                                            group by [balance].[ID_SHARER]
