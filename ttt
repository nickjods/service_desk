                 left join #balanceEndContract as [balanceEndContract] on [balanceEndContract].[ID_CONTRACT] = [sharer].[ID_CONTRACT] and [sharer].[SHARER_TYPE] = N'ЮЛ'
                          
                  -- СПС ОбязательстваНаНачалоПериода
