                  left join --[project_xbrl].[npo].[natural]() 
                  #natural as [natural] on [natural].[ID_PERSON] = [sharer].[ID_PERSON]
                  left join [project_xbrl].[npo].[juridical] () as [juridical] on [juridical].[ID_PERSON] = [contract].[ID_PERSON_INVESTOR] 
                                                    and [contract].[TYPE_INVESTOR] = N'ЮЛ'
                  left join --[project_xbrl].[npo].[classSharerDate] (@endDate) 
                  #classSharer as [classSharer] on [classSharer].[ID_SHARER] = [sharer].[ID_SHARER]                                  
                  left join --[project_xbrl].[npo].[classSharerDate] (dateAdd(day,-1,@startDate)) 
                  #classSharerBefore as [classSharerBefore] on [classSharerBefore].[ID_SHARER] = [sharer].[ID_SHARER]                                  
                  left join --[project_xbrl].[npo].[registrPensionDate] (@endDate) 
