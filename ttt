CREATE OR REPLACE FUNCTION actuary.get_balance_by_pension_scheme(
    p_start_date date, p_end_date date, p_service_type text
)
RETURNS TABLE (
    date date, scheme_contract text, portfolioinvest text,
    balancevalue numeric, account_type text, sharer_type text
)
LANGUAGE plpgsql
AS $function$
DECLARE
    v_started_at timestamptz;
    v_rows bigint;
BEGIN
    IF p_start_date IS NULL OR p_end_date IS NULL THEN
        RAISE EXCEPTION 'Inputs dates is NULL';
    END IF;

    -- До записи остатка проверяем обе возможные привязки счета к услуге.
    v_started_at := clock_timestamp();
    CREATE TEMP TABLE tmp_gbbps_balance ON COMMIT DROP AS
    WITH fl_owners AS (
        SELECT s.id AS sharer_id, c.id AS contract_id
        FROM ourpension.sharer s
        JOIN ourpension.contract c ON c.id = s.contract_id
        WHERE s.individual_id IS NOT NULL
          AND c.service_type = p_service_type
    ),
    ul_contracts AS (
        SELECT c.id AS contract_id
        FROM ourpension.contract c
        WHERE c.service_type = p_service_type
          AND EXISTS (
              SELECT 1
              FROM ourpension.sharer s
              WHERE s.contract_id = c.id AND s.individual_id IS NULL
          )
    )
    SELECT fl.sharer_id AS owner_sharer_id, fl.contract_id AS fl_contract_id,
           ul.contract_id AS owner_contract_id,
           b.start_date, b.end_date, b.total_credit - b.total_debit AS amount
    FROM back_office.balance b
    JOIN back_office.account a ON a.id = b.account_id
    LEFT JOIN fl_owners fl ON fl.sharer_id = a.owner_sharer_id
    LEFT JOIN ul_contracts ul ON ul.contract_id = a.owner_contract_id
    WHERE b.start_date <= p_end_date
      AND b.end_date >= p_start_date
      AND (fl.sharer_id IS NOT NULL OR ul.contract_id IS NOT NULL);

    GET DIAGNOSTICS v_rows = ROW_COUNT;
    ANALYZE pg_temp.tmp_gbbps_balance;
    RAISE NOTICE 'Загрузка баланса: % строк, %', v_rows, clock_timestamp() - v_started_at;

    v_started_at := clock_timestamp();

    CREATE TEMP TABLE tmp_gbbps_scheme ON COMMIT DROP AS
    WITH owners AS MATERIALIZED (
        SELECT DISTINCT b.owner_sharer_id AS sharer_id, b.fl_contract_id AS contract_id,
               false AS is_ul
        FROM pg_temp.tmp_gbbps_balance b
        WHERE b.owner_sharer_id IS NOT NULL

        UNION ALL

        SELECT s.id, k.contract_id, true
        FROM (
            SELECT DISTINCT b.owner_contract_id AS contract_id
            FROM pg_temp.tmp_gbbps_balance b
            WHERE b.owner_contract_id IS NOT NULL
        ) k
        JOIN ourpension.sharer s ON s.contract_id = k.contract_id
        WHERE s.individual_id IS NULL
    ),
    -- Каждая непустая ветка дает одну строку аргументов.
    scheme_args AS (
        SELECT o.is_ul,
               array_agg(o.sharer_id::integer ORDER BY o.sharer_id) AS sharer_ids,
               CASE WHEN o.is_ul
                    THEN array_agg(o.contract_id::integer ORDER BY o.sharer_id)
                    ELSE '{}'::integer[]
               END AS contract_ids
        FROM owners o
        GROUP BY o.is_ul
    ),
    scheme_result AS MATERIALIZED (
        SELECT a.is_ul, gps.sharer_id, gps.contract_id,
               gps.name AS scheme_name, gps.investment_portfolio_name AS portfolio
        FROM scheme_args a
        CROSS JOIN LATERAL actuary.get_pension_scheme_for_report(
            a.sharer_ids, a.contract_ids, p_start_date, p_end_date, p_service_type
        ) gps
        WHERE gps.investment_portfolio_name = '1-2025_ПДС - КПП'
    ),
    pension_schemes AS (
        SELECT o.sharer_id, o.contract_id, o.is_ul, r.scheme_name, r.portfolio
        FROM scheme_result r
        JOIN owners o ON o.is_ul = r.is_ul AND o.sharer_id = r.sharer_id
                     AND (NOT o.is_ul OR o.contract_id = r.contract_id)
    )
    SELECT ps.sharer_id, ps.contract_id, ps.is_ul, ps.scheme_name, ps.portfolio,
           CASE WHEN sp.sharer_type IN ('SPS_U', 'SPS_P', 'SPS') THEN 'СПС'
                WHEN sp.sharer_type IN ('KIPS', 'IPS_P', 'IPS') THEN 'ИПС'
                WHEN sp.sharer_type = 'SDS' THEN 'СДС'
           END AS account_form
    FROM pension_schemes ps
    JOIN ourpension.sharer_params sp ON sp.sharer_id = ps.sharer_id;

    GET DIAGNOSTICS v_rows = ROW_COUNT;
    ANALYZE pg_temp.tmp_gbbps_scheme;
    RAISE NOTICE 'Подбор владельцев и пенсионных схем: % строк, %', v_rows, clock_timestamp() - v_started_at;

    v_started_at := clock_timestamp();

    RETURN QUERY
    WITH base AS (
        SELECT b.start_date, b.end_date, b.amount,
               ps.scheme_name, ps.portfolio, ps.account_form, 'ФЛ'::text AS owner_type
        FROM pg_temp.tmp_gbbps_balance b
        JOIN pg_temp.tmp_gbbps_scheme ps ON ps.sharer_id = b.owner_sharer_id
        WHERE NOT ps.is_ul

        UNION ALL

        SELECT b.start_date, b.end_date, b.amount,
               ps.scheme_name, ps.portfolio, ps.account_form, 'ЮЛ'::text
        FROM pg_temp.tmp_gbbps_balance b
        JOIN pg_temp.tmp_gbbps_scheme ps ON ps.contract_id = b.owner_contract_id
        WHERE ps.is_ul
    ),
    daily_movements AS MATERIALIZED (
        SELECT e.dt, b.scheme_name, b.portfolio, b.account_form, b.owner_type,
               sum(e.delta) AS delta
        FROM base b
        CROSS JOIN LATERAL (VALUES
            (greatest(b.start_date, p_start_date), b.amount),
            (CASE WHEN b.end_date < p_end_date THEN b.end_date + 1 END, -b.amount)
        ) e(dt, delta)
        WHERE e.dt IS NOT NULL
        GROUP BY e.dt, b.scheme_name, b.portfolio, b.account_form, b.owner_type
    ),
    groups_in_period AS (
        SELECT DISTINCT m.scheme_name, m.portfolio, m.account_form, m.owner_type
        FROM daily_movements m
    ),
    days AS (
        SELECT p_start_date + n AS dt
        FROM generate_series(0, p_end_date - p_start_date) n
    )
    SELECT d.dt, g.scheme_name::text, g.portfolio::text,
           (sum(m.delta) OVER (
               PARTITION BY g.scheme_name, g.portfolio, g.account_form, g.owner_type
               ORDER BY d.dt ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
           ))::numeric,
           g.account_form::text, g.owner_type
    FROM groups_in_period g
    CROSS JOIN days d
    LEFT JOIN daily_movements m
      ON m.dt = d.dt AND m.scheme_name = g.scheme_name
     AND m.portfolio = g.portfolio AND m.account_form = g.account_form
     AND m.owner_type = g.owner_type
    ORDER BY g.scheme_name, d.dt;

    GET DIAGNOSTICS v_rows = ROW_COUNT;
    RAISE NOTICE 'Расчет по дням: % строк, %', v_rows, clock_timestamp() - v_started_at;

    -- Освобождаем имена для следующего вызова в той же транзакции.
    DROP TABLE pg_temp.tmp_gbbps_scheme, pg_temp.tmp_gbbps_balance;
END;
$function$;
