--Расчёт выкупной суммы участникам по договорам НПО при расторжении.
		if ((p_calc_type = 'FULL' or p_calc_type = 'TRANSFER') and v_service_type = 'NPO') and v_is_nonstandard = false and p_individual_id is null then
			return query 
				with recursive base as (
					select
						s.id,
						s.contract_id,
						case
							when c.individual_id = s.individual_id
							then 'Вкладчик'
							when appl.individual_id = c.individual_id
								and appl.individual_id != s.individual_id 
							then 'Вкладчик'
							when appl.individual_id = s.individual_id 
							then 'Участник'
							else 'Вкладчик'
						end as who
					from ourpension.sharer s
					join ourpension.contract c on c.id = s.contract_id
					left join lateral (
						select distinct on (atc.sharer_id)
							atc.sharer_id,
							atc.application_personal_data_individual_id as individual_id
						from ourpension.application_termination_contract atc
						where atc.sharer_id = s.id
							and atc."date" <= p_calc_date
						order by atc.sharer_id, atc."date" desc, atc."version" desc
					) appl on true
					where s.id = p_sharer_id
				),
				trans_raw_credit as (
					select
						s.id,
						ot.code as operation_name,
						at2.mnemonics,
						sum(t.value) as trans_amount
					from back_office.operation o
					join back_office.transaction t on o.id = t.operation_id 
					join back_office.account a on t.credit_account_id = a.id
					join back_office.account_type at2 on at2.id = a.account_type_id
					join ourpension.sharer s on s.id = a.owner_sharer_id
					join back_office.operation_type ot on ot.id = o.operation_type_id
					where s.id = p_sharer_id
						and t.effective_date <= p_calc_date
						and ot.code in ( 
							select distinct sc.operation_type_code 
			                from actuary.settings_for_redemption_calculation sc
			                where sc."service_type" = 'NPO' 
				                and sc.operation_type_code is not null
				                and sc.calculation_type = 'FULL'
				                and sc.direction = 'credit'
				        )
						and at2.mnemonics in (
							select distinct sc.mnemonics 
			                from actuary.settings_for_redemption_calculation sc
			                where sc."service_type" = 'NPO' 
				                and sc.mnemonics is not null
				                and sc.calculation_type = 'FULL'
				                and sc.direction = 'credit'
				        )
					group by s.id, ot.code, at2.mnemonics
				),
				trans_raw_debit as (
					select
						s.id,
						ot.code as operation_name,
						at2.mnemonics,
						sum(t.value) as trans_amount
					from back_office.operation o
					join back_office.transaction t on o.id = t.operation_id 
					join back_office.account a on t.debit_account_id = a.id
					join back_office.account_type at2 on at2.id = a.account_type_id
					join ourpension.sharer s on s.id = a.owner_sharer_id
					join back_office.operation_type ot on ot.id = o.operation_type_id
					where s.id = p_sharer_id
						and t.effective_date <= p_calc_date
						and ot.code in (
							select distinct sc.operation_type_code 
			                from actuary.settings_for_redemption_calculation sc
			                where sc."service_type" = 'NPO' 
				                and sc.operation_type_code is not null
				                and sc.calculation_type = 'FULL'
				                and sc.direction = 'debit'
						)
					group by s.id, ot.code, at2.mnemonics
				),
				trans_calc_credit as (	
					select
						sum(trc.trans_amount)
							filter(where trc.operation_name in(
											select distinct sc.operation_type_code 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.operation_type_code is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'credit'
								                and sc.s_ts = 's_vznos'
										)
										and trc.mnemonics in (
											select distinct sc.mnemonics 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.mnemonics is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'credit'
								                and sc.s_ts = 's_vznos'
										)
						) as s_vznos,
						sum(trc.trans_amount)
							filter(where trc.operation_name in (
											select distinct sc.operation_type_code 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.operation_type_code is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'credit'
								                and sc.s_ts = 's_dd'
										)
										and trc.mnemonics in (
											select distinct sc.mnemonics 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.mnemonics is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'credit'
								                and sc.s_ts = 's_dd'
										)
						) as s_dd,
						sum(trc.trans_amount)
							filter(where trc.operation_name in (
											select distinct sc.operation_type_code 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.operation_type_code is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'credit'
								                and sc.s_ts = 's_mgd'
										)
										and trc.mnemonics in (
											select distinct sc.mnemonics 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.mnemonics is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'credit'
								                and sc.s_ts = 's_mgd'
										)
						) as s_mgd,
						sum(trc.trans_amount)
							filter(where trc.operation_name in (
											select distinct sc.operation_type_code 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.operation_type_code is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'credit'
								                and sc.s_ts = 's_vosp'
										)
										and trc.mnemonics in (
											select distinct sc.mnemonics 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.mnemonics is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'credit'
								                and sc.s_ts = 's_vosp'
										)
						) as s_vosp,
						sum(-trc.trans_amount)
							filter(where trc.operation_name in (
											select distinct sc.operation_type_code 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.operation_type_code is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'credit'
								                and sc.s_ts = 's_vypl'
										)
						) as s_vypl,
						sum(-trc.trans_amount)
							filter(where trc.operation_name in (
											select distinct sc.operation_type_code 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.operation_type_code is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'credit'
								                and sc.s_ts = 's_perevod'
										)
						) as s_perevod,
						trc.id,
						jsonb_agg(
							jsonb_build_object(
								'mnemonics', trc.mnemonics,
								'amount', trc.trans_amount
							)
							order by
								trc.mnemonics
						) as credit_included_json
					from trans_raw_credit trc
					group by trc.id
				),
				trans_calc_debit as (	
					select
						sum(-trd.trans_amount)
							filter(where trd.operation_name in(
											select distinct sc.operation_type_code 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.operation_type_code is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'debit'
								                and sc.s_ts = 's_vznos'
										)
										and trd.mnemonics in (
											select distinct sc.mnemonics 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.mnemonics is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'debit'
								                and sc.s_ts = 's_vznos'
										)
						) as s_vznos,
						sum(-trd.trans_amount)
							filter(where trd.operation_name in (
											select distinct sc.operation_type_code 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.operation_type_code is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'debit'
								                and sc.s_ts = 's_dd'
										)
										and trd.mnemonics in (
											select distinct sc.mnemonics 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.mnemonics is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'debit'
								                and sc.s_ts = 's_dd'
										)
						) as s_dd,
						sum(-trd.trans_amount)
							filter(where trd.operation_name in (
											select distinct sc.operation_type_code 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.operation_type_code is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'debit'
								                and sc.s_ts = 's_mgd'
										)
										and trd.mnemonics in (
											select distinct sc.mnemonics 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.mnemonics is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'debit'
								                and sc.s_ts = 's_mgd'
										)
						) as s_mgd,
						sum(-trd.trans_amount)
							filter(where trd.operation_name in (
											select distinct sc.operation_type_code 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.operation_type_code is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'debit'
								                and sc.s_ts = 's_vosp'
										)
										and trd.mnemonics in (
											select distinct sc.mnemonics 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.mnemonics is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'debit'
								                and sc.s_ts = 's_vosp'
										)
						) as s_vosp,
						sum(trd.trans_amount)
							filter(where trd.operation_name in (
											select distinct sc.operation_type_code 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.operation_type_code is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'debit'
								                and sc.s_ts = 's_vypl'
										)
						) as s_vypl,
						sum(trd.trans_amount)
							filter(where trd.operation_name in (
											select distinct sc.operation_type_code 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.operation_type_code is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'debit'
								                and sc.s_ts = 's_perevod'
										)
						) as s_perevod,
						trd.id,
						jsonb_agg(
							jsonb_build_object(
								'operation_name', trd.operation_name,
								'amount', trd.trans_amount
							)
							order by trd.operation_name
						) as debit_included_json
					from trans_raw_debit trd
					group by trd.id
				),
				not_included_trans_credit as (
					select
						s.id,
						ot.code as operation_name,
						at2.mnemonics,
						sum(t.value) as trans_amount
					from back_office.operation o
					join back_office.transaction t on o.id = t.operation_id 
					join back_office.account a on t.credit_account_id = a.id
					join back_office.account_type at2 on at2.id = a.account_type_id
					join ourpension.sharer s on s.id = a.owner_sharer_id
					join back_office.operation_type ot on ot.id = o.operation_type_id
					where s.id = p_sharer_id
						and t.effective_date = p_calc_date
						and not exists (
							select 1
							from trans_raw_credit trc
							where trc.operation_name = ot.code
								and trc.mnemonics = at2.mnemonics
						)
					group by s.id, ot.code, at2.mnemonics
				),
				not_included_trans_credit_json as (
					select
						nit.id,
						jsonb_agg(
							jsonb_build_object(
								'mnemonics', nit.mnemonics,
								'amount', nit.trans_amount
							)
							order by
								nit.mnemonics
						) as credit_not_included_json
					from not_included_trans_credit nit
					group by nit.id
				),
				not_included_trans_debit as (
					select
						s.id,
						ot.code as operation_name,
						sum(t.value) as trans_amount
					from back_office.operation o
					join back_office.transaction t on o.id = t.operation_id 
					join back_office.account a on t.debit_account_id = a.id
					join ourpension.sharer s on s.id = a.owner_sharer_id
					join back_office.operation_type ot on ot.id = o.operation_type_id
					where s.id = p_sharer_id
						and t.effective_date = p_calc_date
						and not exists (
							select 1
							from trans_raw_debit trd
							where trd.operation_name = ot.code
						)
					group by s.id, ot.code
				),
				not_included_trans_debit_json as (
					select
						nit.id,
						jsonb_agg(
							jsonb_build_object(
								'operation_name', nit.operation_name,
								'amount', nit.trans_amount
							)
							order by nit.operation_name
						) as debit_not_included_json
					from not_included_trans_debit nit
					group by nit.id
				),
				calc_params as (
					select
						coalesce(tcc.s_vznos, 0) + coalesce(tcd.s_vznos, 0) as s_vznos,
						coalesce(tcc.s_dd, 0) + coalesce(tcd.s_dd, 0) as s_dd,
						coalesce(tcc.s_mgd, 0) + coalesce(tcd.s_mgd, 0) as s_mgd,
						coalesce(tcc.s_vosp, 0) + coalesce(tcd.s_vosp, 0) as s_vosp,
						coalesce(tcc.s_vypl, 0) + coalesce(tcd.s_vypl, 0) as s_vypl,
						coalesce(tcc.s_perevod, 0) + coalesce(tcd.s_perevod, 0) as s_perevod,
						(coalesce(tcc.s_vypl, 0) + coalesce(tcd.s_vypl, 0))
						+ (coalesce(tcc.s_perevod, 0) + coalesce(tcd.s_perevod, 0)) as s_vypl_per
					from base b
					left join trans_calc_credit tcc on tcc.id = b.id
					left join trans_calc_debit tcd on tcd.id = b.id
				),
				coeff_params as (
					select
						coalesce(t.k1, 1)::numeric as k1,
						coalesce(t.k2, 1)::numeric as k2,
						coalesce(t.k3, 1)::numeric as k3,
						coalesce(t.k4, 1)::numeric as k4,
						coalesce(t.kf, 1)::numeric as kf,
						case
							when t.sharer_id is null
                    		then jsonb_build_object('code', 'REDEMPTION_COEFF_NOT_FOUND')
                    		else t.details_json 
                    	end as details_json
					from base b
					left join lateral (
						select
							grc.sharer_id,
							grc.k1,
							grc.k2,
							grc.k3,
							grc.k4,
							grc.kf,
							grc.details_json
						from actuary.get_redemption_coeff(
							b.id, '{}'::integer[], 'NPO', p_calc_date, b.who, null, null
						) grc
						where grc.sharer_id = b.id
					) t on true
				),
				ost_pre_calc as (
					select
						case
							when trc.operation_name in (
														'DEPOSIT_ENROLLMENT',
														'DEPOSIT_ENROLLMENT_REFUND',
														'REDISTRIBUTION_FROM_JOINT_ACCOUNT',
														'REDISTRIBUTION'
														)
								and trc.mnemonics in ('ИПС_ФЛ','ИПС_ЮЛ','ИПС')
							then 's_vznos'
							when trc.operation_name in (
														'PENSION_INVESTMENT_REVENUE_ENROLLMENT_PR',
														'TRANSFER_TO_INSURED_FUND_RESERVE',
														'REDISTRIBUTION_FROM_JOINT_ACCOUNT',
														'REDISTRIBUTION'
														)
								and trc.mnemonics in ('ИПС_ФЛ_ИД','ИПС_ЮЛ_ИД','ИПС ИД')
							then 's_dd'
							when trc.operation_name in (
														'PENSION_INVESTMENT_REVENUE_ENROLLMENT_PR',
														'TRANSFER_TO_INSURED_FUND_RESERVE',
														'NPO_MINIMUM_GUARANTEED_INVESTMENT_INCOME',
														'REDISTRIBUTION_FROM_JOINT_ACCOUNT',
														'REDISTRIBUTION'
														)
								and trc.mnemonics in ('ИПС_ФЛ_ГД','ИПС_ЮЛ_ГД')
							then 's_mgd'
							when trc.operation_name in (
														'GUARANTEE_ENROLLMENT',
														'GUARANTEE_ENROLLMENT_V'
														)
								and trc.mnemonics in ('ГВ ФЛ','ГВ ЮЛ','НПО ГВ ВЮЛ','НПО ГВ ВФЛ')
							then 's_vosp'
						end as s_ts,
						trc.mnemonics,
						trc.trans_amount,
						trc.operation_name,
						trc.id
					from trans_raw_credit trc
				),
				calc_ost as (
					select
						case
							when opc.s_ts = 's_vznos' then opc.trans_amount * cp.k1
							when opc.s_ts = 's_dd' then opc.trans_amount * cp.k2
							when opc.s_ts = 's_mgd' then opc.trans_amount * cp.k3
							when opc.s_ts = 's_vosp' then opc.trans_amount * cp.k2
						end as amount_with_k,
						opc.s_ts,
						opc.mnemonics,
						opc.id
					from ost_pre_calc opc
					cross join coeff_params cp
				),
				calc_ost_by_type as (
					select
						s_ts,
						mnemonics,
						sum(amount_with_k) as amount_with_k
					from calc_ost
					group by s_ts, mnemonics
				),
				ost_priority as (
					select
						o.s_ts,
						o.amount_with_k,
						o.mnemonics,
						row_number() over (
							order by
								case o.s_ts
									when 's_dd'		then 1
									when 's_vosp' 	then 2
									when 's_mgd' 	then 3
									when 's_vznos'	then 4
								end,
								o.mnemonics
						) as priority
					from calc_ost_by_type o
				),
				write_off as (
					select
						o.priority,
						o.s_ts,
						o.amount_with_k,
						o.mnemonics,
						cp.s_vypl_per * cp1.k4 as payment_before,
						least(
							o.amount_with_k,
							greatest(cp.s_vypl_per * cp1.k4, 0)
						) as written_off,
						greatest(
							o.amount_with_k
							-
							least(
								o.amount_with_k,
								greatest(cp.s_vypl_per * cp1.k4, 0)
							),
							0
						) as amount_after,
						greatest(
							cp.s_vypl_per * cp1.k4
							-
							o.amount_with_k,
							0
						) as payment_left
					from ost_priority o
					cross join calc_params cp
					cross join coeff_params cp1
					where o.priority = 1
					
					union all
					
					select
						o.priority,
						o.s_ts,
						o.amount_with_k,
						o.mnemonics,
						w.payment_left as payment_before,
						least(
							o.amount_with_k,
							greatest(w.payment_left, 0)
						) as written_off,
						greatest(
							o.amount_with_k
							-
							least(
								o.amount_with_k,
								greatest(w.payment_left, 0)
							),
							0
						) as amount_after,
						greatest(
							w.payment_left
							-
							o.amount_with_k,
							0
						) as payment_left
					from write_off w
					join ost_priority o on o.priority = w.priority + 1
				),
				write_off_json as (
					select
						coalesce(
							jsonb_agg(
								jsonb_build_object(
									's_ts', 			w.s_ts,
									'mnemonics', 		w.mnemonics,
									'amount_before', 	w.amount_with_k,
									'payment_before', 	w.payment_before,
									'written_off', 		w.written_off,
									'amount_after_kf_d', coalesce((
										select r.pension
										from actuary.round_calc_res(
											v_round_type, 
											w.amount_after * cp.kf,
											v_service_type
										) r
									), 0),
									'amount_after', 	w.amount_after,
									'payment_left',		w.payment_left
								)
								order by w.priority
							),
							'[]'::jsonb
						) as write_off_json
					from write_off w
					cross join coeff_params cp
				),
				calc_vykup as (
					select
						(greatest(0,
							cp1.k1 * coalesce(cp.s_vznos, 0) +
							cp1.k2 * (coalesce(cp.s_dd, 0) + coalesce(cp.s_vosp, 0)) +
							cp1.k3 * coalesce(cp.s_mgd, 0) -
							cp1.k4 * coalesce(cp.s_vypl, 0) -
							cp1.k4 * coalesce(cp.s_perevod, 0)
						) * cp1.kf) as s_vykup
					from calc_params cp
					cross join coeff_params cp1
				),
				sr_npo_prepare as (
       				select 
       					greatest(0,
                    		cp.s_vznos + cp.s_dd + cp.s_mgd + cp.s_vosp
                    		- cp.s_vypl - cp.s_perevod
                    	)::numeric as raw_balance,
               			cp.s_vznos,
               			cp.s_dd,
               			cp.s_mgd,
               			cp.s_vosp,
               			cp.s_vypl,
               			cp.s_perevod
        			from calc_params cp
    			),
    			sr_npo as (
        			select 
	        			greatest(0,
	        				sr.raw_balance - coalesce(cv.s_vykup, 0)
	        			)::numeric as s_sr,
	               		sr.raw_balance,
	               		cv.s_vykup
        			from sr_npo_prepare sr 
        			cross join calc_vykup cv
    			)
				select		
					coalesce((
						select r.pension
						from actuary.round_calc_res(v_round_type, cv.s_vykup, v_service_type) r
						)
					, 0)::numeric,
					coalesce((
						select r.pension
						from actuary.round_calc_res(v_round_type, cp.s_vznos, v_service_type) r
						)
					, 0)::numeric,
					coalesce((
						select r.pension
						from actuary.round_calc_res(v_round_type, cp.s_dd, v_service_type) r
						)
					, 0)::numeric,
					coalesce((
						select r.pension
						from actuary.round_calc_res(v_round_type, cp.s_mgd, v_service_type) r
						)
					, 0)::numeric,
					coalesce((
						select r.pension
						from actuary.round_calc_res(v_round_type, cp.s_vosp, v_service_type) r
						)
					, 0)::numeric,
					coalesce((
						select r.pension
						from actuary.round_calc_res(v_round_type, cp.s_vypl, v_service_type) r
						)
					, 0)::numeric,
					coalesce((
						select r.pension
						from actuary.round_calc_res(v_round_type, cp.s_perevod, v_service_type) r
						)
					, 0)::numeric,
					null::numeric as s_finrez,
					coalesce(cp1.k1, 0)::numeric,
					coalesce(cp1.k2, 0)::numeric,
					coalesce(cp1.k3, 0)::numeric,
					coalesce(cp1.k4, 0)::numeric,
					coalesce(cp1.kf, 0)::numeric,
					null::numeric as d,
					jsonb_build_object(
						'credit_included',
						coalesce(tcc.credit_included_json, '[]'::jsonb),
						'credit_not_included',
						coalesce(nitcj.credit_not_included_json, '[]'::jsonb),
						
						'debit_included',
						coalesce(tcd.debit_included_json, '[]'::jsonb),
						'debit_not_included',
						coalesce(nitdj.debit_not_included_json, '[]'::jsonb),
						'write_off',
						woj.write_off_json,
						's_sr',
						jsonb_build_object(
			                'amount', 
			                coalesce(sr.s_sr, 0),
			                'raw_balance', 
			                coalesce(sr.raw_balance, 0),
			                's_vykup_without_share',
			                coalesce(sr.s_vykup, 0),
			                'share_applied',
			                false
			            ),
						'exception',
						jsonb_build_object(
							'error', cp1.details_json
						)
					)::jsonb as details_json
				from calc_params cp
				cross join coeff_params cp1
				cross join calc_vykup cv
				cross join write_off_json woj
				cross join sr_npo sr
				left join trans_calc_credit tcc on true
				left join trans_calc_debit tcd on true
				left join not_included_trans_credit_json nitcj on true
				left join not_included_trans_debit_json nitdj on true;	
		
		end if;

		--Расчёт выкупной суммы правопреемникам по договорам НПО.
		if (v_service_type = 'NPO' and p_individual_id is not null) and v_is_nonstandard = false then
			return query
				with recursive base as (
					select
						s.id,
						s.contract_id
					from ourpension.sharer s
					where s.id = p_sharer_id
				),
				trans_raw_credit as (
					select
						s.id,
						ot.code as operation_name,
						at2.mnemonics,
						sum(t.value) as trans_amount
					from back_office.operation o
					join back_office.transaction t on o.id = t.operation_id 
					join back_office.account a on t.credit_account_id = a.id
					join back_office.account_type at2 on at2.id = a.account_type_id
					join ourpension.sharer s on s.id = a.owner_sharer_id
					join back_office.operation_type ot on ot.id = o.operation_type_id
					where s.id = p_sharer_id
						and t.effective_date <= p_calc_date
						and ot.code in ( 
							select distinct sc.operation_type_code 
			                from actuary.settings_for_redemption_calculation sc
			                where sc."service_type" = 'NPO' 
				                and sc.operation_type_code is not null
				                and sc.calculation_type = 'FULL'
				                and sc.direction = 'credit'
				        )
						and at2.mnemonics in (
							select distinct sc.mnemonics 
			                from actuary.settings_for_redemption_calculation sc
			                where sc."service_type" = 'NPO' 
				                and sc.mnemonics is not null
				                and sc.calculation_type = 'FULL'
				                and sc.direction = 'credit'
				        )
					group by s.id, ot.code, at2.mnemonics
				),
				trans_raw_debit as (
					select
						s.id,
						ot.code as operation_name,
						at2.mnemonics,
						sum(t.value) as trans_amount
					from back_office.operation o
					join back_office.transaction t on o.id = t.operation_id 
					join back_office.account a on t.debit_account_id = a.id
					join back_office.account_type at2 on at2.id = a.account_type_id
					join ourpension.sharer s on s.id = a.owner_sharer_id
					join back_office.operation_type ot on ot.id = o.operation_type_id
					where s.id = p_sharer_id
						and t.effective_date <= p_calc_date
						and ot.code in (
							select distinct sc.operation_type_code 
			                from actuary.settings_for_redemption_calculation sc
			                where sc."service_type" = 'NPO' 
				                and sc.operation_type_code is not null
				                and sc.calculation_type = 'FULL'
				                and sc.direction = 'debit'
						)
					group by s.id, ot.code, at2.mnemonics
				),
				trans_calc_credit as (	
					select
						sum(trc.trans_amount)
							filter(where trc.operation_name in(
											select distinct sc.operation_type_code 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.operation_type_code is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'credit'
								                and sc.s_ts = 's_vznos'
										)
										and trc.mnemonics in (
											select distinct sc.mnemonics 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.mnemonics is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'credit'
								                and sc.s_ts = 's_vznos'
										)
						) as s_vznos,
						sum(trc.trans_amount)
							filter(where trc.operation_name in (
											select distinct sc.operation_type_code 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.operation_type_code is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'credit'
								                and sc.s_ts = 's_dd'
										)
										and trc.mnemonics in (
											select distinct sc.mnemonics 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.mnemonics is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'credit'
								                and sc.s_ts = 's_dd'
										)
						) as s_dd,
						sum(trc.trans_amount)
							filter(where trc.operation_name in (
											select distinct sc.operation_type_code 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.operation_type_code is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'credit'
								                and sc.s_ts = 's_mgd'
										)
										and trc.mnemonics in (
											select distinct sc.mnemonics 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.mnemonics is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'credit'
								                and sc.s_ts = 's_mgd'
										)
						) as s_mgd,
						sum(trc.trans_amount)
							filter(where trc.operation_name in (
											select distinct sc.operation_type_code 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.operation_type_code is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'credit'
								                and sc.s_ts = 's_vosp'
										)
										and trc.mnemonics in (
											select distinct sc.mnemonics 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.mnemonics is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'credit'
								                and sc.s_ts = 's_vosp'
										)
						) as s_vosp,
						sum(-trc.trans_amount)
							filter(where trc.operation_name in (
											select distinct sc.operation_type_code 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.operation_type_code is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'credit'
								                and sc.s_ts = 's_vypl'
										)
						) as s_vypl,
						sum(-trc.trans_amount)
							filter(where trc.operation_name in (
											select distinct sc.operation_type_code 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.operation_type_code is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'credit'
								                and sc.s_ts = 's_perevod'
										)
						) as s_perevod,
						trc.id,
						jsonb_agg(
							jsonb_build_object(
								'mnemonics', trc.mnemonics,
								'amount', trc.trans_amount
							)
							order by
								trc.mnemonics
						) as credit_included_json
					from trans_raw_credit trc
					group by trc.id
				),
				trans_calc_debit as (	
					select
						sum(-trd.trans_amount)
							filter(where trd.operation_name in(
											select distinct sc.operation_type_code 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.operation_type_code is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'debit'
								                and sc.s_ts = 's_vznos'
										)
										and trd.mnemonics in (
											select distinct sc.mnemonics 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.mnemonics is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'debit'
								                and sc.s_ts = 's_vznos'
										)
						) as s_vznos,
						sum(-trd.trans_amount)
							filter(where trd.operation_name in (
											select distinct sc.operation_type_code 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.operation_type_code is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'debit'
								                and sc.s_ts = 's_dd'
										)
										and trd.mnemonics in (
											select distinct sc.mnemonics 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.mnemonics is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'debit'
								                and sc.s_ts = 's_dd'
										)
						) as s_dd,
						sum(-trd.trans_amount)
							filter(where trd.operation_name in (
											select distinct sc.operation_type_code 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.operation_type_code is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'debit'
								                and sc.s_ts = 's_mgd'
										)
										and trd.mnemonics in (
											select distinct sc.mnemonics 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.mnemonics is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'debit'
								                and sc.s_ts = 's_mgd'
										)
						) as s_mgd,
						sum(-trd.trans_amount)
							filter(where trd.operation_name in (
											select distinct sc.operation_type_code 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.operation_type_code is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'debit'
								                and sc.s_ts = 's_vosp'
										)
										and trd.mnemonics in (
											select distinct sc.mnemonics 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.mnemonics is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'debit'
								                and sc.s_ts = 's_vosp'
										)
						) as s_vosp,
						sum(trd.trans_amount)
							filter(where trd.operation_name in (
											select distinct sc.operation_type_code 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.operation_type_code is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'debit'
								                and sc.s_ts = 's_vypl'
										)
						) as s_vypl,
						sum(trd.trans_amount)
							filter(where trd.operation_name in (
											select distinct sc.operation_type_code 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'NPO' 
								                and sc.operation_type_code is not null
								                and sc.calculation_type = 'FULL'
								                and sc.direction = 'debit'
								                and sc.s_ts = 's_perevod'
										)
						) as s_perevod,
						trd.id,
						jsonb_agg(
							jsonb_build_object(
								'operation_name', trd.operation_name,
								'amount', trd.trans_amount
							)
							order by trd.operation_name
						) as debit_included_json
					from trans_raw_debit trd
					group by trd.id
				),
				not_included_trans_credit as (
					select
						s.id,
						ot.code as operation_name,
						at2.mnemonics,
						sum(t.value) as trans_amount
					from back_office.operation o
					join back_office.transaction t on o.id = t.operation_id 
					join back_office.account a on t.credit_account_id = a.id
					join back_office.account_type at2 on at2.id = a.account_type_id
					join ourpension.sharer s on s.id = a.owner_sharer_id
					join back_office.operation_type ot on ot.id = o.operation_type_id
					where s.id = p_sharer_id
						and t.effective_date = p_calc_date
						and ot.code not in (select operation_name from trans_raw_credit)
						and at2.mnemonics not in (select mnemonics from trans_raw_credit)
					group by s.id, ot.code, at2.mnemonics
				),
				not_included_trans_credit_json as (
					select
						nit.id,
						jsonb_agg(
							jsonb_build_object(
								'mnemonics', nit.mnemonics,
								'amount', nit.trans_amount
							)
							order by nit.mnemonics
						) as credit_not_included_json
					from not_included_trans_credit nit
					group by nit.id
				),
				not_included_trans_debit as (
					select
						s.id,
						ot.code as operation_name,
						sum(t.value) as trans_amount
					from back_office.operation o
					join back_office.transaction t on o.id = t.operation_id 
					join back_office.account a on t.debit_account_id = a.id
					join ourpension.sharer s on s.id = a.owner_sharer_id
					join back_office.operation_type ot on ot.id = o.operation_type_id
					where s.id = p_sharer_id
						and t.effective_date = p_calc_date
						and not exists (
							select 1
							from trans_raw_debit trd
							where trd.operation_name = ot.code
						)
					group by s.id, ot.code
				),
				not_included_trans_debit_json as (
					select
						nit.id,
							jsonb_agg(
							jsonb_build_object(
								'operation_name', nit.operation_name,
								'amount', nit.trans_amount
							)
							order by nit.operation_name
						) as debit_not_included_json
					from not_included_trans_debit nit
					group by nit.id
				),
				successors_share as (
					select
						a.d,
						s.id
					from ourpension.sharer s
					join ourpension.contract c on c.id = s.contract_id
					left join lateral (
						select distinct on (coalesce(ipd.sharer_id, ip.sharer_id))
							coalesce(ipd.sharer_id, ip.sharer_id),
							(ip.share_numerator::numeric / ip.share_denominator::numeric) as d
						from ourpension.inherited_payment ip
						left join ourpension.inherited_payment_data ipd on ipd.inherited_payment_id = ip.id
						where s.id = coalesce(ipd.sharer_id, ip.sharer_id)
							and ip.inheritor_id = p_individual_id
							and ip."date" <= p_calc_date
						order by coalesce(ipd.sharer_id, ip.sharer_id), ip."date" desc
					) a on true
					where s.id = p_sharer_id
				),
				calc_params as (
					select
						coalesce(tcc.s_vznos, 0) + coalesce(tcd.s_vznos, 0) as s_vznos,
						coalesce(tcc.s_dd, 0) + coalesce(tcd.s_dd, 0) as s_dd,
						coalesce(tcc.s_mgd, 0) + coalesce(tcd.s_mgd, 0) as s_mgd,
						coalesce(tcc.s_vosp, 0) + coalesce(tcd.s_vosp, 0) as s_vosp,
						coalesce(tcc.s_vypl, 0) + coalesce(tcd.s_vypl, 0) as s_vypl,
						coalesce(tcc.s_perevod, 0) + coalesce(tcd.s_perevod, 0) as s_perevod,
						(coalesce(tcc.s_vypl, 0) + coalesce(tcd.s_vypl, 0))
						+ (coalesce(tcc.s_perevod, 0) + coalesce(tcd.s_perevod, 0)) as s_vypl_per,
						ss.d
					from base b
					left join trans_calc_credit tcc on tcc.id = b.id
					left join trans_calc_debit tcd on tcd.id = b.id
					left join successors_share ss on ss.id = b.id
				),
				coeff_params as (
					select
						coalesce(t.k1, 1)::numeric as k1,
						coalesce(t.k2, 1)::numeric as k2,
						coalesce(t.k3, 1)::numeric as k3,
						coalesce(t.k4, 1)::numeric as k4,
						coalesce(t.kf, 1)::numeric as kf,
						case
							when t.sharer_id is null
                    		then jsonb_build_object('code', 'REDEMPTION_COEFF_NOT_FOUND')
                    		else t.details_json 
                    	end as details_json
					from base b
					left join lateral (
						select
							grc.sharer_id,
							grc.k1,
							grc.k2,
							grc.k3,
							grc.k4,
							grc.kf,
							grc.details_json
						from actuary.get_redemption_coeff(
							b.id, '{}'::integer[], 'NPO', p_calc_date, 'Правопреемники', null, null
						) grc
						where grc.sharer_id = b.id
					) t on true
				),
				ost_pre_calc as (
					select
						case
							when trc.operation_name in (
														'DEPOSIT_ENROLLMENT',
														'DEPOSIT_ENROLLMENT_REFUND',
														'REDISTRIBUTION_FROM_JOINT_ACCOUNT',
														'REDISTRIBUTION'
														)
								and trc.mnemonics in ('ИПС_ФЛ','ИПС_ЮЛ','ИПС')
							then 's_vznos'
							when trc.operation_name in (
														'PENSION_INVESTMENT_REVENUE_ENROLLMENT_PR',
														'TRANSFER_TO_INSURED_FUND_RESERVE',
														'REDISTRIBUTION_FROM_JOINT_ACCOUNT',
														'REDISTRIBUTION'
														)
								and trc.mnemonics in ('ИПС_ФЛ_ИД','ИПС_ЮЛ_ИД','ИПС ИД')
							then 's_dd'
							when trc.operation_name in (
														'PENSION_INVESTMENT_REVENUE_ENROLLMENT_PR',
														'TRANSFER_TO_INSURED_FUND_RESERVE',
														'NPO_MINIMUM_GUARANTEED_INVESTMENT_INCOME',
														'REDISTRIBUTION_FROM_JOINT_ACCOUNT',
														'REDISTRIBUTION'
														)
								and trc.mnemonics in ('ИПС_ФЛ_ГД','ИПС_ЮЛ_ГД')
							then 's_mgd'
							when trc.operation_name in (
														'GUARANTEE_ENROLLMENT',
														'GUARANTEE_ENROLLMENT_V'
														)
								and trc.mnemonics in ('ГВ ФЛ','ГВ ЮЛ','НПО ГВ ВЮЛ','НПО ГВ ВФЛ')
							then 's_vosp'
						end as s_ts,
						trc.mnemonics,
						trc.trans_amount,
						trc.operation_name,
						trc.id
					from trans_raw_credit trc
				),
				calc_ost as (
					select
						case
							when opc.s_ts = 's_vznos' then opc.trans_amount * cp.k1
							when opc.s_ts = 's_dd' then opc.trans_amount * cp.k2
							when opc.s_ts = 's_mgd' then opc.trans_amount * cp.k3
							when opc.s_ts = 's_vosp' then opc.trans_amount * cp.k2
						end as amount_with_k,
						opc.s_ts,
						opc.mnemonics,
						opc.id
					from ost_pre_calc opc
					cross join coeff_params cp
				),
				calc_ost_by_type as (
					select
						s_ts,
						mnemonics,
						sum(amount_with_k) as amount_with_k
					from calc_ost
					group by s_ts, mnemonics
				),
				ost_priority as (
					select
						o.s_ts,
						o.amount_with_k,
						o.mnemonics,
						row_number() over (
							order by
								case o.s_ts
									when 's_dd'		then 1
									when 's_vosp' 	then 2
									when 's_mgd' 	then 3
									when 's_vznos'	then 4
								end,
								o.mnemonics
						) as priority
					from calc_ost_by_type o
				),
				write_off as (
					select
						o.priority,
						o.s_ts,
						o.amount_with_k,
						o.mnemonics,
						cp.s_vypl_per * cp1.k4 as payment_before,
						least(
							o.amount_with_k,
							greatest(cp.s_vypl_per * cp1.k4, 0)
						) as written_off,
						greatest(
							o.amount_with_k
							-
							least(
								o.amount_with_k,
								greatest(cp.s_vypl_per * cp1.k4, 0)
							),
							0
						) as amount_after,
						greatest(
							cp.s_vypl_per * cp1.k4
							-
							o.amount_with_k,
							0
						) as payment_left
					from ost_priority o
					cross join calc_params cp
					cross join coeff_params cp1
					where o.priority = 1
					
					union all
					
					select
						o.priority,
						o.s_ts,
						o.amount_with_k,
						o.mnemonics,
						w.payment_left as payment_before,
						least(
							o.amount_with_k,
							greatest(w.payment_left, 0)
						) as written_off,
						greatest(
							o.amount_with_k
							-
							least(
								o.amount_with_k,
								greatest(w.payment_left, 0)
							),
							0
						) as amount_after,
						greatest(
							w.payment_left
							-
							o.amount_with_k,
							0
						) as payment_left
					from write_off w
					join ost_priority o on o.priority = w.priority + 1
					cross join calc_params cp
					cross join coeff_params cp1
				),
				write_off_json as (
					select
						coalesce(
							jsonb_agg(
								jsonb_build_object(
									's_ts', 			w.s_ts,
									'mnemonics', 		w.mnemonics,
									'amount_before', 	w.amount_with_k,
									'payment_before', 	w.payment_before,
									'written_off', 		w.written_off,
									'amount_after_kf_d', coalesce((
										select r.pension
										from actuary.round_calc_res(
											v_round_type, 
											w.amount_after * cp1.kf * cp.d,
											v_service_type
										) r
									), 0),
									'amount_after', 	w.amount_after,
									'payment_left',		w.payment_left
								)
								order by w.priority
							),
							'[]'::jsonb
						) as write_off_json
					from write_off w
					cross join coeff_params cp1
					cross join calc_params cp
				),
				calc_vykup as (
					select
						cp.d * (greatest(0,
							cp1.k1 * coalesce(cp.s_vznos, 0) +
							cp1.k2 * (coalesce(cp.s_dd, 0) + coalesce(cp.s_vosp, 0)) +
							cp1.k3 * coalesce(cp.s_mgd, 0) -
							cp1.k4 * coalesce(cp.s_vypl, 0) -
							cp1.k4 * coalesce(cp.s_perevod, 0)
						) * cp1.kf) as s_vykup
					from calc_params cp
					cross join coeff_params cp1
				),
				sr_npo_prepare as (
       				select 
       					greatest(0,
                    		cp.s_vznos + cp.s_dd + cp.s_mgd + cp.s_vosp
                    		- cp.s_vypl - cp.s_perevod
                    	)::numeric as raw_balance,
               			cp.s_vznos,
               			cp.s_dd,
               			cp.s_mgd,
               			cp.s_vosp,
               			cp.s_vypl,
               			cp.s_perevod
        			from calc_params cp
    			),
    			sr_npo as (
        			select 
	        			greatest(0,
	        				sr.raw_balance - coalesce(cv.s_vykup, 0)
	        			)::numeric as s_sr,
	               		sr.raw_balance,
	               		cv.s_vykup
        			from sr_npo_prepare sr 
        			cross join calc_vykup cv
    			)
				select
					coalesce((
						select r.pension
						from actuary.round_calc_res(v_round_type, cv.s_vykup, v_service_type) r
						)
					, 0)::numeric,
					coalesce((
						select r.pension
						from actuary.round_calc_res(v_round_type, cp.s_vznos, v_service_type) r
						)
					, 0)::numeric,
					coalesce((
						select r.pension
						from actuary.round_calc_res(v_round_type, cp.s_dd, v_service_type) r
						)
					, 0)::numeric,
					coalesce((
						select r.pension
						from actuary.round_calc_res(v_round_type, cp.s_mgd, v_service_type) r
						)
					, 0)::numeric,
					coalesce((
						select r.pension
						from actuary.round_calc_res(v_round_type, cp.s_vosp, v_service_type) r
						)
					, 0)::numeric,
					coalesce((
						select r.pension
						from actuary.round_calc_res(v_round_type, cp.s_vypl, v_service_type) r
						)
					, 0)::numeric,
					coalesce((
						select r.pension
						from actuary.round_calc_res(v_round_type, cp.s_perevod, v_service_type) r
						)
					, 0)::numeric,
					null::numeric as s_finrez,
					coalesce(cp1.k1, 0)::numeric,
					coalesce(cp1.k2, 0)::numeric,
					coalesce(cp1.k3, 0)::numeric,
					coalesce(cp1.k4, 0)::numeric,
					coalesce(cp1.kf, 0)::numeric,
					coalesce(cp.d, 0)::numeric,
					jsonb_build_object(
						'credit_included',
						coalesce(tcc.credit_included_json, '[]'::jsonb),
						'credit_not_included',
						coalesce(nitcj.credit_not_included_json, '[]'::jsonb),
						
						'debit_included',
						coalesce(tcd.debit_included_json, '[]'::jsonb),
						'debit_not_included',
						coalesce(nitdj.debit_not_included_json, '[]'::jsonb),
						'write_off',
						woj.write_off_json,
						's_sr',
						jsonb_build_object(
			                'amount', 
			                coalesce(sr.s_sr, 0),
			                'raw_balance', 
			                coalesce(sr.raw_balance, 0),
			                's_vykup_without_share',
			                coalesce(sr.s_vykup, 0),
			                'share_applied',
			                false
			            ),
						'exception',
						jsonb_build_object(
							'error', cp1.details_json
						)
					)::jsonb as details_json
				from calc_params cp
				cross join coeff_params cp1
				cross join calc_vykup cv
				cross join write_off_json woj
				cross join sr_npo sr
				left join trans_calc_credit tcc on true
				left join trans_calc_debit tcd on true
				left join not_included_trans_credit_json nitcj on true
				left join not_included_trans_debit_json nitdj on true;	
		
		end if;
